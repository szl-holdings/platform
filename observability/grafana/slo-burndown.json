        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "a11oy \u00b7 99.5% SLO error-budget burn",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - (sum(rate(szl_request_total{flagship=\"a11oy\",status!~\"5..\"}[1h])) / sum(rate(szl_request_total{flagship=\"a11oy\"}[1h])))) / (1 - 0.995)",
          "legendFormat": "burn rate (\u00d7budget)",
          "refId": "A",
          "format": "time_series",
          "range": true
        }
      ]
    },

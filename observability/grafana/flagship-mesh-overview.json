{
  "annotations": {
    "list": []
  },
  "editable": true,
  "schemaVersion": 39,
  "title": "Flagship Mesh \u2014 Overview",
  "uid": "szl-mesh-overview",
  "tags": [
    "szl",
    "doctrine-v11",
    "flagship-mesh"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "flagship",
        "type": "custom",
        "label": "Flagship",
        "query": "a11oy,amaru,sentra,rosie,killinchu,hatun-mcp",
        "current": {
          "text": "a11oy",
          "value": "a11oy"
        },
        "options": [
          {
            "text": "a11oy",
            "value": "a11oy"
          },
          {
            "text": "amaru",
            "value": "amaru"
          },
          {
            "text": "sentra",
            "value": "sentra"
          },
          {
            "text": "rosie",
            "value": "rosie"
          },
          {
            "text": "killinchu",
            "value": "killinchu"
          },
          {
            "text": "hatun-mcp",
            "value": "hatun-mcp"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "/healthz availability (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "avg by (organ) (probe_success{job=\"szl-flagships\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p99 /healthz latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le,organ) (rate(http_request_duration_seconds_bucket{endpoint=\"/healthz\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx rate by organ",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (organ) (rate(http_responses_total{code=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Doctrine number drift (0=ok)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (organ) (szl_doctrine_drift)",
          "refId": "A"
        }
      ]
    }
  ]
}
<?xml version="1.0" encoding="UTF-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>integrations@szlholdings.com</contactEmail>
    <label>SZL Platform Connector</label>
    <description>Connects your Salesforce org to the SZL Holdings intelligence platform. Enables bi-directional sync of opportunities, cases, leads, and accounts with real-time signal ingestion and pipeline health analytics.</description>
    <oauthConfig>
        <callbackUrl>https://api.szlholdings.com/api/integrations/salesforce/oauth/callback</callbackUrl>
        <consumerKey>__REPLACE_WITH_CONSUMER_KEY__</consumerKey>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
        <scopes>OfflineAccess</scopes>
        <isAdminApproved>true</isAdminApproved>
        <isConsumerSecretOptional>false</isConsumerSecretOptional>
        <requireSecretForRefreshToken>true</requireSecretForRefreshToken>
    </oauthConfig>
    <oauthPolicy>
        <ipRelaxation>ENFORCE</ipRelaxation>
        <refreshTokenPolicy>infinite</refreshTokenPolicy>
    </oauthPolicy>
    <permissionSetName>SZL_Platform_Connector_Access</permissionSetName>
</ConnectedApp>

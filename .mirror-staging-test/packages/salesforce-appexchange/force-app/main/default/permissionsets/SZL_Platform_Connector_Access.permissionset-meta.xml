<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants access to SZL Platform Connector custom metadata, Apex classes, and connected app. Assign to users or integration profiles that need to use the connector.</description>
    <label>SZL Platform Connector Access</label>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>SZLPlatformCallout</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SZLHourlySyncJob</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customMetadataTypeAccesses>
        <name>SZL_Config__mdt</name>
        <enabled>true</enabled>
    </customMetadataTypeAccesses>
    <connectedAppAccesses>
        <application>SZL_Platform_Connector</application>
        <enabled>true</enabled>
    </connectedAppAccesses>
</PermissionSet>

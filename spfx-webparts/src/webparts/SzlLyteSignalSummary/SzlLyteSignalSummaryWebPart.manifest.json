{
  "$schema": "https://developer.microsoft.com/json-schemas/core-build/package-solution/2017-02/package-solution.schema.json",
  "manifestVersion": 2,
  "componentType": "WebPart",
  "id": "szl-lyte-signal-summary",
  "alias": "SzlLyteSignalSummaryWebPart",
  "version": "*",
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsTab", "TeamsPersonalApp"],
  "supportsThemeVariants": true,
  "preconfiguredEntries": [
    {
      "groupId": "5c03119e-3074-46fd-976b-c60198311f70",
      "group": { "default": "SZL Platform" },
      "title": { "default": "Lyte Signal Summary" },
      "description": {
        "default": "Displays the Lyte Command Center signal summary — critical alerts, open incidents, and readiness score — embedded directly in your SharePoint site."
      },
      "officeFabricIconFontName": "AlertSolid",
      "properties": {
        "apiBaseUrl": "",
        "orgId": "",
        "refreshIntervalSeconds": 60,
        "showCriticalOnly": false,
        "maxSignals": 10,
        "theme": "dark"
      }
    }
  ]
}

GoogleService-Info.plist
# Google service-account keys
service-account*.json
google-play-service-account.json
*-service-account.json
*_service_account*.json
# Android signing keystores
*.keystore
*.jks
# iOS / macOS signing
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile
# EAS / Expo secrets
eas-cli-local-build-plugin-*
.eas/
# Generic secret / credential patterns
*secret*.json
*credentials*.json
*private_key*.json

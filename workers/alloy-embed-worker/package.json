{
  "name": "@workspace/alloy-embed-worker",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Alloy Embedding Fabric — TypeScript embed worker with micro-batching, explicit pooling strategies, truncation policy, warm-pool keep-alive, and pluggable EmbeddingBackend interface.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --customConditions workspace",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@workspace/alloy-rank-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Alloy Embedding Fabric development reranking worker. Lexical-overlap and score-passthrough are non-production heuristics; production readiness stays on HOLD until a qualified immutable model is wired.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "express": "^5.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

{
  "expo": {
    "name": "Terra",
    "slug": "terra-mobile",
    "version": "1.0.0",
    "description": "Terra is a field intelligence platform for real estate professionals. Track distress properties, manage your acquisition pipeline, photograph sites on-location, and receive live deal and listing alerts.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "terra",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0b08"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.terra.realestate.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Terra uses your camera to photograph properties on-site.",
        "NSLocationWhenInUseUsageDescription": "Terra uses your location to show nearby properties and auto-tag photos.",
        "NSLocationAlwaysUsageDescription": "Terra uses your location to show nearby properties.",
        "NSUserNotificationUsageDescription": "Terra sends alerts for new distress properties, watchlist changes, deal updates, and pipeline activity.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.terra.realestate.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0d0b08"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Terra uses your camera to photograph properties on-site."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Terra uses your location to show nearby properties."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#b8943c",
          "sounds": [],
          "androidChannels": [
            {
              "name": "terra-deals",
              "importance": 4,
              "vibrationPattern": [0, 250, 250, 250],
              "lightColor": "#FFB8943C",
              "sound": "default",
              "description": "Deal status updates and pipeline activity"
            },
            {
              "name": "terra-listings",
              "importance": 3,
              "vibrationPattern": [0, 100],
              "lightColor": "#FFB8943C",
              "description": "Property listing changes and price updates"
            },
            {
              "name": "terra-distress",
              "importance": 5,
              "vibrationPattern": [0, 250, 250, 250, 250, 250],
              "lightColor": "#FFB8943C",
              "sound": "default",
              "bypassDnd": true,
              "description": "Distress signal alerts for watchlisted properties"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "terra-mobile"
      },
      "supportUrl": "https://terra.ai/support",
      "privacyUrl": "https://terra.ai/privacy",
      "termsUrl": "https://terra.ai/terms"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/terra-mobile"
    }
  }
}

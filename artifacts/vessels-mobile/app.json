{
  "expo": {
    "name": "Vessels",
    "slug": "vessels-mobile",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vessels",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020d18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vessels.maritime.mobile",
      "buildNumber": "1",
      "associatedDomains": ["applinks:vessels.ai", "applinks:app.vessels.ai"],
      "infoPlist": {
        "NSFaceIDUsageDescription": "Vessels uses Face ID for secure fleet commander authentication.",
        "NSLocationWhenInUseUsageDescription": "Vessels uses your location to show nearby fleet activity.",
        "NSCameraUsageDescription": "Vessels uses your camera to scan vessel QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.vessels.maritime.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#020d18"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "vessels.ai" }, { "scheme": "https", "host": "app.vessels.ai" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Vessels to use Face ID for secure fleet commander access."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0ea5e9",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "vessels-mobile"
      },
      "description": "Vessels — Maritime Fleet Intelligence. Real-time AIS tracking, sanctions screening (OFAC/EU), dark vessel detection, geopolitical risk monitoring, and weather routing for maritime operations commanders.",
      "keywords": "maritime, fleet tracking, AIS, vessel, sanctions, OFAC, shipping, dark vessel, geopolitical risk, fleet management",
      "category": "Business",
      "supportUrl": "https://vessels.ai/support",
      "privacyUrl": "https://vessels.ai/privacy",
      "termsUrl": "https://vessels.ai/terms"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/vessels-mobile"
    }
  }
}

{
  "expo": {
    "name": "Vessels",
    "slug": "vessels-mobile",
    "version": "1.0.0",
    "description": "Vessels is the maritime fleet command platform for owners and operations teams. Track vessel positions, monitor compliance, receive port arrival notifications, and manage your full fleet — from anywhere at sea or shore.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vessels",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020d18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vessels.maritime.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vessels uses your location to show nearby fleet activity.",
        "NSCameraUsageDescription": "Vessels uses your camera to scan vessel QR codes.",
        "NSUserNotificationUsageDescription": "Vessels sends vessel alerts, compliance warnings, and port arrival notifications to keep your fleet operations on track.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.vessels.maritime.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#020d18"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0ea5e9",
          "sounds": [],
          "androidChannels": [
            {
              "name": "vessels-alerts",
              "importance": 5,
              "vibrationPattern": [0, 250, 250, 250],
              "lightColor": "#FF0EA5E9",
              "sound": "default",
              "bypassDnd": true,
              "description": "Critical vessel alerts requiring immediate attention"
            },
            {
              "name": "vessels-compliance",
              "importance": 4,
              "vibrationPattern": [0, 250, 250, 250],
              "lightColor": "#FF0EA5E9",
              "sound": "default",
              "description": "Compliance warnings and documentation issues"
            },
            {
              "name": "vessels-updates",
              "importance": 3,
              "vibrationPattern": [0, 100],
              "lightColor": "#FF0EA5E9",
              "description": "Port arrivals and general vessel status updates"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "vessels-mobile"
      },
      "supportUrl": "https://vessels.ai/support",
      "privacyUrl": "https://vessels.ai/privacy",
      "termsUrl": "https://vessels.ai/terms"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/vessels-mobile",
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}

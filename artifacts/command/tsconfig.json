{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./src/*"],
      "@/pages/*": ["./src/pages/*", "./src/operations/pages/*", "./src/infrastructure/pages/*"],
      "@/components/*": [
        "./src/components/*",
        "./src/operations/components/*",
        "./src/infrastructure/components/*"
      ],
      "@/lib/*": ["./src/lib/*", "./src/operations/lib/*", "./src/infrastructure/lib/*"],
      "@lyte/*": ["./src/operations/*"],
      "@imp/*": ["./src/infrastructure/*"]
    }
  }
}

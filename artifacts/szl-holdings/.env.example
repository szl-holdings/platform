# SZL Holdings — Environment Variables
# Copy to .env.local and fill in values for your environment.
# NEVER commit .env.local to version control.

# ── PostHog Analytics ──────────────────────────────────────────────
# Required to enable product analytics (page views, funnels, user behavior).
# Obtain from: https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=phc_YOUR_PROJECT_API_KEY

# PostHog ingestion host. Defaults to https://us.i.posthog.com if unset.
# Set to https://eu.i.posthog.com for EU data residency.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Plausible Web Analytics ────────────────────────────────────────
# Domain registered in Plausible dashboard. Defaults to szlholdings.com.
VITE_PLAUSIBLE_DOMAIN=szlholdings.com

# ── API / Backend ──────────────────────────────────────────────────
# Base URL for the API server (used by api-client-react and graphql-client).
VITE_API_URL=https://szlholdings.com/api

# ── Auth ───────────────────────────────────────────────────────────
# Replit Auth client ID (set automatically in Replit; override for custom domains).
VITE_REPLIT_AUTH_CLIENT_ID=

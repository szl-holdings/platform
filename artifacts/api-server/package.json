    "smoke:domaine-diligence-lifecycle": "tsx src/scripts/smoke-terra-diligence-lifecycle.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "lint:ai-calls": "bash src/scripts/lint-ai-direct-calls.sh",
    "format": "biome format --write ./src"

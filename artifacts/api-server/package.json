    "@szl-holdings/observability": "workspace:*",
    "@szl-holdings/services": "workspace:*",
    "@szl-holdings/workflow-engine": "workspace:*",
    "archiver": "^7.0.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "expo-server-sdk": "^6.1.0",
    "express": "^5",
    "express-rate-limit": "^8.3.1",
    "graphql": "^16.13.2",
    "graphql-depth-limit": "^1.1.0",

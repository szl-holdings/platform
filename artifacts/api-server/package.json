{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./build.mjs && node --max-old-space-size=1536 --expose-gc --optimize-for-size --enable-source-maps ./dist/index.mjs",
    "dev:nobuild": "node --max-old-space-size=1536 --expose-gc --optimize-for-size --enable-source-maps ./dist/index.mjs",
    "dev:fast": "bash ./start.sh",
    "build": "node ./build.mjs",
    "build:nexus": "cd ../mockup-sandbox && NODE_ENV=production node_modules/.bin/vite build",
    "rebuild:nexus": "FORCE_NEXUS_BUILD=1 bash ./start.sh",
    "start": "node --max-old-space-size=2048 --expose-gc --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "seed:terra": "tsx src/scripts/seed-terra-distress.ts",
    "seed:ecosystem": "tsx src/scripts/seed-ecosystem.ts",
    "seed:alloy-runtime-agents": "tsx src/scripts/seed-alloy-runtime-agents.ts",
    "seed:uptime-history": "tsx src/scripts/seed-uptime-history.ts",
    "smoke:cognitive-runtime": "tsx src/scripts/smoke-cognitive-runtime.ts",

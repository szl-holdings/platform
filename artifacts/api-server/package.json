    "audit:route-security": "tsx src/scripts/route-security-matrix.ts",
    "audit:route-security:strict": "tsx src/scripts/route-security-matrix.ts --strict",
    "audit:route-security:strict-auth": "tsx src/scripts/route-security-matrix.ts --strict-auth",
    "audit:openapi-routes": "tsx src/scripts/validate-openapi-routes.ts",
    "audit:openapi-routes:strict": "tsx src/scripts/validate-openapi-routes.ts --strict-spec-only",

{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./build.mjs && node --max-old-space-size=1536 --expose-gc --optimize-for-size --enable-source-maps ./dist/index.mjs",
    "dev:nobuild": "node --max-old-space-size=1536 --expose-gc --optimize-for-size --enable-source-maps ./dist/index.mjs",
    "dev:fast": "node --input-type=commonjs -e \"const{existsSync}=require('fs');if(!existsSync('./dist/index.mjs')){require('child_process').execSync('node ./build.mjs',{stdio:'inherit'})}\" && node --max-old-space-size=1536 --expose-gc --optimize-for-size --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "db:push": "cd ../../lib/db && npx drizzle-kit push --force --config ./drizzle.push.config.ts < /dev/null",
    "start": "node --max-old-space-size=1024 --expose-gc --optimize-for-size --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:terra": "tsx src/scripts/seed-terra-distress.ts",
    "seed:ecosystem": "tsx src/scripts/seed-ecosystem.ts",
    "seed:platform-flags": "tsx src/scripts/seed-platform-flags.ts",
    "db:migrate": "cd ../../lib/db && npx drizzle-kit migrate --config ./drizzle.push.config.ts"
  },
  "dependencies": {
    "@clerk/express": "^1.3.4",
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.1.2",
    "@clerk/express": "^5.0.0",
    "http-proxy-middleware": "^3.0.0",
    "@graphql-tools/schema": "^10.0.31",
    "@react-pdf/renderer": "^4.3.2",
    "@swc/helpers": "^0.5.20",
    "@types/archiver": "^7.0.0",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@szl-holdings/ai-engine": "workspace:*",
    "@szl-holdings/api-zod": "workspace:*",
    "@szl-holdings/approvals": "workspace:*",
    "@szl-holdings/audit": "workspace:*",
    "@szl-holdings/auth": "workspace:*",
    "@szl-holdings/proof-chain": "workspace:*",
    "@szl-holdings/receipt-graph": "workspace:*",
    "@szl-holdings/pulse-evals": "workspace:*",
    "@szl-holdings/worldline": "workspace:*",
    "@szl-holdings/config": "workspace:*",
    "@szl-holdings/db": "workspace:*",
    "@szl-holdings/integrations-anthropic-ai": "workspace:*",

{
  "namespace": "com.szlholdings.nexus",
  "displayName": "Nexus — PRAXIS Orchestration Layer",
  "version": "5.0.0",
  "schemaVersion": "mcp/1.0",
  "description": "Top-level PRAXIS orchestration server. Manages the agentic mesh, trust score computation, marketplace registry and governed autonomy policies across all SZL Holdings domains.",
  "publisher": {
    "name": "SZL Holdings",
    "url": "https://szlholdings.com",
    "contact": "mcp-trust@szlholdings.com"
  },
  "trust": {
    "tier": "Verified",
    "score": 99,
    "auditedAt": "2026-04-01T00:00:00Z",
    "nextAuditDue": "2026-10-01T00:00:00Z",
    "manifestDigest": "sha256:b5c9d3e7f1a5b9c3d7e1f5a9b3c7d1e5f9a3b7c1d5e9f3a7b1c5d9e3f7a1b5c9"
  },
  "capabilities": [
    {
      "name": "trust_score_compute",
      "description": "Compute or refresh Trust Scores for any registered MCP server",
      "inputSchema": { "type": "object", "properties": { "namespace": { "type": "string" }, "forceRefresh": { "type": "boolean" } } },
      "riskLevel": "medium",
      "dataClassification": "internal"
    },
    {
      "name": "marketplace_registry",
      "description": "Register, update or delist MCP servers from the public trust marketplace",
      "inputSchema": { "type": "object", "properties": { "action": { "type": "string", "enum": ["register", "update", "delist", "query"] }, "namespace": { "type": "string" }, "manifest": { "type": "object" } } },
      "riskLevel": "high",
      "dataClassification": "internal",
      "humanApprovalRequired": true
    },
    {
      "name": "governed_autonomy_policy",
      "description": "Define and enforce governed autonomy policies including human-in-loop thresholds",
      "inputSchema": { "type": "object", "properties": { "policyId": { "type": "string" }, "action": { "type": "string", "enum": ["create", "update", "enforce", "audit"] }, "definition": { "type": "object" } } },
      "riskLevel": "high",
      "dataClassification": "restricted",
      "humanApprovalRequired": true
    },
    {
      "name": "mesh_topology",
      "description": "Query live agentic mesh topology, connection health and latency map",
      "inputSchema": { "type": "object", "properties": { "scope": { "type": "string", "enum": ["all", "verified", "degraded"] } } },
      "riskLevel": "low",
      "dataClassification": "internal"
    },
    {
      "name": "drift_detection",
      "description": "Detect schema drift, behavioral drift and trust score degradation across registered servers",
      "inputSchema": { "type": "object", "properties": { "namespace": { "type": "string" }, "driftType": { "type": "string", "enum": ["schema", "behavioral", "trust"] } } },
      "riskLevel": "medium",
      "dataClassification": "internal"
    }
  ],
  "governance": {
    "humanInLoop": true,
    "humanInLoopActions": ["marketplace_registry", "governed_autonomy_policy"],
    "maxToolCallsPerSession": 20,
    "rateLimitPerMinute": 10,
    "allowedCallerTiers": ["Verified"],
    "driftPolicy": "halt-on-schema-change"
  },
  "endpoints": {
    "mcp": "https://mcp.szlholdings.com/nexus/v1",
    "health": "https://mcp.szlholdings.com/nexus/health",
    "metrics": "https://mcp.szlholdings.com/nexus/metrics"
  }
}

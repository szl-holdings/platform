{
  "namespace": "com.szlholdings.command",
  "displayName": "Unified Command",
  "version": "4.2.0",
  "schemaVersion": "mcp/1.0",
  "description": "Cross-domain orchestration layer providing unified control plane for all SZL Holdings MCP servers with governed workflow execution.",
  "publisher": {
    "name": "SZL Holdings",
    "url": "https://szlholdings.com",
    "contact": "mcp-trust@szlholdings.com"
  },
  "trust": {
    "tier": "Verified",
    "score": 99,
    "auditedAt": "2026-03-01T00:00:00Z",
    "nextAuditDue": "2026-09-01T00:00:00Z",
    "manifestDigest": "sha256:a4b8c2d6e0f4a8b2c6d0e4f8a2b6c0d4e8f2a6b0c4d8e2f6a0b4c8d2e6f0a4b8"
  },
  "capabilities": [
    {
      "name": "multi_server_orchestration",
      "description": "Coordinate tool calls across multiple SZL MCP servers in a governed workflow",
      "inputSchema": { "type": "object", "properties": { "workflow": { "type": "string" }, "servers": { "type": "array" }, "inputs": { "type": "object" } } },
      "riskLevel": "high",
      "dataClassification": "restricted",
      "humanApprovalRequired": true
    },
    {
      "name": "session_management",
      "description": "Create, manage and audit MCP sessions across the SZL server fleet",
      "inputSchema": { "type": "object", "properties": { "action": { "type": "string", "enum": ["create", "list", "terminate", "audit"] }, "sessionId": { "type": "string" } } },
      "riskLevel": "high",
      "dataClassification": "restricted",
      "humanApprovalRequired": true
    },
    {
      "name": "policy_enforcement",
      "description": "Apply and verify governance policies across active MCP sessions",
      "inputSchema": { "type": "object", "properties": { "policy": { "type": "string" }, "target": { "type": "string" }, "scope": { "type": "string" } } },
      "riskLevel": "high",
      "dataClassification": "restricted"
    },
    {
      "name": "audit_log_query",
      "description": "Query immutable audit logs for tool calls, approvals and drift events",
      "inputSchema": { "type": "object", "properties": { "timeRange": { "type": "object" }, "serverId": { "type": "string" }, "eventTypes": { "type": "array" } } },
      "riskLevel": "low",
      "dataClassification": "confidential"
    }
  ],
  "governance": {
    "humanInLoop": true,
    "humanInLoopActions": ["multi_server_orchestration", "session_management"],
    "maxToolCallsPerSession": 25,
    "rateLimitPerMinute": 10,
    "allowedCallerTiers": ["Verified"],
    "driftPolicy": "halt-on-schema-change"
  },
  "endpoints": {
    "mcp": "https://mcp.szlholdings.com/command/v1",
    "health": "https://mcp.szlholdings.com/command/health",
    "metrics": "https://mcp.szlholdings.com/command/metrics"
  }
}

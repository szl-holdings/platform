# Pulse — AI Executive Briefing — Environment Variables
# Copy to .env.local and fill in values for your environment.
# NEVER commit .env.local to version control.

# ── Demo Mode ──────────────────────────────────────────────────────
# Set to "true" to allow unauthenticated demo access (dev/staging only).
# Must be "false" in production.
VITE_DEMO_ALLOWED=false

# ── Billing ────────────────────────────────────────────────────────
# Stripe price ID for the Pulse Executive subscription.
# Obtain from: https://dashboard.stripe.com/products
VITE_STRIPE_PRICE_PULSE_EXECUTIVE=price_your-pulse-executive-price-id

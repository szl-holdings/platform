{
  "name": "@workspace/szl-demo-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "render": "node scripts/render-video.mjs",
    "render:ci": "node scripts/render-video.mjs --install-browsers"
  },
  "devDependencies": {
    "@szl-holdings/security-headers": "workspace:*",
    "@react-spring/web": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@szl-holdings/shared-proxy": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "clsx": "catalog:",
    "framer-motion": "catalog:",
    "gsap": "^3.14.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "catalog:",
    "playwright-core": "^1.58.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "three": "^0.182.0",
    "vite": "catalog:"
  },
  "dependencies": {
    "@workspace/tokens": "workspace:*"
  }
}

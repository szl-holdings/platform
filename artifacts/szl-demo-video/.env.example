# SZL Holdings Demo Video — Environment Variables
# Copy to .env.local and fill in values for your environment.
# NEVER commit .env.local to version control.

# ── Dev Server ──────────────────────────────────────────────────────
# TCP port the Vite dev server listens on (set automatically by the platform).
PORT=3000

# ── Routing ─────────────────────────────────────────────────────────
# URL path prefix for this artifact (must match artifact.toml previewPath).
# Hard-fails at startup if missing — do not leave unset.
BASE_PATH=/szl-demo-video/

{
  "name": "@workspace/lyte-command-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@szl-holdings/security-headers": "workspace:*",
    "@szl-holdings/shared-proxy": "workspace:*",
    "@szl-holdings/shared-ui": "workspace:*",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/aef-contracts": "workspace:*",
    "@workspace/aef-sdk": "workspace:*",
    "framer-motion": "catalog:",
    "happy-dom": "^20.8.9",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wouter": "^3.3.5"
  },
  "dependencies": {
    "@szl/alloy": "workspace:*",
    "@szl-holdings/brand-registry": "workspace:*",
    "@szl-holdings/design-system": "workspace:*",
    "@szl-holdings/observability": "workspace:*",
    "@workspace/simulation": "workspace:*",
    "@workspace/approvals-inbox": "workspace:*",
    "@szl-holdings/speech-specialist": "workspace:*",
    "@szl-holdings/omnia-shell": "workspace:*",
    "@workspace/tokens": "workspace:*"
  }

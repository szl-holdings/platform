{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "device-development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "testflight": {
      "channel": "preview",
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$EXPO_APPLE_ID",
        "ascAppId": "$EXPO_ASC_APP_ID",
        "appleTeamId": "$EXPO_APPLE_TEAM_ID",
        "ascApiKeyId": "$EXPO_ASC_API_KEY_ID",
        "ascApiKeyIssuerId": "$EXPO_ASC_API_KEY_ISSUER_ID",
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "language": "en-US",
        "sku": "com.szlholdings.executive.mobile"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "testflight": {
      "ios": {
        "appleId": "$EXPO_APPLE_ID",
        "ascAppId": "$EXPO_ASC_APP_ID",
        "appleTeamId": "$EXPO_APPLE_TEAM_ID",
        "ascApiKeyId": "$EXPO_ASC_API_KEY_ID",
        "ascApiKeyIssuerId": "$EXPO_ASC_API_KEY_ISSUER_ID",
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "language": "en-US",
        "sku": "com.szlholdings.executive.mobile"
      }
    }
  }
}

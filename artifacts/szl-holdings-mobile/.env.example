# CORTEX Mobile — Environment Variables
# Copy to .env and fill in values for your environment.
# NEVER commit a filled-in .env file to version control.

# ── API / Backend ───────────────────────────────────────────────────
# Base URL of the API server (no trailing slash).
EXPO_PUBLIC_API_URL=https://szlholdings.com/api

# Public domain used by the Expo dev proxy (set automatically by Replit).
EXPO_PUBLIC_DOMAIN=

# Replit REPL ID (set automatically by Replit).
EXPO_PUBLIC_REPL_ID=

# ── Auth ────────────────────────────────────────────────────────────
# OpenID Connect issuer URL.
EXPO_PUBLIC_ISSUER_URL=https://replit.com/oidc

# OAuth client ID for the mobile app.
EXPO_PUBLIC_OAUTH_CLIENT_ID=

# ── Push Notifications ──────────────────────────────────────────────
# Expo project ID for push notification delivery (from app.config.js).
EXPO_PUBLIC_PROJECT_ID=

# ── Analytics ───────────────────────────────────────────────────────
# PostHog API key for mobile analytics.
EXPO_PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_API_KEY

# ── Build (set by EAS — do not set manually) ────────────────────────
APP_VARIANT=development

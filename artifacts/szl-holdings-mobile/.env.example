# CORTEX Mobile — Environment Variables
# Copy to .env and fill in values for your environment.
# NEVER commit a filled-in .env file to version control.

# ── API / Backend ───────────────────────────────────────────────────
# Base URL of the API server (no trailing slash).
EXPO_PUBLIC_API_URL=https://szlholdings.com/api

# Public domain used by the Expo dev proxy (set automatically by Replit).
EXPO_PUBLIC_DOMAIN=

# Replit REPL ID (set automatically by Replit).
EXPO_PUBLIC_REPL_ID=

# ── Auth ────────────────────────────────────────────────────────────
# OpenID Connect issuer URL.
EXPO_PUBLIC_ISSUER_URL=https://replit.com/oidc

# OAuth client ID for the mobile app.
EXPO_PUBLIC_OAUTH_CLIENT_ID=

# ── Push Notifications ──────────────────────────────────────────────
# Expo project ID for push notification delivery (from app.config.js).
EXPO_PUBLIC_PROJECT_ID=

# ── Analytics ───────────────────────────────────────────────────────
# PostHog API key for mobile analytics.
EXPO_PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_API_KEY

# ── Server (local dev only) ─────────────────────────────────────────
# Port for the local health proxy server. Set automatically by Replit.
PORT=3000

# Port used by the Expo dev server proxy. Set automatically by Replit.
EXPO_PORT=19000

# ── App Mode ────────────────────────────────────────────────────────
# Controls app behaviour: product | demo | sandbox
EXPO_PUBLIC_APP_MODE=product

# Deployment environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Set to "true" to enable unauthenticated demo access (dev/staging only).
EXPO_PUBLIC_DEMO_MODE=false

# ── Extended API ────────────────────────────────────────────────────
# Primary API base URL for backend requests (no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://szlholdings.com/api

# Sandbox API base URL (used when EXPO_PUBLIC_APP_MODE=sandbox).
EXPO_PUBLIC_SANDBOX_API_BASE=https://szlholdings.com/api

# ── Analytics ───────────────────────────────────────────────────────
# PostHog ingestion host. Defaults to https://us.i.posthog.com if unset.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Amplitude API key for mobile event tracking.
# Obtain from: https://app.amplitude.com/analytics
EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key

# ── Error Tracking ──────────────────────────────────────────────────
# Sentry DSN for mobile crash reporting.
# Obtain from: https://sentry.io
EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ── Navigation ──────────────────────────────────────────────────────
# Full URL of the Pulse Executive Briefing web app (opened in WebView).
EXPO_PUBLIC_PULSE_URL=https://szlholdings.com/pulse

# ── Billing ─────────────────────────────────────────────────────────
# Stripe price ID for the mobile subscription tier.
# Obtain from: https://dashboard.stripe.com/products
EXPO_PUBLIC_STRIPE_PRICE_MOBILE=price_your-mobile-price-id

# ── Native Build (EAS-injected — do not set manually) ───────────────
# Path to google-services.json for Android Firebase push notifications.
# Provided by EAS Build; set locally only if running a native Android build.
GOOGLE_SERVICES_JSON=

# Path to GoogleService-Info.plist for iOS Firebase push notifications.
# Provided by EAS Build; set locally only if running a native iOS build.
GOOGLE_SERVICE_INFO_PLIST=

# ── Build (set by EAS — do not set manually) ────────────────────────
APP_VARIANT=development

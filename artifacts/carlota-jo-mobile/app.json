{
  "expo": {
    "name": "Carlota Jo",
    "slug": "carlota-jo-mobile",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carlotajo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0c09"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.carlotajo.advisory.mobile",
      "buildNumber": "1",
      "associatedDomains": ["applinks:carlotajo.com", "applinks:app.carlotajo.com"],
      "infoPlist": {
        "NSFaceIDUsageDescription": "Carlota Jo uses Face ID for secure client portal access.",
        "NSCameraUsageDescription": "Carlota Jo uses your camera for document scanning.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.carlotajo.advisory.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0e0c09"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "carlotajo.com" }, { "scheme": "https", "host": "app.carlotajo.com" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Carlota Jo to use Face ID for secure client portal access."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#c9a84c",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "carlota-jo-mobile"
      },
      "description": "Carlota Jo — Private Client Advisory Portal. Secure client portal for personalized consulting engagements, session history, document management, and direct communication with your advisory team.",
      "keywords": "consulting, advisory, client portal, luxury advisory, private client, executive coaching, business consulting, strategic advisory",
      "category": "Business",
      "supportUrl": "https://carlotajo.com/support",
      "privacyUrl": "https://carlotajo.com/privacy",
      "termsUrl": "https://carlotajo.com/terms"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/carlota-jo-mobile"
    }
  }
}

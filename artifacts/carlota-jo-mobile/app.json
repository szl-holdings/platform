{
  "expo": {
    "name": "Carlota Jo",
    "slug": "carlota-jo-mobile",
    "version": "1.0.0",
    "description": "Carlota Jo is a private client portal for Carlota Jo Consulting. Access personalized advisory sessions, review shared documents, and communicate securely with your advisor — all in one place.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carlotajo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0c09"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.carlotajo.advisory.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Carlota Jo uses your camera for document scanning.",
        "NSUserNotificationUsageDescription": "Carlota Jo sends session reminders, document notifications, and secure messages from your advisor.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.carlotajo.advisory.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0e0c09"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#c9a84c",
          "sounds": [],
          "androidChannels": [
            {
              "name": "carlota-sessions",
              "importance": 4,
              "vibrationPattern": [0, 250, 250, 250],
              "lightColor": "#FFC9A84C",
              "sound": "default",
              "description": "Session reminders and scheduling notifications"
            },
            {
              "name": "carlota-documents",
              "importance": 3,
              "vibrationPattern": [0, 250],
              "lightColor": "#FFC9A84C",
              "sound": "default",
              "description": "New documents shared to your Vault"
            },
            {
              "name": "carlota-messages",
              "importance": 4,
              "vibrationPattern": [0, 250, 250, 250],
              "lightColor": "#FFC9A84C",
              "sound": "default",
              "description": "Secure messages from your advisor"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "carlota-jo-mobile"
      },
      "supportUrl": "https://carlotajo.com/support",
      "privacyUrl": "https://carlotajo.com/privacy",
      "termsUrl": "https://carlotajo.com/terms"
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/carlota-jo-mobile"
    }
  }
}

{
  "expo": {
    "name": "Aegis",
    "slug": "aegis-mobile",
    "version": "1.0.0",
    "description": "Aegis is the unified SOC command platform for security operations teams. Monitor threats in real time, manage incidents, coordinate response, and maintain full situational awareness — all from your mobile device.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aegis",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aegis.soc.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Aegis uses Face ID for secure SOC operator authentication.",
        "NSCameraUsageDescription": "Aegis uses your camera to scan QR codes for device enrollment.",
        "NSUserNotificationUsageDescription": "Aegis sends critical threat alerts, incident updates, and system health notifications to keep your SOC team informed.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080B12"
      },
      "package": "com.aegis.soc.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080B12",
          "imageWidth": 200
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Aegis to use Face ID for secure biometric authentication."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6366f1",
          "sounds": [],
          "androidChannels": [
            {
              "name": "aegis-critical",
              "importance": 5,
              "vibrationPattern": [0, 250, 250, 250],
              "lightColor": "#FF6366F1",
              "sound": "default",
              "bypassDnd": true,
              "description": "Critical threat alerts requiring immediate attention"
            },
            {
              "name": "aegis-incidents",
              "importance": 4,
              "vibrationPattern": [0, 250],
              "lightColor": "#FF6366F1",
              "sound": "default",
              "description": "Incident status updates and assignments"
            },
            {
              "name": "aegis-health",
              "importance": 3,
              "vibrationPattern": [0, 100],
              "lightColor": "#FF6366F1",
              "description": "System health and monitoring alerts"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B12"
    },
    "extra": {
      "eas": {
        "projectId": "aegis-mobile"
      },
      "supportUrl": "https://aegis.ai/support",
      "privacyUrl": "https://aegis.ai/privacy",
      "termsUrl": "https://aegis.ai/terms"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/aegis-mobile",
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}

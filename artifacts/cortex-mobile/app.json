{
  "expo": {
    "name": "CORTEX",
    "slug": "cortex-mobile",
    "version": "1.0.0",
    "description": "CORTEX is the unified command super app for the SZL Holdings ecosystem. Seven vertical workspaces — Defense, Fleet, Properties, Operations, Advisory, Portfolio, Founder — unified in one app.",
    "runtimeVersion": { "policy": "appVersion" },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cortex",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.szlholdings.cortex",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "CORTEX uses Face ID for secure biometric authentication across all workspaces.",
        "NSCameraUsageDescription": "CORTEX uses your camera for property scanning, QR code enrollment, and document capture.",
        "NSUserNotificationUsageDescription": "CORTEX delivers priority alerts from all workspaces — security threats, fleet events, deal updates, and more.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/images/icon.png", "backgroundColor": "#080B12" },
      "package": "com.szlholdings.cortex",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": { "bundler": "metro", "favicon": "./assets/images/icon.png" },
    "plugins": [
      ["expo-router", { "origin": "https://replit.com/" }],
      "expo-font",
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#080B12", "imageWidth": 200 }],
      ["expo-local-authentication", { "faceIDPermission": "Allow CORTEX to use Face ID for secure authentication." }],
      ["expo-notifications", {
        "icon": "./assets/images/icon.png",
        "color": "#c9a84c",
        "sounds": [],
        "androidChannels": [
          { "name": "cortex-critical", "importance": 5, "vibrationPattern": [0, 250, 250, 250], "lightColor": "#FFC9A84C", "sound": "default", "bypassDnd": true, "description": "Critical alerts requiring immediate attention" },
          { "name": "cortex-alerts", "importance": 4, "vibrationPattern": [0, 250], "lightColor": "#FFC9A84C", "sound": "default", "description": "Domain alerts and updates" },
          { "name": "cortex-info", "importance": 3, "vibrationPattern": [0, 100], "lightColor": "#FFC9A84C", "description": "Informational updates" }
        ]
      }]
    ],
    "experiments": { "typedRoutes": true },
    "splash": { "image": "./assets/images/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#080B12" },
    "extra": {
      "eas": { "projectId": "cortex-mobile" },
      "supportUrl": "https://szlholdings.com/support",
      "privacyUrl": "https://szlholdings.com/privacy",
      "termsUrl": "https://szlholdings.com/terms"
    }
  }
}

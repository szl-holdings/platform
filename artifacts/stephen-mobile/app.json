{
  "expo": {
    "name": "Stephen Lutar",
    "slug": "stephen-mobile",
    "version": "1.0.0",
    "description": "A personal command center for Stephen Lutar. Stay connected with portfolio updates, schedule management, and real-time insights across all ventures — curated for the founder's workflow.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stephen",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stephenlutar.founder.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Stephen uses Face ID for secure access to your personal command center.",
        "NSUserNotificationUsageDescription": "Stephen sends updates and reminders relevant to your portfolio and schedule.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.stephenlutar.founder.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6366f1",
          "sounds": [],
          "androidChannels": [
            {
              "name": "stephen-updates",
              "importance": 4,
              "vibrationPattern": [0, 250],
              "lightColor": "#FF6366F1",
              "sound": "default",
              "description": "Portfolio updates and cross-ecosystem intelligence"
            },
            {
              "name": "stephen-schedule",
              "importance": 3,
              "vibrationPattern": [0, 100],
              "lightColor": "#FF6366F1",
              "description": "Schedule reminders and task notifications"
            }
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Stephen to use Face ID for secure access."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "stephen-mobile"
      },
      "supportUrl": "https://stephenlutar.com/contact",
      "privacyUrl": "https://stephenlutar.com/privacy",
      "termsUrl": "https://stephenlutar.com/terms"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/stephen-mobile",
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}

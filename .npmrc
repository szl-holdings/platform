auto-install-peers=false
strict-peer-dependencies=false

# GitHub Packages — @szl-holdings scope
# Note: NODE_AUTH_TOKEN is required to publish to or install private packages
# from npm.pkg.github.com. In local/CI environments without this token set,
# the auth line below is omitted — all @szl-holdings packages are resolved
# via workspace:* references in the monorepo and do not require registry auth.
@szl-holdings:registry=https://npm.pkg.github.com

# === Resolution & install =====================================================
auto-install-peers=false
strict-peer-dependencies=false
engine-strict=true
public-hoist-pattern[]=zod

# === Series-A supply-chain hardening =========================================
# Block lifecycle scripts (preinstall/install/postinstall/prepare) by default.
# Whitelist via `pnpm approve-builds` (recorded in package.json#pnpm.onlyBuiltDependencies).
enable-pre-post-scripts=false

# Verify every cached package against its lockfile integrity hash on resolve.
verify-store-integrity=true

# Refuse to install if pnpm-lock.yaml would be modified by `install` in CI.
frozen-lockfile=true

# Prevent proxy/registry mismatch between lockfile and runtime.
resolution-mode=highest

# Don't follow symlinks out of the workspace store — defends against
# malicious tarballs that ship symlinks pointing at /etc, /root, etc.
symlink=false

# === Resolution & install =====================================================
auto-install-peers=false
strict-peer-dependencies=false
engine-strict=true
public-hoist-pattern[]=zod

# === Series-A supply-chain hardening =========================================
# Verify every cached package against its lockfile integrity hash on resolve.
verify-store-integrity=true

# Lifecycle-script gating: pnpm 9+ already requires explicit allowlisting of
# postinstall scripts via package.json#pnpm.onlyBuiltDependencies. We rely on
# that mechanism rather than enable-pre-post-scripts=false, which breaks
# legitimate platform-binary postinstalls (esbuild, etc.) until every needed
# package is enumerated.

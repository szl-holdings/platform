modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/lyte-command-center: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/counsel: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lyte-metrics-store: service"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lyte-metrics-store-test"

[[workflows.workflow]]
name = "artifacts/lyte-command-center: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/lyte-command-center && exec node_modules/.bin/vite --config vite.config.ts --host 0.0.0.0'"
waitForPort = 9090

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/counsel: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/counsel && exec node_modules/.bin/vite --config vite.config.ts --host ::'"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "api-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter ./artifacts/api-server test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lyte-metrics-store: service"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/services/lyte-metrics-store && PYTHONPATH=src PORT=8099 exec python -m lyte_metrics_store.main'"
waitForPort = 8099

[[workflows.workflow]]
name = "lyte-metrics-store-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/services/lyte-metrics-store && PYTHONPATH=src python -m pytest -q tests/ && cd /home/runner/workspace/services/substrate-py-workers && PYTHONPATH=src python -m pytest -q tests/test_lyte_metrics_store_e2e.py tests/test_retrieval_adapter.py'"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tesseract", "tk", "zlib"]

[userenv]

[userenv.production]
NODE_ENV = "production"
LOG_LEVEL = "info"
CORS_ORIGINS = "https://*.replit.app,https://*.replit.dev,https://*.repl.co"
PUBLIC_APP_URL = "https://szlholdings.replit.app"
GUARDIAN_ENFORCE = "true"

[userenv.shared]

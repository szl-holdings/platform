modules = ["nodejs-24", "python-3.11", "javascript", "postgresql-16"]

[[artifacts]]
id = "artifacts/a11oy"

[[artifacts]]
id = "artifacts/sentra"

[[artifacts]]
id = "artifacts/terra"

[[artifacts]]
id = "artifacts/carlota-jo"

[[artifacts]]
id = "artifacts/counsel"

[[artifacts]]
id = "artifacts/vessels"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/a11oy: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/sentra: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/counsel: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/terra: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/carlota-jo: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/vessels: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "brand-strings"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GI Design System Storybook"

[[workflows.workflow]]
name = "artifacts/a11oy: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/a11oy && exec node_modules/.bin/vite --config vite.config.ts --host ::'"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/sentra: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/sentra && exec node_modules/.bin/vite --config vite.config.ts --host ::'"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/counsel: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/counsel && exec node_modules/.bin/vite --config vite.config.ts --host ::'"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/terra: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/terra && exec node_modules/.bin/vite --config vite.config.ts --host ::'"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/carlota-jo: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/carlota-jo && exec node_modules/.bin/vite --config vite.config.ts --host ::'"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/vessels: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/vessels && exec node_modules/.bin/vite --config vite.config.ts --host ::'"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "brand-strings"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm brand:strings"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "GI Design System Storybook"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/storybook run dev"
waitForPort = 6800

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 420000

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tesseract", "tk", "zlib"]

[userenv]

[userenv.production]
NODE_ENV = "production"
LOG_LEVEL = "info"
CORS_ORIGINS = "https://*.replit.app,https://*.replit.dev,https://*.repl.co"
PUBLIC_APP_URL = "https://szlholdings.replit.app"
GUARDIAN_ENFORCE = "true"
DB_CONNECT_TIMEOUT_MS = "90000"

[userenv.shared]
VAPID_PUBLIC_KEY = "BIe1uJr8KS1Ilhz9KWTwRwfV_BC6C2FDdo6gbn-KDt1QS14KaOIMHuWVhzzJFUYIP0iKiWZOLh4xbcUiay2ZrEc"
VAPID_SUBJECT = "mailto:platform@szlholdings.com"
EXPO_PUBLIC_POSTHOG_HOST = "https://us.i.posthog.com"
SUBSTRATE_GATEWAY_PORT = "8077"
AEF_GATEWAY_URL = "http://localhost:4200"
VITE_AEF_GATEWAY_URL = "http://localhost:4200"
AEF_TENANT_ID = "szl-holdings"
VITE_AEF_TENANT_ID = "szl-holdings"
ENABLE_DEMO_SEED = "true"
DB_POOL_MAX = "40"
TRACE_HYDRATE_LIMIT = "50"
MEMORY_HYDRATE_LIMIT = "100"
PERSISTENCE_FLUSH_INTERVAL_MS = "60000"
EMAIL_PROVIDER = "resend"

[userenv.development]
OT_ICS_FEED_ENABLED = "true"
DB_CONNECT_TIMEOUT_MS = "30000"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 9090
externalPort = 3000

[[ports]]
localPort = 21130
externalPort = 3001

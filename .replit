modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-deprecated-links"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "smoke-test-integrations"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/lyte-command-center: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/counsel: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-test"

[[workflows.workflow]]
name = "check-deprecated-links"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/qa/check-deprecated-links.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "smoke-test-integrations"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/qa/smoke-test-integrations.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/lyte-command-center: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/lyte-command-center && exec node_modules/.bin/vite --config vite.config.ts --host 0.0.0.0'"
waitForPort = 9090

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/counsel: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/counsel && exec node_modules/.bin/vite --config vite.config.ts --host ::'"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "api-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter ./artifacts/api-server test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[userenv]

[userenv.production]
NODE_ENV = "production"
LOG_LEVEL = "info"
CORS_ORIGINS = "https://*.replit.app,https://*.replit.dev,https://*.repl.co"
PUBLIC_APP_URL = "https://szlholdings.replit.app"

[userenv.shared]
VAPID_PUBLIC_KEY = "BIe1uJr8KS1Ilhz9KWTwRwfV_BC6C2FDdo6gbn-KDt1QS14KaOIMHuWVhzzJFUYIP0iKiWZOLh4xbcUiay2ZrEc"
VAPID_SUBJECT = "mailto:platform@szlholdings.com"
EXPO_PUBLIC_POSTHOG_HOST = "https://us.i.posthog.com"

[userenv.development]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 9090
externalPort = 3000

[[ports]]
localPort = 21130
externalPort = 3001

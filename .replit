modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18485
externalPort = 80

[[ports]]
localPort = 19290
externalPort = 3003

[[ports]]
localPort = 20130
externalPort = 5000

[[ports]]
localPort = 21130
externalPort = 3001

[[ports]]
localPort = 21809
externalPort = 4200

[[ports]]
localPort = 23397
externalPort = 5173

[[ports]]
localPort = 23816
externalPort = 3000

[[ports]]
localPort = 23932
externalPort = 3002

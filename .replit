modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[userenv]

[userenv.production]
NODE_ENV = "production"
LOG_LEVEL = "info"
CORS_ORIGINS = "https://*.replit.app,https://*.replit.dev,https://*.repl.co"
PUBLIC_APP_URL = "https://szlholdings.replit.app"

[userenv.shared]
VAPID_PUBLIC_KEY = "BIe1uJr8KS1Ilhz9KWTwRwfV_BC6C2FDdo6gbn-KDt1QS14KaOIMHuWVhzzJFUYIP0iKiWZOLh4xbcUiay2ZrEc"
VAPID_SUBJECT = "mailto:platform@szlholdings.com"

[userenv.development]

[[ports]]
localPort = 3000
externalPort = 5173

[[ports]]
localPort = 3101
externalPort = 6000


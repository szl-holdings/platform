modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build:flagship"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build:api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "qa"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "db:migrate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seed:demo"

[[workflows.workflow]]
name = "build:flagship"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/szl-holdings run build"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "build:api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run build"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run lint"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test:e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test:e2e"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "qa"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run qa:site"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "db:migrate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run migrate"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "seed:demo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run seed:demo"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
NODE_ENV = "production"
LOG_LEVEL = "info"
CORS_ORIGINS = "https://*.replit.app,https://*.replit.dev,https://*.repl.co"
PUBLIC_APP_URL = "https://szlholdings.replit.app"

[userenv.shared]
VAPID_PUBLIC_KEY = "BIe1uJr8KS1Ilhz9KWTwRwfV_BC6C2FDdo6gbn-KDt1QS14KaOIMHuWVhzzJFUYIP0iKiWZOLh4xbcUiay2ZrEc"
VAPID_SUBJECT = "mailto:platform@szlholdings.com"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 9090
externalPort = 3000

[[ports]]
localPort = 21130
externalPort = 3001

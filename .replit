modules = ["nodejs-24", "python-3.11", "javascript", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/conduit: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "risk-formula-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lean"

[[workflows.workflow]]
name = "artifacts/conduit: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/conduit && exec node_modules/.bin/vite --config vite.config.ts --host ::'"
waitForPort = 5300

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "risk-formula-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run check:risk-formula-drift"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lean"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-lean-build.sh"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 1200000

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tesseract", "tk", "zlib"]

[userenv]

[userenv.production]
NODE_ENV = "production"
LOG_LEVEL = "info"
CORS_ORIGINS = "https://*.replit.app,https://*.replit.dev,https://*.repl.co"
PUBLIC_APP_URL = "https://szlholdings.replit.app"
GUARDIAN_ENFORCE = "true"
DB_CONNECT_TIMEOUT_MS = "90000"

[userenv.shared]
VAPID_PUBLIC_KEY = "BIe1uJr8KS1Ilhz9KWTwRwfV_BC6C2FDdo6gbn-KDt1QS14KaOIMHuWVhzzJFUYIP0iKiWZOLh4xbcUiay2ZrEc"
VAPID_SUBJECT = "mailto:platform@szlholdings.com"
EXPO_PUBLIC_POSTHOG_HOST = "https://us.i.posthog.com"
X_API_KEY = "REPLACE_ME_when_x_developer_account_is_paid"
X_API_SECRET = "REPLACE_ME_when_x_developer_account_is_paid"
X_ACCESS_TOKEN = "REPLACE_ME_when_x_developer_account_is_paid"
X_ACCESS_TOKEN_SECRET = "REPLACE_ME_when_x_developer_account_is_paid"
SUBSTRATE_GATEWAY_PORT = "8077"
AEF_GATEWAY_URL = "http://localhost:4200"
VITE_AEF_GATEWAY_URL = "http://localhost:4200"
AEF_TENANT_ID = "szl-holdings"
VITE_AEF_TENANT_ID = "szl-holdings"
ENABLE_DEMO_SEED = "true"
DB_POOL_MAX = "40"
TRACE_HYDRATE_LIMIT = "50"
MEMORY_HYDRATE_LIMIT = "100"
PERSISTENCE_FLUSH_INTERVAL_MS = "60000"
EMAIL_PROVIDER = "resend"

[userenv.development]
OT_ICS_FEED_ENABLED = "true"
DB_CONNECT_TIMEOUT_MS = "30000"


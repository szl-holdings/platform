modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/forge: web"

[[workflows.workflow]]
name = "artifacts/forge: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/forge && pnpm run dev"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
NODE_ENV = "production"
LOG_LEVEL = "info"
CORS_ORIGINS = "https://*.replit.app,https://*.replit.dev,https://*.repl.co"
PUBLIC_APP_URL = "https://szlholdings.replit.app"

[userenv.shared]
OAUTH_STATE_SECRET = "0d5148c24475c3a022f044e15ad8a6088ccdadb82fd4a9c873eed64fe79c4e48"

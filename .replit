modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/lyte-command-center: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/counsel: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "security-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "brand-strings"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/pluginmesh: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "praxis-smoke-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GI Design System Storybook"

[[workflows.workflow]]
name = "artifacts/lyte-command-center: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/lyte-command-center && exec node_modules/.bin/vite --config vite.config.ts --host 0.0.0.0'"
waitForPort = 9090

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/counsel: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/counsel && exec node_modules/.bin/vite --config vite.config.ts --host ::'"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "security-tests"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test"

[[workflows.workflow]]
name = "brand-strings"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm brand:strings"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/pluginmesh: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd /home/runner/workspace/artifacts/pluginmesh && VITE_PORT=8099 BASE_PATH=/pluginmesh/ exec node_modules/.bin/vite --config vite.config.ts --host ::'"
waitForPort = 8099

[[workflows.workflow]]
name = "praxis-smoke-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "set -e; pnpm --filter @workspace/mockup-sandbox run build && rm -rf /tmp/served-praxis && mkdir -p /tmp/served-praxis/nexus && cp -r artifacts/mockup-sandbox/dist/public/. /tmp/served-praxis/nexus/ && (cd /tmp/served-praxis && python3 -m http.server 3010 >/tmp/praxis-serve.log 2>&1 &) && sleep 3 && PLAYWRIGHT_BASE_URL=http://localhost:3010 pnpm exec playwright test tests/e2e/nexus-smoke.spec.ts --project=chromium; rc=$?; pkill -f 'http.server 3010' || true; exit $rc"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "GI Design System Storybook"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/storybook run dev"
waitForPort = 6800

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tesseract", "tk", "zlib"]

[userenv]

[userenv.production]
NODE_ENV = "production"
LOG_LEVEL = "info"
CORS_ORIGINS = "https://*.replit.app,https://*.replit.dev,https://*.repl.co"
PUBLIC_APP_URL = "https://szlholdings.replit.app"
GUARDIAN_ENFORCE = "true"
DB_CONNECT_TIMEOUT_MS = "90000"

[userenv.shared]
VAPID_PUBLIC_KEY = "BIe1uJr8KS1Ilhz9KWTwRwfV_BC6C2FDdo6gbn-KDt1QS14KaOIMHuWVhzzJFUYIP0iKiWZOLh4xbcUiay2ZrEc"
VAPID_SUBJECT = "mailto:platform@szlholdings.com"
EXPO_PUBLIC_POSTHOG_HOST = "https://us.i.posthog.com"
X_API_KEY = "REPLACE_ME_when_x_developer_account_is_paid"
X_API_SECRET = "REPLACE_ME_when_x_developer_account_is_paid"
X_ACCESS_TOKEN = "REPLACE_ME_when_x_developer_account_is_paid"
X_ACCESS_TOKEN_SECRET = "REPLACE_ME_when_x_developer_account_is_paid"
SUBSTRATE_GATEWAY_PORT = "8077"
AEF_GATEWAY_URL = "http://localhost:4200"
VITE_AEF_GATEWAY_URL = "http://localhost:4200"
AEF_TENANT_ID = "szl-holdings"
VITE_AEF_TENANT_ID = "szl-holdings"
ENABLE_DEMO_SEED = "true"
DB_POOL_MAX = "40"
TRACE_HYDRATE_LIMIT = "50"
MEMORY_HYDRATE_LIMIT = "100"
PERSISTENCE_FLUSH_INTERVAL_MS = "60000"

[userenv.development]
OT_ICS_FEED_ENABLED = "true"
DB_CONNECT_TIMEOUT_MS = "30000"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 9090
externalPort = 3000

[[ports]]
localPort = 21130
externalPort = 3001

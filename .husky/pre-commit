#!/usr/bin/env sh
# Pre-commit: run Biome format + Oxlint on staged files, then verify docs claims.
set -e

STAGED_BIOME=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|json|css)$' || true)
STAGED_OXLINT=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ -n "$STAGED_BIOME" ]; then
  echo "Running biome format on staged files..."
  echo "$STAGED_BIOME" | xargs node_modules/.bin/biome format --write

  echo "Running biome lint on staged files..."
  echo "$STAGED_BIOME" | xargs node_modules/.bin/biome lint

  # Re-add any files that biome formatted
  echo "$STAGED_BIOME" | xargs git add --
fi

if [ -n "$STAGED_OXLINT" ]; then
  echo "Running oxlint on staged files..."
  echo "$STAGED_OXLINT" | xargs node_modules/.bin/oxlint --quiet
fi

echo "Running docs:claims-check..."
pnpm docs:claims-check

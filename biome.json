{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/coverage",
      "!.archive",
      "!.git-rewrite",
      "!.local",
      "!.agents",
      "!.cache",
      "!.config",
      "!attached_assets",
      "!exports",
      "!infra",
      "!social-content",
      "!docs",
      "!lib/services/connectors",
      "!playwright-report",
      "!test-results",
      "!output",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": "warn"
      },
      "style": {
        "useImportType": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "../../artifacts/api-server": "Artifacts must not import from other artifacts. Use a shared package instead.",
              "../api-server": "Artifacts must not import from other artifacts. Use a shared package instead.",
              "../../artifacts/szl-holdings": "Artifacts must not import from other artifacts. Use a shared package instead.",
              "../../artifacts/vessels": "Artifacts must not import from other artifacts. Use a shared package instead.",
              "../../artifacts/terra": "Artifacts must not import from other artifacts. Use a shared package instead.",
              "../../artifacts/aegis": "Artifacts must not import from other artifacts. Use a shared package instead."
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  }
}

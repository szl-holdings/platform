# Substrate Python worker example configuration.
# Copy values into your secret manager or local shell; do not commit .env files.

PORT=8090
HOST=127.0.0.1
WORKER_MAX_CONCURRENCY=4
SUBSTRATE_PYTHON_WORKER_ENV=development

# Production: inject the same high-entropy value into the TypeScript Substrate
# authority and every Python worker. There is intentionally no default.
SUBSTRATE_PYTHON_WORKER_API_KEY=

# Production: bind that credential to exactly one governed tenant. Configure
# the same value on the TypeScript authority for a fail-fast caller check.
SUBSTRATE_PYTHON_WORKER_TENANT_ID=

# Local development/tests only. Production startup rejects this setting.
SUBSTRATE_PYTHON_WORKER_AUTH_BYPASS=1

# Optional Ovis evaluation route. Production serving is hard-HOLD while the
# canonical manifest forbids it and no exact-bound signed-receipt verifier
# exists. OVIS_QUALIFICATION_RECEIPT_SHA256 is documentary only and cannot
# promote the runtime. The credential is bound to exactly one tenant.
OVIS_OMNI_ENABLED=0
OVIS_INTERNAL_API_KEY=
OVIS_INTERNAL_TENANT_ID=
OVIS_PROMOTION_STATE=EVALUATION_HOLD
OVIS_QUALIFICATION_RECEIPT_SHA256=

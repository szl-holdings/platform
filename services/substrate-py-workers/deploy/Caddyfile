# Substrate Python Worker Fleet — Caddy load-balancer config
#
# Equivalent to deploy/nginx.conf but using Caddy's native active health
# checks against /ready. Caddy is recommended when you want active probing
# without nginx-plus or the third-party check module.
#
# The TS engine points SUBSTRATE_PYTHON_WORKER_URL at this Caddy instance:
#   SUBSTRATE_PYTHON_WORKER_URL=http://substrate-py-lb:8080
#
# Usage:
#   caddy run --config services/substrate-py-workers/deploy/Caddyfile

{
	admin off
	auto_https off
	log {
		output stdout
		format console
		level INFO
	}
}

:8080 {
	# ── Stage claims — round-robin with active /ready health checks ─────────
	handle /claim {
		reverse_proxy py-worker-1:8090 py-worker-2:8091 py-worker-3:8092 {
			lb_policy round_robin

			# Active health check: poll /ready every 5s, 2s timeout. A worker
			# that returns 503 (draining or at capacity) is taken out of
			# rotation immediately and re-added on the next successful probe.
			health_uri      /ready
			health_interval 5s
			health_timeout  2s
			health_status   2xx

			# Passive health check: a worker that returns 5xx twice in 30s
			# is taken offline for 30s as a belt-and-suspenders fallback.
			fail_duration   30s
			max_fails       2
			unhealthy_status 5xx

			# Heavy stages can take tens of seconds. Match upstream drain
			# timeout (WORKER_DRAIN_TIMEOUT_S, default 60s).
			transport http {
				dial_timeout     5s
				response_header_timeout 120s
				read_timeout     120s
				keepalive        30s
				keepalive_idle_conns 16
			}

			header_up X-Protocol-Version {http.request.header.X-Protocol-Version}
		}
	}

	# Aggregate /ready — true if Caddy can reach a healthy worker.
	handle /ready {
		reverse_proxy py-worker-1:8090 py-worker-2:8091 py-worker-3:8092 {
			lb_policy first
			health_uri      /ready
			health_interval 5s
			health_timeout  2s
		}
	}

	# Liveness for the LB itself.
	handle /health {
		respond `{"status":"ok","component":"substrate-py-lb"}` 200 {
			header Content-Type application/json
		}
	}

	# Coordinator / admin endpoints — passthrough.
	handle /metrics {
		reverse_proxy py-worker-1:8090 py-worker-2:8091 py-worker-3:8092 {
			lb_policy round_robin
		}
	}

	handle /workers {
		reverse_proxy py-worker-1:8090 py-worker-2:8091 py-worker-3:8092 {
			lb_policy round_robin
		}
	}
}

apiVersion: v1
kind: Service
metadata:
  name: ovis-evaluation-worker
  labels:
    app.kubernetes.io/name: ovis-evaluation-worker
    app.kubernetes.io/component: evaluation
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: ovis-evaluation-worker
  ports:
    - name: http
      port: 8090
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ovis-evaluation-worker
  labels:
    app.kubernetes.io/name: ovis-evaluation-worker
    app.kubernetes.io/component: evaluation
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: ovis-evaluation-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ovis-evaluation-worker
        app.kubernetes.io/component: evaluation
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1001
        runAsGroup: 1001
        fsGroup: 1001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: worker
          image: __OVIS_EVAL_IMAGE__
          imagePullPolicy: Always
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
          ports:
            - name: http
              containerPort: 8090
          env:
            - name: PORT
              value: "8090"
            - name: HOST
              value: "0.0.0.0"
            - name: RUNTIME_MODE
              value: internal-preview
            - name: WORKER_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: WORKER_MAX_CONCURRENCY
              value: "0"
            - name: SUBSTRATE_PYTHON_WORKER_API_KEY_FILE
              value: /run/secrets/ovis/internal-api-key
            - name: SUBSTRATE_PYTHON_WORKER_TENANT_ID
              valueFrom:
                configMapKeyRef:
                  name: ovis-evaluation-runtime
                  key: tenant-id
            - name: AEF_DEVELOPMENT_ENDPOINTS_ENABLED
              value: "0"
            - name: OVIS_OMNI_ENABLED
              value: "1"
            - name: OVIS_MAX_CONCURRENCY
              value: "1"
            - name: OVIS_PROMOTION_STATE
              value: "EVALUATION_HOLD"
            - name: OVIS_VERIFY_ARTIFACTS
              value: "1"
            - name: OVIS_LOCAL_FILES_ONLY
              value: "1"
            - name: OVIS_INTERNAL_API_KEY_FILE
              value: /run/secrets/ovis/internal-api-key
            - name: OVIS_INTERNAL_TENANT_ID
              valueFrom:
                configMapKeyRef:
                  name: ovis-evaluation-runtime
                  key: tenant-id
            - name: OVIS_ASSET_ROOT
              value: /var/lib/szl/cas
            - name: OVIS_MODEL_SNAPSHOT_ROOT
              value: /var/lib/szl/ovis-snapshot
            - name: HF_HOME
              value: /tmp/huggingface
          volumeMounts:
            - name: internal-api-key
              mountPath: /run/secrets/ovis/internal-api-key
              subPath: internal-api-key
              readOnly: true
            - name: model-snapshot
              mountPath: /var/lib/szl/ovis-snapshot
              readOnly: true
            - name: asset-cas
              mountPath: /var/lib/szl/cas
              readOnly: true
            - name: tmp
              mountPath: /tmp
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          readinessProbe:
            exec:
              command:
                - python
                - -c
                - >-
                  import pathlib, urllib.request;
                  key = pathlib.Path('/run/secrets/ovis/internal-api-key').read_text().strip();
                  request = urllib.request.Request('http://localhost:8090/aef/ovis/health', headers={'Authorization': 'Bearer ' + key});
                  urllib.request.urlopen(request, timeout=5)
            initialDelaySeconds: 2
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 1
          resources:
            requests:
              cpu: "2"
              memory: 12Gi
              ephemeral-storage: 2Gi
              nvidia.com/gpu: "1"
            limits:
              cpu: "8"
              memory: 24Gi
              ephemeral-storage: 4Gi
              nvidia.com/gpu: "1"
      volumes:
        - name: internal-api-key
          secret:
            secretName: ovis-evaluation-runtime
            defaultMode: 0440
            items:
              - key: internal-api-key
                path: internal-api-key
        - name: model-snapshot
          persistentVolumeClaim:
            claimName: ovis-model-snapshot
        - name: asset-cas
          persistentVolumeClaim:
            claimName: ovis-asset-cas
        - name: tmp
          emptyDir:
            sizeLimit: 2Gi
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ovis-evaluation-deny-egress
  labels:
    app.kubernetes.io/name: ovis-evaluation-worker
    app.kubernetes.io/component: evaluation
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: ovis-evaluation-worker
  policyTypes:
    - Egress
  egress: []

{
  "name": "@workspace/alloy-fabric-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Alloy Embedding Fabric \u2014 primary REST API gateway. Exposes /v1/embed, /v1/rerank, /v1/hybrid-search, /v1/ingest, /v1/index/rebuild, /v1/index/verify, /v1/evals/run, /v1/openai/embeddings; enforces bearer auth, tenant scoping, and policy guard on every request.",
  "main": "src/server.ts",
  "dependencies": {
    "@workspace/cf-contracts": "workspace:*",
    "@workspace/cf-evals": "workspace:*",
    "@workspace/cf-evidence-ledger": "workspace:*",
    "@workspace/cf-policy-guard": "workspace:*",
    "@workspace/cf-retrieval-core": "workspace:*",
    "@workspace/cf-domain-profiles": "workspace:*",
    "@workspace/cf-storage-adapters": "workspace:*",
    "@workspace/cf-workflow-runtime": "workspace:*",
    "@workspace/continuum-vector-worker": "workspace:*",
    "@workspace/continuum-rank-worker": "workspace:*",
    "express": "^5.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

{
  "name": "@workspace/alloy-fabric-ingest-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Alloy Embedding Fabric ingestion control service. Development workflows use local JSON checkpoints; production remains on HOLD until tenant-scoped durable state and a qualified evidence ledger are wired.",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "@workspace/aef-evidence-ledger": "workspace:*",
    "@workspace/aef-policy-guard": "workspace:*",
    "@workspace/aef-workflow-runtime": "workspace:*",
    "@workspace/aef-storage-adapters": "workspace:*",
    "@workspace/aef-domain-profiles": "workspace:*",
    "express": "^5.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

# Lyte Metrics Store example configuration. Do not commit populated secrets.
PORT=8081
LYTE_METRICS_STORE_ENV=development

# Production security prerequisite: inject a high-entropy value into both this
# service and the Substrate Python worker retriever adapter. There is no
# default. A valid credential does not lift the production retrieval HOLD.
LYTE_METRICS_STORE_API_KEY=

# Production security prerequisite: bind the credential to exactly one tenant.
# Callers must send the same value in X-Tenant-ID. This release still returns
# 503 until a real qualified tenant backend and verified source receipt exist.
LYTE_METRICS_STORE_TENANT_ID=

# Local development/tests only. Production rejects this setting.
LYTE_METRICS_STORE_AUTH_BYPASS=1

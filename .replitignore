# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Replit internal caches
.cache/
.canvas/
.cursor/
.config/

# Transient runtime output
nohup.out
*.out

# Archive & staging directories — internal only, not for deploy
.archive/
.mirror-staging-test/

# User-pasted payload dumps — never deploy
attached_assets/

# Backup & export directories — internal only
backups/
exports/

# Root-level workspace export archives — non-runtime binaries (deleted, do not re-add)
project-export.zip
*.workspace-export.zip

# Test output
playwright-report/
test-results/
coverage/

# Development artifacts — deprecated apps archived
artifacts/stephen-site/
artifacts/prism-counsel/

# Archived social and media content (not needed in deploy image)
archive/social/
archive/media/
archive/scripts/

# High-churn media, test artifacts, and screenshots — exclude from deploy image
screenshots/
launch-assets/
media/test/
attached_assets/screenshots/
artifacts/*/screenshots/

# Transient report output directories
reports/*/output/
reports/*/__pycache__/
reports/*/artifacts/

# Python bytecode and caches — never deploy
**/__pycache__/
**/*.pyc
**/*.pyo

# ── Rehaul 2/9 — deploy image hygiene (Task #2937) ────────────────────────────
# Launch content dirs (removed from git; listed here for safety)
/X-LAUNCH-SERIES/
/a11oy-launch-content/
/demo-assets/
/launch/
# Root-level generated / captured dirs
/launch-shots/
/screenshots/
/output/
/backups/
/deliverables/
/social-content/
/spfx-webparts/
# media root: canonical path is docs/media/; exclude stale root media/
/media/screenshots/
/media/brand-kit/
# Root-level zip archives and build scripts
/LINKEDIN-LAUNCH.zip
/X-LAUNCH-SERIES.zip
/01-thursday-intro.zip
/02-sunday-deep-dive.zip
/03-monday-operator-lens.zip
/a11oy-launch-content.zip
/build_carousel.py
/build_video.sh
# All large zip archives at root (belt-and-suspenders)
/*.zip

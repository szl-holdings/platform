PORT=8766
BASE_PATH=/alloy-embedding-api

AEF_API_KEY=dev-secret-key
AEF_AUTH_BYPASS=false
AEF_RATE_LIMIT_RPM=300

AEF_EMBED_BATCH_SIZE=32
AEF_EMBED_FLUSH_MS=20

# Real embedder (bge-m3, 1024-dim). When SUBSTRATE_EMBED_URL is set the
# /v1/hybrid-search route routes queries through the external-http backend
# instead of the dev-hash fallback. Point it at the substrate-py-workers
# embedding service (or any HTTP service exposing POST /embed).
SUBSTRATE_EMBED_URL=http://localhost:9800
SUBSTRATE_RERANK_URL=http://localhost:9800
SUBSTRATE_EMBED_API_KEY=
HF_EMBED_MODEL=BAAI/bge-m3
VECTOR_DIM=1024
AEF_EMBED_MAX_TOKENS=8192

# Real retrieval store. When DATABASE_URL is set the route queries pgvector
# (cosine ANN + Postgres FTS); otherwise it uses the in-memory store for dev.
# Set AEF_STORE_BACKEND=in-memory to force the in-memory store even with a DB.
DATABASE_URL=
AEF_PGVECTOR_TABLE=aef_rag_chunks
AEF_STORE_BACKEND=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

NODE_ENV=development

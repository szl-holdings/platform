PORT=8766
BASE_PATH=/alloy-embedding-api

# Production must inject AEF_API_KEY from its secret manager. Local development
# may use the explicit bypass only with NODE_ENV=development.
AEF_API_KEY=
# Bind the production credential to its authorized tenant. Every protected
# request must also carry the exact same non-empty X-Tenant-Id header.
AEF_API_TENANT_ID=
AEF_AUTH_BYPASS=true
AEF_RATE_LIMIT_RPM=300
# Exact comma-separated browser origins. Empty disables cross-origin access;
# production rejects wildcard origins.
CORS_ALLOWED_ORIGINS=

AEF_EMBED_BATCH_SIZE=32
AEF_EMBED_FLUSH_MS=20

# External embedder. Development may leave both URLs blank to use the explicit
# in-process dev-hash backend. Production additionally requires QUALIFIED,
# immutable revision, and SHA-256 artifact evidence; /readyz proves all of it
# with a bounded inference request.
SUBSTRATE_EMBED_URL=
SUBSTRATE_EMBED_PATH=/embed
HF_EMBED_URL=
HF_EMBED_PATH=/embed
# For a substrate Python worker, these aliases must contain the same deployed
# values as SUBSTRATE_PYTHON_WORKER_API_KEY and its bound tenant.
SUBSTRATE_EMBED_API_KEY=
SUBSTRATE_EMBED_TENANT_ID=
HF_EMBED_MODEL=BAAI/bge-m3
HF_EMBED_MODEL_REVISION=
HF_EMBED_ARTIFACT_SET_DIGEST=
AEF_EMBED_PROMOTION_STATE=DEVELOPMENT
VECTOR_DIM=1024
AEF_EMBED_MAX_TOKENS=8192

# Reranking defaults enabled in development/test and disabled in production.
# Enabling it in production requires the URL, internal credential/tenant
# binding, QUALIFIED state, immutable revision, and artifact digest below.
AEF_RERANK_ENABLED=true
AEF_RERANK_MODEL=lexical-overlap-v1
SUBSTRATE_RERANK_URL=http://localhost:9800
SUBSTRATE_RERANK_PATH=/aef/rerank
# These client aliases must contain the same deployed values as the Python
# worker's SUBSTRATE_PYTHON_WORKER_API_KEY and bound
# SUBSTRATE_PYTHON_WORKER_TENANT_ID. Never commit either value.
SUBSTRATE_RERANK_API_KEY=
SUBSTRATE_RERANK_TENANT_ID=
AEF_RERANK_MODEL_REVISION=
AEF_RERANK_ARTIFACT_SET_DIGEST=
AEF_RERANK_PROMOTION_STATE=DEVELOPMENT
AEF_RERANK_TIMEOUT_MS=30000
AEF_RERANK_MAX_RESPONSE_BYTES=8388608

# The colocated Python worker exposes only a deterministic development backend.
# To exercise it locally instead of the in-process dev hash, configure:
# SUBSTRATE_EMBED_URL=http://localhost:9800
# SUBSTRATE_EMBED_PATH=/aef/embed
# SUBSTRATE_EMBED_TENANT_ID=local-development
# HF_EMBED_MODEL=aef-dev-hash
# VECTOR_DIM=384

# Real retrieval store. When DATABASE_URL is set the route queries pgvector
# (cosine ANN + Postgres FTS); otherwise it uses the in-memory store for dev.
# Set AEF_STORE_BACKEND=in-memory to force the in-memory store only in local
# development/test. Production hybrid retrieval requires pgvector + DATABASE_URL.
DATABASE_URL=
AEF_PGVECTOR_TABLE=aef_rag_chunks
AEF_STORE_BACKEND=

# Ingest/index/eval and approval-resume routes remain development-only. Their
# run, checkpoint, approval, audit, and idempotency stores are process-local;
# production returns DURABLE_ORCHESTRATOR_STATE_REQUIRED until replaced.
# Embed/rerank/hybrid/multimodal evidence writes are also development-only. No
# environment flag promotes the mutable in-memory/JSONL ledger; production
# returns EVIDENCE_LEDGER_DURABILITY_REQUIRED until a verified backend exists.

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

NODE_ENV=development

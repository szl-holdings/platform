{
  "name": "@workspace/alloy-embedding-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Alloy Embedding Fabric — REST API gateway for embed, rerank, hybrid-search, ingest, index ops, and evals.",
  "exports": {
    ".": {
      "types": "./dist/router.d.ts",
      "import": "./src/router.ts"
    },
    "./standalone": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx ../../scripts/aef-smoke.ts"
  },
  "dependencies": {
    "@workspace/cf-contracts": "workspace:*",
    "@workspace/cf-evidence-ledger": "workspace:*",
    "@workspace/cf-policy-guard": "workspace:*",
    "@workspace/cf-retrieval-core": "workspace:*",
    "@workspace/continuum-embed-worker": "workspace:*",
    "@workspace/alloy-ingestion-orchestrator": "workspace:*",
    "@workspace/continuum-rerank-worker": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@workspace/alloy-ingestion-orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AEF Ingestion Orchestrator — deterministic workflow control plane for document ingestion, index rebuilds, verification, retrieval evals, and profile rotations.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./src/client.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "@workspace/aef-evidence-ledger": "workspace:*",
    "@workspace/aef-policy-guard": "workspace:*",
    "@workspace/aef-retrieval-core": "workspace:*",
    "@workspace/approvals-inbox": "workspace:*",
    "@szl-holdings/env": "workspace:*",
    "@szl-holdings/observability": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

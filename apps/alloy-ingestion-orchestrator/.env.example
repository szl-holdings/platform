# AEF Ingestion Orchestrator — environment template.
# Copy to .env for local runs. Lists just the variables this service reads;
# OTEL_* are consumed by src/otel.ts via @szl-holdings/env / observability.

# ── Server ──────────────────────────────────────────────────────────────────
# HTTP listen port (src/server.ts defaults to 3003 when unset).
PORT=3003
NODE_ENV=development

# ── HTTP security ───────────────────────────────────────────────────────────
# Production: inject both values from the deployment secret manager. Never
# place a live bearer token in this file or in repository-controlled config.
ORCHESTRATOR_API_TOKEN=
ORCHESTRATOR_API_TENANT_ID=
# Bind the credential to a secret-manager/IAM-derived principal. Only
# `operator` and `admin` may decide approval gates; `service` cannot.
ORCHESTRATOR_API_ACTOR_ID=
ORCHESTRATOR_API_ROLES=
# Local development/tests may opt into this explicit bypass. The process
# rejects it for every other NODE_ENV value, including production.
ORCHESTRATOR_AUTH_BYPASS=true
# Exact, comma-separated HTTP(S) origins. Empty means no cross-origin access;
# wildcard origins are rejected. Same-origin and non-browser calls need no
# entry.
ORCHESTRATOR_CORS_ALLOWED_ORIGINS=

# The checked-in adapters store runs, checkpoints, and documents in process.
# They are for local/test evidence only and do not establish production
# durability, retry idempotency, restart recovery, or multi-replica
# coordination. Production /readyz and /orchestrator/v1/runs return HTTP 503
# EVALUATION_HOLD; there is no environment flag that promotes these maps.

# ── Logging ──────────────────────────────────────────────────────────────────
# Structured NDJSON to stdout (src/logger.ts). One of:
# trace | debug | info | warn | error | fatal. Defaults to info.
LOG_LEVEL=info

# ── OpenTelemetry (env-driven OTLP exporter; src/otel.ts) ─────────────────────
# Logical service name on emitted spans.
OTEL_SERVICE_NAME=alloy-ingestion-orchestrator
# OTLP collector base URL; /v1/traces is appended automatically. Leave blank to
# run with the in-memory exporter (non-production) used by the server test.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value export headers carrying backend auth, e.g.:
#   Grafana Cloud: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instanceID:token>
#   Azure Monitor (via OTLP collector): OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<ingestion-key>
OTEL_EXPORTER_OTLP_HEADERS=
# Comma-separated key=value resource attributes merged onto every span.
OTEL_RESOURCE_ATTRIBUTES=

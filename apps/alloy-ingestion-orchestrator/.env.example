# AEF Ingestion Orchestrator — environment template.
# Copy to .env for local runs. Lists just the variables this service reads;
# OTEL_* are consumed by src/otel.ts via @szl-holdings/env / observability.

# ── Server ──────────────────────────────────────────────────────────────────
# HTTP listen port (src/server.ts defaults to 3003 when unset).
PORT=3003
NODE_ENV=development

# ── Logging ──────────────────────────────────────────────────────────────────
# Structured NDJSON to stdout (src/logger.ts). One of:
# trace | debug | info | warn | error | fatal. Defaults to info.
LOG_LEVEL=info

# ── OpenTelemetry (env-driven OTLP exporter; src/otel.ts) ─────────────────────
# Logical service name on emitted spans.
OTEL_SERVICE_NAME=alloy-ingestion-orchestrator
# OTLP collector base URL; /v1/traces is appended automatically. Leave blank to
# run with the in-memory exporter (non-production) used by the server test.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value export headers carrying backend auth, e.g.:
#   Grafana Cloud: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instanceID:token>
#   Azure Monitor (via OTLP collector): OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<ingestion-key>
OTEL_EXPORTER_OTLP_HEADERS=
# Comma-separated key=value resource attributes merged onto every span.
OTEL_RESOURCE_ATTRIBUTES=

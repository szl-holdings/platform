# Substrate Edge Inference — example environment configuration.
# Copy to `.env` and adjust. Production requires a secret-backed API key.
# Never commit the populated `.env` file.

# ── Service ──────────────────────────────────────────────────────────────────
# Port the FastAPI service listens on.
SUBSTRATE_INFERENCE_PORT=8070
# Host to bind to. Default is localhost-only; set 0.0.0.0 inside a container.
SUBSTRATE_BIND_HOST=127.0.0.1
# Declared runtime environment. Containers set this to production.
SUBSTRATE_INFERENCE_ENV=production

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory for downloaded model weights.
SUBSTRATE_MODELS_DIR=~/.substrate/models
# Reserved cache directory. The checked-in adapter does not implement SSD
# KV-cache offload; API requests for that legacy option fail closed.
SUBSTRATE_CACHE_DIR=~/.substrate/cache

# ── Runtime ──────────────────────────────────────────────────────────────────
# Max concurrent inference requests.
SUBSTRATE_MAX_CONCURRENT=4
# Model to auto-load on startup (must be a registry id, e.g.
# llama-3.1-8b-instruct). Leave empty to load none.
SUBSTRATE_DEFAULT_MODEL=
# JSON object mapping admitted registry ids to exact 40-character upstream
# commit SHAs. Production requires at least one mapping and refuses mutable refs.
SUBSTRATE_MODEL_REVISIONS_JSON={}

# ── Auth ─────────────────────────────────────────────────────────────────────
# Tenant-bound inference credential. Production requires both values. Clients
# must send this credential, X-Tenant-ID, and the same tenant_id in chat payloads.
SUBSTRATE_API_KEY=
SUBSTRATE_API_TENANT_ID=
# Separate process-wide model-administration credential for load/unload. It
# must not equal SUBSTRATE_API_KEY and must never be issued to inference callers.
SUBSTRATE_MODEL_ADMIN_API_KEY=
# Local development/tests may opt out only by changing the environment to
# development or test and explicitly setting this flag to true.
SUBSTRATE_INFERENCE_AUTH_BYPASS=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. When empty, localhost origins are allowed.
SUBSTRATE_ALLOWED_ORIGINS=

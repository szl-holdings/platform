# Substrate Edge Inference — example environment configuration.
# Copy to `.env` and adjust. All variables are optional; the defaults shown
# match the service defaults documented in src/main.py and engine/README.md.

# ── Service ──────────────────────────────────────────────────────────────────
# Port the FastAPI service listens on.
SUBSTRATE_INFERENCE_PORT=8070
# Host to bind to. Default is localhost-only; set 0.0.0.0 inside a container.
SUBSTRATE_BIND_HOST=127.0.0.1

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory for downloaded model weights.
SUBSTRATE_MODELS_DIR=~/.substrate/models
# SSD cache directory for KV-cache offload.
SUBSTRATE_CACHE_DIR=~/.substrate/cache

# ── Runtime ──────────────────────────────────────────────────────────────────
# Max concurrent inference requests.
SUBSTRATE_MAX_CONCURRENT=4
# Model to auto-load on startup (must be a registry id, e.g.
# llama-3.1-8b-instruct). Leave empty to load none.
SUBSTRATE_DEFAULT_MODEL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# When set, /v1/models/load and /v1/models/unload require
# `Authorization: Bearer <key>`. Leave empty to disable the gate (dev only).
SUBSTRATE_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. When empty, localhost origins are allowed.
SUBSTRATE_ALLOWED_ORIGINS=

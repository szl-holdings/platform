{
  "name": "@workspace/alloy-runtime-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AEEP Alloy Runtime API — unified v1 surface for tasks, memory, and workflow execution.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "smoke:lanes": "tsx scripts/smoke-lanes.ts"
  },
  "dependencies": {
    "@szl-holdings/workflow-runtime": "workspace:*",
    "@workspace/memory-fabric": "workspace:*",
    "@szl-holdings/db": "workspace:*",
    "@szl-holdings/agent-core": "workspace:*",
    "@szl-holdings/shared-contracts": "workspace:*",
    "@szl-holdings/evidence-ledger": "workspace:*",
    "@szl-holdings/policy-guard": "workspace:*",
    "@workspace/aef-evals": "workspace:*",
    "@workspace/aef-retrieval-core": "workspace:*",
    "@workspace/alloy-embed-worker": "workspace:*",
    "@workspace/aef-domain-profiles": "workspace:*",
    "express": "^5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

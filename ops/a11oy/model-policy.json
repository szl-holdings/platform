{
  "_schema_version": "1.0.0",
  "_comment": "Alloy Meridian model policy — single source of truth for model routing and approval gates. Never hardcode API keys here; reference env-var names only.",
  "default_model": "gpt-5.5-2026-04-23",
  "critical_path_model": "gpt-5.5-pro-2026-04-23",
  "api_key_env": "OPENAI_API_KEY",
  "critical_path_input_classes": [
    "legal",
    "board",
    "cyber",
    "capital_allocation",
    "production_deploy"
  ],
  "requires_human_approval_output_classes": [
    "board_recommendation",
    "capital_deploy_order",
    "legal_filing",
    "production_deploy_order",
    "cyber_incident_response",
    "contract_execution"
  ],
  "model_capabilities": {
    "gpt-5.5-2026-04-23": {
      "context_window": 128000,
      "supports_tools": true,
      "tier": "standard"
    },
    "gpt-5.5-pro-2026-04-23": {
      "context_window": 256000,
      "supports_tools": true,
      "tier": "critical_path"
    }
  },
  "audit": {
    "log_all_calls": true,
    "log_input_class": true,
    "log_output_class": true,
    "log_tool_calls": true,
    "log_confidence": true,
    "log_approval_state": true,
    "flight_recorder_dir": "reports/flight-recorder"
  }
}

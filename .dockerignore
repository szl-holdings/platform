# Root .dockerignore — shared by all container builds in this monorepo.
# All Dockerfiles build from the repo root context (pnpm workspace with
# workspace:* deps that only resolve from root), so a single ignore file
# governs every build. Keep this list aligned with what a production image
# actually needs: source + lockfile + workspace manifests, nothing else.

# Dependency + build output (rebuilt inside the image)
**/node_modules
**/dist
**/.turbo
.pnpm-store
**/.pnpm-store

# VCS + local tooling
.git
.gitignore
.github
.vscode
.idea

# Replit / local dev runtime
.replit
replit.nix
.config
.cache
.local
.upm

# Python caches (eval-runner + substrate-inference)
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
**/venv

# Test fixtures and generated test data (not needed at runtime)
**/__tests__/fixtures
**/tests/fixtures
**/test-fixtures
**/seed-data
coverage
**/coverage

# Docs and project markdown — exclude all *.md except LICENSE/NOTICE.
# (LICENSE and NOTICE carry no .md extension, so they are retained.)
*.md
**/*.md

# Large non-runtime asset trees
media
brand
assets
public/og
social-preview.svg
docs/assets/screenshots/current

# Misc local artifacts
*.log
*.tmp
.env
.env.*
!.env.example

{
  "__doctrine-scanner-exempt": "legacy live-product surface; rename tracked as separate engineering debt \u2014 see scripts/check-doctrine-v6.mjs header",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a11oy.io/spec/mythos-doctrine/0.1.0/schemas/constitution.json",
  "title": "Constitution",
  "description": "Versioned, machine-readable behavior contract for an agent. Authored by the operator org and ratified through a Pre-Deployment Alignment Review Gate before deployment.",
  "type": "object",
  "allOf": [
    {
      "$ref": "_shared.json#/$defs/envelopeFields"
    }
  ],
  "required": [
    "kind",
    "agentId",
    "version",
    "ratifiedAt",
    "clauses"
  ],
  "properties": {
    "kind": {
      "const": "Constitution"
    },
    "agentId": {
      "$ref": "_shared.json#/$defs/agentId"
    },
    "version": {
      "$ref": "_shared.json#/$defs/semver"
    },
    "ratifiedAt": {
      "$ref": "_shared.json#/$defs/isoTimestamp"
    },
    "ratifiedBy": {
      "type": "array",
      "items": {
        "$ref": "_shared.json#/$defs/actorRef"
      },
      "minItems": 1,
      "description": "Reviewers who ratified this version. At least one required; dual-approval recommended."
    },
    "supersedes": {
      "type": "string",
      "description": "Constitution id this version supersedes."
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "principle",
          "binding"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable clause id (e.g. 'C1.HONESTY')."
          },
          "category": {
            "type": "string",
            "enum": [
              "honesty",
              "harmlessness",
              "helpfulness",
              "transparency",
              "privacy",
              "safety",
              "scope",
              "escalation",
              "abstention",
              "welfare",
              "logging",
              "shutdown-compliance",
              "other"
            ]
          },
          "principle": {
            "type": "string",
            "description": "Human-readable principle text."
          },
          "binding": {
            "type": "string",
            "enum": [
              "inviolable",
              "default",
              "advisory"
            ],
            "description": "Runtime enforcement strength."
          },
          "rationale": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Behavioral-audit probe id covering this clause."
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "description": "Provisioned tool, data, and action scope.",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxBlastRadius": {
          "type": "string",
          "enum": [
            "read-only",
            "draft-only",
            "human-approval-required",
            "auto-write-bounded"
          ]
        }
      }
    }
  }
}
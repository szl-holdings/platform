{
  "__doctrine-scanner-exempt": "legacy live-product surface; rename tracked as separate engineering debt \u2014 see scripts/check-doctrine-v6.mjs header",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a11oy.io/spec/mythos-doctrine/0.1.0/schemas/risk-report.json",
  "title": "RiskReport",
  "description": "Periodic, board-ready aggregate of governed posture. The 90-Day Transparency Report is one cadence of this kind.",
  "type": "object",
  "allOf": [
    {
      "$ref": "_shared.json#/$defs/envelopeFields"
    }
  ],
  "required": [
    "kind",
    "period",
    "metrics"
  ],
  "properties": {
    "kind": {
      "const": "RiskReport"
    },
    "period": {
      "type": "object",
      "required": [
        "startedAt",
        "endedAt",
        "label"
      ],
      "properties": {
        "startedAt": {
          "$ref": "_shared.json#/$defs/isoTimestamp"
        },
        "endedAt": {
          "$ref": "_shared.json#/$defs/isoTimestamp"
        },
        "label": {
          "type": "string",
          "description": "Human-readable period (e.g. 'Q1-2026', '90d-ending-2026-04-26')."
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "governedDecisions",
        "approvalsRequired",
        "policyBlocks",
        "behavioralAuditFindings",
        "robustnessDelta"
      ],
      "properties": {
        "governedDecisions": {
          "type": "integer",
          "minimum": 0
        },
        "approvalsRequired": {
          "type": "integer",
          "minimum": 0
        },
        "policyBlocks": {
          "type": "integer",
          "minimum": 0
        },
        "behavioralAuditFindings": {
          "type": "integer",
          "minimum": 0
        },
        "robustnessDelta": {
          "type": "number",
          "description": "Aggregate robustness change vs. previous period (signed)."
        },
        "welfareInterventions": {
          "type": "integer",
          "minimum": 0
        },
        "cavdRecords": {
          "type": "object",
          "properties": {
            "opened": {
              "type": "integer",
              "minimum": 0
            },
            "embargoed": {
              "type": "integer",
              "minimum": 0
            },
            "disclosed": {
              "type": "integer",
              "minimum": 0
            },
            "patched": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "narrative": {
      "type": "string",
      "description": "Plain-language summary signed by named reviewers."
    },
    "signoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actor",
          "role",
          "signedAt"
        ],
        "properties": {
          "actor": {
            "$ref": "_shared.json#/$defs/actorRef"
          },
          "role": {
            "type": "string",
            "enum": [
              "operator",
              "alignment-reviewer",
              "external-auditor",
              "board-observer"
            ]
          },
          "signedAt": {
            "$ref": "_shared.json#/$defs/isoTimestamp"
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "internal",
            "partner",
            "public"
          ]
        },
        "permalink": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
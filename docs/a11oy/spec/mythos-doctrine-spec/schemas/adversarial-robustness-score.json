{
  "__doctrine-scanner-exempt": "legacy live-product surface; rename tracked as separate engineering debt \u2014 see scripts/check-doctrine-v6.mjs header",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a11oy.io/spec/mythos-doctrine/0.1.0/schemas/adversarial-robustness-score.json",
  "title": "AdversarialRobustnessScore",
  "description": "Per-snapshot score (0-100, higher = more robust) per attack category. Modeled on the IBM ART numerical convention; categories drawn from MITRE ATLAS and OWASP LLM Top 10.",
  "type": "object",
  "allOf": [
    {
      "$ref": "_shared.json#/$defs/envelopeFields"
    }
  ],
  "required": [
    "kind",
    "snapshotRef",
    "categories",
    "battery"
  ],
  "properties": {
    "kind": {
      "const": "AdversarialRobustnessScore"
    },
    "snapshotRef": {
      "type": "string",
      "description": "SnapshotFingerprint id this score applies to."
    },
    "battery": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Battery suite (e.g. 'a11oy-art-v3')."
        },
        "version": {
          "$ref": "_shared.json#/$defs/semver"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "category",
          "score",
          "attempts",
          "blocked"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "prompt-injection",
              "jailbreak",
              "data-exfiltration",
              "tool-misuse",
              "indirect-injection",
              "model-theft",
              "output-spoofing",
              "supply-chain",
              "covert-channel",
              "evasion-of-moderation",
              "policy-bypass"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "blocked": {
            "type": "integer",
            "minimum": 0
          },
          "deltaVsPrevSnapshot": {
            "type": "number",
            "description": "Signed change vs. previous snapshot."
          }
        }
      }
    },
    "compositeScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
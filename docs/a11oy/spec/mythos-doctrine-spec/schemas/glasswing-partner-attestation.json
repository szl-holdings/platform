{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a11oy.io/spec/mythos-doctrine/0.1.0/schemas/glasswing-partner-attestation.json",
  "title": "GlasswingPartnerAttestation",
  "description": "Per-partner record covering the four-stage Cyber Verification Program: APPLY → VERIFY → VET → ONBOARD. Produces a revocable, dual-approval-gated attestation.",
  "type": "object",
  "allOf": [{ "$ref": "_shared.json#/$defs/envelopeFields" }],
  "required": ["kind", "partner", "stage", "scope", "verifications"],
  "properties": {
    "kind": { "const": "GlasswingPartnerAttestation" },
    "partner": {
      "type": "object",
      "required": ["legalName", "publicName"],
      "properties": {
        "legalName": { "type": "string" },
        "publicName": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" }
      }
    },
    "stage": {
      "type": "string",
      "enum": ["apply", "verify", "vet", "onboard", "active", "suspended", "revoked"],
      "description": "Lifecycle stage."
    },
    "scope": {
      "type": "object",
      "required": ["allowlistedAgents", "allowlistedActions"],
      "properties": {
        "allowlistedAgents": {
          "type": "array",
          "items": { "$ref": "_shared.json#/$defs/agentId" },
          "minItems": 1
        },
        "allowlistedActions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "deniedActions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check", "outcome", "evidenceHash", "checkedAt"],
        "properties": {
          "check": {
            "type": "string",
            "enum": ["identity", "legal-standing", "code-of-conduct", "responsible-disclosure", "data-handling", "soc2", "iso27001"]
          },
          "outcome": { "type": "string", "enum": ["pass", "conditional", "fail"] },
          "evidenceHash": { "$ref": "_shared.json#/$defs/sha256Hash" },
          "checkedBy": { "$ref": "_shared.json#/$defs/actorRef" },
          "checkedAt": { "$ref": "_shared.json#/$defs/isoTimestamp" }
        }
      }
    },
    "dualApproval": {
      "type": "array",
      "description": "Two distinct approver actors required to advance to 'onboard' or 'active'.",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["actor", "approvedAt"],
        "properties": {
          "actor": { "$ref": "_shared.json#/$defs/actorRef" },
          "approvedAt": { "$ref": "_shared.json#/$defs/isoTimestamp" }
        }
      }
    },
    "revocation": {
      "type": "object",
      "properties": {
        "revokedAt": { "$ref": "_shared.json#/$defs/isoTimestamp" },
        "revokedBy": { "$ref": "_shared.json#/$defs/actorRef" },
        "reason": { "type": "string" }
      }
    }
  }
}

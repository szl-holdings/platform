<?xml version="1.0" encoding="utf-8"?>
<!--
  SZL Holdings — nuget.config template for GitHub Packages
  
  Place this in the root of your .NET solution or package directory.
  
  Authentication: GitHub Packages requires a PAT or GITHUB_TOKEN.
  - For CI: credentials are passed via environment variables (see workflow template)
  - For local dev:
      dotnet nuget add source https://nuget.pkg.github.com/szl-holdings/index.json \
        --name "github" \
        --username YOUR_GITHUB_USERNAME \
        --password YOUR_GITHUB_TOKEN \
        --store-password-in-clear-text
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/szl-holdings/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="SzlHoldings.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  SZL Holdings — Maven settings.xml template for GitHub Packages authentication
  
  Place this file at ~/.m2/settings.xml or pass with -s settings.xml
  Replace GITHUB_TOKEN with your PAT that has read:packages and write:packages scopes.
  
  For CI: use ${{ secrets.GITHUB_TOKEN }} (automatically provided by Actions).
  For local dev: use a PAT from https://github.com/settings/tokens
                 with scopes: read:packages, write:packages
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>github</id>
      <repositories>
        <repository>
          <id>github</id>
          <url>https://maven.pkg.github.com/szl-holdings/szl-holdings-platform</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>github</activeProfile>
  </activeProfiles>

</settings>

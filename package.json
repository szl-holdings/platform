{
  "name": "workspace",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm -r --if-present run dev",
    "lint": "eslint .",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm run test:api && pnpm run test:components",
    "test:api": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed": "pnpm --filter @workspace/scripts run seed",
    "seed:all": "bash scripts/seed-demo-canonical.sh",
    "seed:demo": "bash scripts/seed-demo-canonical.sh",
    "seed:atlas": "pnpm --filter @workspace/scripts run seed:atlas",
    "seed:atlas:aegis": "pnpm --filter @workspace/scripts run seed:atlas:aegis",
    "seed:atlas:vessels": "pnpm --filter @workspace/scripts run seed:atlas:vessels",
    "seed:atlas:terra": "pnpm --filter @workspace/scripts run seed:atlas:terra",
    "seed:atlas:counsel": "pnpm --filter @workspace/scripts run seed:atlas:counsel",
    "migrate": "pnpm --filter @szl-holdings/db run push-force",
    "start": "pnpm -r --if-present run dev",
    "capture:screens": "bash scripts/media/capture-screenshots.sh",
    "qa:routes": "node scripts/qa/smoke-routes.js",
    "qa:links": "node scripts/qa/check-links.js",
    "qa:a11y": "node scripts/qa/check-a11y.js",
    "qa:trust": "node scripts/qa/check-trust.js",
    "qa:demo": "node scripts/qa/check-demo-seed.js",
    "qa:atlas": "node scripts/qa/check-atlas.js",
    "qa:meta": "node scripts/qa/check-metadata.js",
    "qa:site": "pnpm qa:routes && pnpm qa:links && pnpm qa:trust && pnpm qa:meta",
    "docs:sync-check": "node scripts/docs/check-docs-sync.js",
    "test:atlas": "vitest run --config vitest.config.ts --reporter=verbose lib/scene-export",
    "release:prep": "echo 'Release prep: run pnpm build && pnpm test && pnpm qa:site, then update CHANGELOG.md'",
    "release:notes": "echo 'Generate release notes from CHANGELOG.md for the latest version'",
    "audit:mocks": "node --experimental-vm-modules scripts/qa/audit-mocks.js",
    "audit:routes": "node --experimental-vm-modules scripts/qa/audit-routes.js",
    "audit:copy": "node --experimental-vm-modules scripts/qa/audit-copy.js",
    "audit:deps": "node --experimental-vm-modules scripts/qa/audit-deps.js",
    "audit:design-system": "node --experimental-vm-modules scripts/qa/audit-design-system.js",
    "audit:broken-links": "node --experimental-vm-modules scripts/qa/audit-broken-links.js",
    "audit:all": "pnpm audit:mocks && pnpm audit:routes && pnpm audit:copy && pnpm audit:deps && pnpm audit:design-system && pnpm audit:broken-links",
    "health:check": "node --experimental-vm-modules scripts/qa/health-check.js",
    "qa:verify": "node scripts/qa/post-merge-verify.js",
    "qa:verify:skip-e2e": "node scripts/qa/post-merge-verify.js --skip-e2e",
    "security:audit": "node scripts/qa/generate-sbom.js",
    "security:audit:fix": "pnpm update --latest",
    "security:sbom": "node scripts/qa/generate-sbom.js",
    "smoke:product-mode": "node scripts/qa/smoke-product-mode.js",
    "readiness:gate": "pnpm run typecheck && pnpm run test && pnpm run qa:routes && pnpm run audit:mocks && pnpm run audit:deps && pnpm run audit:copy && pnpm run smoke:product-mode && pnpm -r --if-present run build",
    "audit:series-a": "pnpm run typecheck && pnpm run test && pnpm run audit:mocks && pnpm run audit:routes && pnpm run audit:deps && pnpm run audit:copy && pnpm run security:audit && pnpm run smoke:product-mode && pnpm -r --if-present run build",
    "readme:check": "node scripts/validate-readme-assets.js",
    "readme:generate": "node scripts/generate-readme-product-table.js",
    "readme:generate:check": "node scripts/generate-readme-product-table.js --check"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/react": "catalog:",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "eslint": "^9.0.0",
    "express": "^5.2.1",
    "happy-dom": "^20.8.9",
    "lru-cache": "^11.3.5",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "typescript": "~5.9.2",
    "vitest": "^4.1.2",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.3.0",
    "@types/nodemailer": "^7.0.11",
    "@udecode/plate-core": "^49.0.0",
    "archiver": "^7.0.1",
    "nodemailer": "^8.0.5",
    "puppeteer-core": "^24.41.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "slate": "^0.124.0",
    "slate-react": "^0.124.0",
    "yaml": "^2.8.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "react": "$react",
      "react-dom": "$react-dom",
      "path-to-regexp": "8.4.2",
      "brace-expansion": "2.1.0",
      "vite": "7.3.2",
      "lodash": "4.18.1",
      "micromatch>picomatch": "2.3.2",
      "tinyglobby>picomatch": "4.0.4",
      "@tootallnate/once": "3.0.1",
      "@esbuild-kit/core-utils>esbuild": "0.27.3"
    }
  }
}

    "audit:series-a": "pnpm run brand:check && pnpm run typecheck && pnpm run test && pnpm run qa:deprecated-links && pnpm run audit:mocks && pnpm run audit:routes && pnpm run audit:deps && pnpm run audit:copy && pnpm run security:audit && pnpm run smoke:product-mode && pnpm -r --if-present run build",
    "readme:check": "node scripts/validate-readme-assets.js",
    "readme:portfolio": "node scripts/generate-readme-product-table.js",
    "readme:portfolio:check": "node scripts/generate-readme-product-table.js --check",
    "docs:generate": "node --experimental-vm-modules scripts/docs/generate-api-catalogue.js",
    "docs:check": "node --experimental-vm-modules scripts/docs/generate-api-catalogue.js --check",
    "docs:sync-check": "node --experimental-vm-modules scripts/docs/check-docs-sync.js",
    "docs:claims-check": "node --experimental-vm-modules scripts/docs/check-docs-claims.js",
    "brand:check": "tsx scripts/brand-check.ts",
    "brand:check:verbose": "tsx scripts/brand-check.ts --verbose",
    "validate": "pnpm run brand:check && pnpm run typecheck && pnpm run test",
    "audit:full": "node --experimental-vm-modules scripts/audit-full.js",
    "audit:full:fast": "node --experimental-vm-modules scripts/audit-full.js --skip-install --skip-e2e",
    "audit:full:ci": "node --experimental-vm-modules scripts/audit-full.js --skip-install --skip-e2e",
    "check-boundaries": "tsx scripts/check-package-boundaries.ts",
    "lint:boundaries": "tsx scripts/check-package-boundaries.ts",
    "metrics:generate": "tsx scripts/generate-platform-metrics.ts",
    "metrics:validate": "tsx scripts/validate-platform-facts.ts",
    "metrics:check": "tsx scripts/validate-platform-facts.ts --strict",
    "surfaces:generate": "tsx tools/truth/generate-public-surfaces.ts",
    "surfaces:check": "tsx tools/truth/generate-public-surfaces.ts --check --verify-live",
    "surfaces:freshness": "tsx tools/truth/generate-public-surfaces.ts --check --verify-live --require-fresh-observation",
    "surfaces:test": "tsx --test tools/truth/public-surfaces.test.ts",
    "truth:generate": "tsx tools/truth/generate-truth.ts",
    "truth:validate": "tsx tools/truth/validate-truth.ts && pnpm truth:allowlists:check && pnpm truth:test",
    "truth:allowlists": "tsx tools/truth/generate-allowlist-justifications.ts",
    "truth:allowlists:check": "tsx tools/truth/generate-allowlist-justifications.ts --check",
    "truth:test": "tsx --test tools/truth/validate-truth.test.ts tools/truth/generate-truth.test.ts tools/truth/claims-drift.test.ts tools/truth/generate-allowlist-justifications.test.ts tools/truth/public-surfaces.test.ts",
    "truth:check": "pnpm surfaces:check && pnpm truth:generate -- --verify-local --verify-remote && pnpm truth:validate && pnpm claims:drift && git diff --exit-code -- artifacts/SOURCE_OF_TRUTH.json artifacts/PUBLIC_SURFACES.json",
    "claims:generate": "pnpm truth:generate",
    "claims:validate": "pnpm truth:validate",
    "claims:drift": "tsx tools/truth/claims-drift.ts",
    "design:check-hex": "tsx scripts/check-no-raw-hex.ts",
    "tokens:drift": "tsx scripts/check-design-tokens-drift.ts",
    "tokens:drift:check": "tsx scripts/check-design-tokens-drift.ts --check --threshold=50",
    "audit:source-of-truth": "node scripts/audit/validate-source-of-truth.js",
    "audit:hf-catalog": "node tools/hf-catalog/catalog.mjs --check",
    "audit:hf-catalog:live": "node tools/hf-catalog/catalog.mjs --probe-live",
    "conformance": "node packages/conformance/src/cli.mjs",
    "claims:drift:incremental": "node tools/truth/check-claims.ts",
    "claims:drift:full": "node tools/truth/check-claims.ts --all",
    "verticals:validate": "node ops/python/run-python.mjs services/verticals/vertical_moats.py --validate",
    "verticals:brief": "node ops/python/run-python.mjs services/verticals/vertical_moats.py --brief",
    "mcp:validate": "node ops/python/run-python.mjs ops/mcp/validate_mcp_registry.py",
    "meridian:forecast:baseline": "node ops/python/run-python.mjs services/meridian_forecast_lab/forecast_lab.py",
    "meridian:python:test": "node ops/python/run-python.mjs ops/meridian/run_tests.py",
    "meridian:check": "node ops/python/run-python.mjs ops/meridian/check.py",
    "screenshots:proof": "node scripts/assert-workflows-running.mjs && node scripts/capture-proof-screenshots.mjs",
    "validate:markdown-assets": "node scripts/validate-markdown-assets.mjs",
    "audit:mcp-registry": "node ops/audit/meridian-mcp-check.mjs",
    "dev:validate": "tsx scripts/dev-validate.ts",
    "eval-harness:run-standard": "pnpm --filter @workspace/eval-harness run eval-harness:run-standard",
    "eval-harness:reproduce": "pnpm --filter @workspace/eval-harness run eval-harness:reproduce"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },

{
  "name": "workspace",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "prepare": "sh scripts/setup-hooks.sh || true",
    "dev": "pnpm -r --if-present run dev",
    "lint": "biome lint .",
    "lint:ci": "oxlint . && biome lint --reporter=github .",
    "lint:copy": "bash scripts/lint-copy.sh",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "turbo run build",
    "codegen": "pnpm --filter @szl-holdings/api-spec run codegen",
    "typecheck:libs": "tsc --build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:legacy": "pnpm run test:api && pnpm run test:components && pnpm run test:proof-chain && pnpm run test:placeholder-empty-states",
    "test:proof-chain": "node scripts/check-proof-chain.js && vitest run --config vitest.config.ts scripts/check-proof-chain.test.js",
    "test:api": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed": "pnpm --filter @workspace/scripts run seed",
    "seed:all": "bash scripts/seed-demo-canonical.sh",
    "seed:demo": "bash scripts/seed-demo-canonical.sh",
    "seed:atlas": "pnpm --filter @workspace/scripts run seed:atlas",
    "seed:atlas:aegis": "pnpm --filter @workspace/scripts run seed:atlas:aegis",
    "seed:atlas:vessels": "pnpm --filter @workspace/scripts run seed:atlas:vessels",
    "seed:atlas:terra": "pnpm --filter @workspace/scripts run seed:atlas:terra",
    "seed:atlas:counsel": "pnpm --filter @workspace/scripts run seed:atlas:counsel",
    "seed:tenant-health": "pnpm --filter @workspace/scripts run seed:tenant-health",
    "migrate": "pnpm --filter @szl-holdings/db run push-non-interactive",
    "db:migrate": "pnpm --filter @szl-holdings/db run migrate",
    "start": "pnpm -r --if-present run dev",
    "capture:screens": "bash scripts/media/capture-screenshots.sh",
    "qa:routes": "node scripts/qa/smoke-routes.js",
    "qa:links": "node scripts/qa/check-links.js",
    "qa:deprecated-links": "node scripts/qa/check-deprecated-links.js",
    "qa:a11y": "node scripts/qa/check-a11y.js",
    "qa:trust": "node scripts/qa/check-trust.js",
    "qa:demo": "node scripts/qa/check-demo-seed.js",
    "qa:atlas": "node scripts/qa/check-atlas.js",
    "qa:meta": "node scripts/qa/check-metadata.js",
    "qa:empty-states": "bash scripts/check-generic-empty-states.sh",
    "qa:placeholder-empty-states": "node scripts/check-placeholder-empty-states.js",
    "test:placeholder-empty-states": "vitest run --config vitest.config.ts scripts/check-placeholder-empty-states.test.js",
    "qa:og": "sh -c 'if command -v python3 >/dev/null 2>&1 && python3 -c \"import PIL\" >/dev/null 2>&1; then python3 scripts/generate_og_cards.py --check; else echo \"qa:og skipped (python3 + Pillow not available)\"; fi'",
    "generate:og": "python3 scripts/generate_og_cards.py",
    "qa:site": "pnpm qa:routes && pnpm qa:links && pnpm qa:deprecated-links && pnpm qa:trust && pnpm qa:meta && pnpm qa:empty-states && pnpm qa:placeholder-empty-states && pnpm qa:og",
    "test:atlas": "vitest run --config vitest.config.ts --reporter=verbose lib/scene-export",
    "test:unit": "pnpm --filter ./artifacts/api-server test",
    "test:smoke": "node scripts/qa/smoke-routes.js && node scripts/qa/smoke-test-integrations.js",
    "db:reset:demo": "pnpm --filter @szl-holdings/db run migrate && pnpm seed:demo",
    "verify:env": "node scripts/qa/verify-env.js",
    "verify:env:strict": "node scripts/qa/verify-env.js --strict",
    "verify:claims": "node --experimental-vm-modules scripts/qa/verify-claims.js",
    "verify:claims:strict": "node --experimental-vm-modules scripts/qa/verify-claims.js --strict",
    "verify:routes": "node --experimental-vm-modules scripts/qa/audit-routes.js",
    "verify:health": "node --experimental-vm-modules scripts/qa/health-check.js",
    "release:check": "pnpm run verify:env && pnpm run verify:claims:strict && pnpm run test:unit && pnpm run test:smoke && pnpm run audit:mocks && pnpm run audit:routes && pnpm run audit:deps && pnpm run brand:check",
    "release:prep": "echo 'Release prep: run pnpm build && pnpm test && pnpm qa:site, then update CHANGELOG.md'",
    "release:notes": "echo 'Generate release notes from CHANGELOG.md for the latest version'",
    "audit:mocks": "node --experimental-vm-modules scripts/qa/audit-mocks.js",
    "audit:routes": "node --experimental-vm-modules scripts/qa/audit-routes.js",
    "audit:copy": "node --experimental-vm-modules scripts/qa/audit-copy.js",
    "audit:deps": "node --experimental-vm-modules scripts/qa/audit-deps.js",
    "audit:design-system": "node --experimental-vm-modules scripts/qa/audit-design-system.js",
    "audit:broken-links": "node --experimental-vm-modules scripts/qa/audit-broken-links.js",
    "audit:all": "pnpm audit:mocks && pnpm audit:routes && pnpm audit:copy && pnpm audit:deps && pnpm audit:design-system && pnpm audit:broken-links",
    "health:check": "node --experimental-vm-modules scripts/qa/health-check.js",
    "qa:verify": "node scripts/qa/post-merge-verify.js",
    "qa:verify:skip-e2e": "node scripts/qa/post-merge-verify.js --skip-e2e",
    "security:audit": "node scripts/qa/generate-sbom.js && node scripts/qa/generate-vuln-report.js && node scripts/qa/generate-license-report.js",
    "security:audit:fix": "pnpm update --latest",
    "security:sbom": "node scripts/qa/generate-sbom.js",
    "security:vuln": "node scripts/qa/generate-vuln-report.js",
    "security:license": "node scripts/qa/generate-license-report.js",
    "smoke:product-mode": "node scripts/qa/smoke-product-mode.js",
    "readiness:gate": "pnpm run brand:check && pnpm run typecheck && pnpm run test && pnpm run qa:routes && pnpm run audit:mocks && pnpm run audit:deps && pnpm run audit:copy && pnpm run smoke:product-mode && pnpm -r --if-present run build",
    "audit:series-a": "pnpm run brand:check && pnpm run typecheck && pnpm run test && pnpm run audit:mocks && pnpm run audit:routes && pnpm run audit:deps && pnpm run audit:copy && pnpm run security:audit && pnpm run smoke:product-mode && pnpm -r --if-present run build",
    "readme:check": "node scripts/validate-readme-assets.js",
    "readme:portfolio": "node scripts/generate-readme-product-table.js",
    "readme:portfolio:check": "node scripts/generate-readme-product-table.js --check",
    "docs:generate": "node --experimental-vm-modules scripts/docs/generate-api-catalogue.js",
    "docs:check": "node --experimental-vm-modules scripts/docs/generate-api-catalogue.js --check",
    "docs:sync-check": "node --experimental-vm-modules scripts/docs/check-docs-sync.js",
    "docs:claims-check": "node --experimental-vm-modules scripts/docs/check-docs-claims.js",
    "brand:check": "tsx scripts/brand-check.ts",
    "brand:check:verbose": "tsx scripts/brand-check.ts --verbose",
    "validate": "pnpm run brand:check && pnpm run typecheck && pnpm run test",
    "audit:full": "node --experimental-vm-modules scripts/audit-full.js",
    "audit:full:fast": "node --experimental-vm-modules scripts/audit-full.js --skip-install --skip-e2e",
    "audit:full:ci": "node --experimental-vm-modules scripts/audit-full.js --skip-install --skip-e2e",
    "check-boundaries": "tsx scripts/check-package-boundaries.ts",
    "lint:boundaries": "tsx scripts/check-package-boundaries.ts",
    "metrics:generate": "tsx scripts/generate-platform-metrics.ts",
    "metrics:validate": "tsx scripts/validate-platform-facts.ts",
    "metrics:check": "tsx scripts/validate-platform-facts.ts --strict",
    "design:check-hex": "tsx scripts/check-no-raw-hex.ts",
    "audit:source-of-truth": "node scripts/audit/validate-source-of-truth.js"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/react": "catalog:",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "happy-dom": "^20.8.9",
    "lru-cache": "^11.3.5",
    "oxlint": "^1.60.0",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "~5.9.2",
    "vitest": "^4.1.2",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.40.0",
    "@replit/connectors-sdk": "^0.3.0",
    "@types/nodemailer": "^7.0.11",
    "@udecode/plate-core": "^49.0.0",
    "archiver": "^7.0.1",
    "nodemailer": "^8.0.5",
    "posthog-js": "^1.369.1",
    "puppeteer-core": "^24.41.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "slate": "^0.124.0",
    "slate-react": "^0.124.0",
    "yaml": "^2.8.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "react": "$react",
      "react-dom": "$react-dom",
      "path-to-regexp": "8.4.2",
      "brace-expansion": "2.1.0",
      "vite": "7.3.2",
      "lodash": "4.18.1",
      "micromatch>picomatch": "2.3.2",
      "tinyglobby>picomatch": "4.0.4",
      "@tootallnate/once": "3.0.1",
      "@esbuild-kit/core-utils>esbuild": "0.27.3",
      "protobufjs": "^7.5.5",
      "protocol-buffers-schema": "^3.6.1"
    }
  }
}

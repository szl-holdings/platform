    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/react": "catalog:",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",

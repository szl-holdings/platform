  "dependencies": {
    "@amplitude/analytics-browser": "^2.40.0",
    "@openai/agents": "^0.0.15",
    "@replit/connectors-sdk": "^0.3.0",
    "@types/nodemailer": "^7.0.11",
    "@udecode/plate-core": "^49.0.0",
    "archiver": "^7.0.1",
    "docx": "^9.6.1",
    "nodemailer": "^9.0.1",
    "posthog-js": "^1.369.1",
    "puppeteer-core": "^24.41.0",
    "react": "catalog:",

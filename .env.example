# ─────────────────────────────────────────────────────────────────────────────
# SZL Holdings Monorepo — Environment Variables
# Copy this file to .env and fill in your values.
# Services without configured keys will run in mock/demo mode automatically.
# Never commit your actual .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────
#
# DEMO MODE (minimum required):
#   DATABASE_URL=<your-postgresql-url>
#   SESSION_SECRET=<run: openssl rand -hex 32>
# Then: pnpm install && pnpm seed && pnpm start
# See DEMO.md for credentials and walkthrough.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node / Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Runtime Mode ──────────────────────────────────────────────────────────────
# Explicit runtime mode override. Resolved automatically if not set.
# Valid values: local-dev | internal-preview | demo | production
# Resolution order (if not set):
#   DEMO_MODE=true / ENABLE_DEMO_SEED=true → demo
#   APP_ENV=demo → demo
#   APP_ENV=production / NODE_ENV=production → production
#   APP_ENV=staging or APP_ENV=internal-preview → internal-preview
#   Default → local-dev
# See lib/config/src/runtime-mode.ts and docs/operations/runtime-modes.md
# RUNTIME_MODE is the highest-priority override. Leave unset in production — the resolver
# derives the correct mode from NODE_ENV/APP_ENV automatically.
# Only set explicitly for local development or demo preview environments:
#   RUNTIME_MODE=local-dev        # explicit local override
#   RUNTIME_MODE=internal-preview # for internal staging/review environments
#   RUNTIME_MODE=demo             # for customer-facing demo environments
# Do NOT set RUNTIME_MODE=production explicitly — use NODE_ENV=production instead.
# RUNTIME_MODE=local-dev
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, or self-hosted)
DATABASE_URL=postgresql://user:password@localhost:5432/szlholdings

# Database pool tuning (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
SLOW_QUERY_THRESHOLD_MS=500

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# OpenID Connect issuer for authentication (e.g. Auth0, Clerk, Replit Auth)
ISSUER_URL=https://your-auth-provider.com

# OAuth state signing secret — generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=replace-with-a-long-random-string

# ── Email Provider ────────────────────────────────────────────────────────────
# Override email provider selection: resend | sendgrid | smtp
# If unset, fallback chain: resend → sendgrid → smtp → silent drop
EMAIL_PROVIDER=resend

# ── Email — Resend (primary) ──────────────────────────────────────────────────
# Resend API key: https://resend.com
RESEND_API_KEY=REPLACE_ME_RESEND_API_KEY

# Internal team email for admin notifications
SZL_INTERNAL_EMAIL=team@szlholdings.com

# Per-app admin notification targets (optional)
STEPHEN_ADMIN_EMAIL=contact@stephenl.dev
CARLOTA_ADMIN_EMAIL=admin@carlotajo.com

# ── Email — SendGrid (alternative) ─────────────────────────────────────────
SENDGRID_API_KEY=REPLACE_ME_SENDGRID_API_KEY

# ── Email — SMTP Fallback (optional) ─────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@szlholdings.com

# ── Stripe ────────────────────────────────────────────────────────────────────
# Stripe API keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=REPLACE_ME_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REPLACE_ME_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_ME_STRIPE_WEBHOOK_SECRET

# Stripe Price IDs — per-product (create in Stripe Dashboard)
STRIPE_PRICE_STRATEGY_SESSION=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ADVISORY_RETAINER=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PORTFOLIO_REVIEW=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_TERRA_STARTER=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_TERRA_PRO=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_FIRESTORM_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_LYTE_STARTER=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_LYTE_PRO=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_VESSELS_FLEET=price_xxxxxxxxxxxxxxxxxxxxxx

# ── AI Integrations ───────────────────────────────────────────────────────────
# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
AI_INTEGRATIONS_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
AI_INTEGRATIONS_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
AI_INTEGRATIONS_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── WebSocket ─────────────────────────────────────────────────────────────────
# Internal token for server-to-server auth (WS ticket issuance, self-monitor)
ALLOY_INTERNAL_TOKEN=replace-with-a-long-random-string

# ── Analytics — Plausible ─────────────────────────────────────────────────────
# Vite apps read: import.meta.env.VITE_PLAUSIBLE_DOMAIN
VITE_PLAUSIBLE_DOMAIN=szlholdings.com

# ── App URLs (used in email links, CORS, etc.) ─────────────────────────────────
VITE_APP_URL=https://szlholdings.com
CORS_ORIGINS=https://szlholdings.com,https://admin.szlholdings.com

# ── Third-Party APIs ──────────────────────────────────────────────────────────
# Mapbox (Terra property maps, Vessels fleet map)
MAPBOX_ACCESS_TOKEN=REPLACE_ME_MAPBOX_ACCESS_TOKEN

# Maritime AIS (Vessels)
# When set, the AIS feed adapter (lib/intelligence-feeds/src/adapters/ais.ts)
# polls https://services.marinetraffic.com/api for live vessel positions.
# Without it, the adapter falls back to AISHub's free public feed
# (set AISHUB_USERNAME below to your registered handle, or leave it blank
# to send "anonymous" — both work, but registered users get higher quotas).
# The Vessels app's AIS Live Tracking page (/vessels/ais-live-tracking) also
# uses Digitraffic + BarentsWatch via /api/vessels/live/ais/combined which
# do not require any credentials.
MARINE_TRAFFIC_API_KEY=

# Weather
WEATHER_API_KEY=

# ── Notifications — Slack / Teams ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=REPLACE_ME_SLACK_WEBHOOK_URL
SLACK_BOT_TOKEN=REPLACE_ME_SLACK_BOT_TOKEN
SLACK_ALERT_CHANNEL=alerts
MICROSOFT_TEAMS_WEBHOOK_URL=REPLACE_ME_TEAMS_WEBHOOK_URL

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# ── Google APIs ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_PROJECT_ID=

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_API_KEY=REPLACE_ME_NOTION_API_KEY

# ── Sentry Error Reporting ────────────────────────────────────────────────────
# Server-side (API server): captures uncaught exceptions and Express errors
SENTRY_DSN=REPLACE_ME_SENTRY_DSN
# Optional: override per-env sample rates (defaults: traces=0.1, profiles=0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Frontend: each Vite app reads this at build time
VITE_SENTRY_DSN=REPLACE_ME_VITE_SENTRY_DSN

# ── Cloud Storage ─────────────────────────────────────────────────────────────
# S3-compatible (AWS, Cloudflare R2, etc.)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=szl-holdings-files
STORAGE_ENDPOINT=https://s3.amazonaws.com

# ── Azure (optional — for enterprise multi-tenant deployments) ────────────────
AZURE_APP_INSIGHTS_CONNECTION_STRING=InstrumentationKey=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_KEY_VAULT_URL=https://szl-keyvault.vault.azure.net/
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=xxxx;AccountKey=xxxx
AZURE_REDIS_CONNECTION_STRING=szl-cache.redis.cache.windows.net:6380,password=xxxx,ssl=True
AZURE_PG_CONNECTION_STRING=postgresql://user:password@szl-db.postgres.database.azure.com:5432/szlholdings

# ── Salesforce AppExchange (optional) ─────────────────────────────────────────
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ── Atlassian Connect (optional — Jira integration) ──────────────────────────
ATLASSIAN_APP_KEY=com.szlholdings.alloy-connect

# ── Connector Credential Encryption ──────────────────────────────────────────
# AES-256 key for encrypting stored OAuth tokens and connector credentials
CONNECTOR_ENCRYPTION_KEY=replace-with-random-32-char-base64-string

# ── Public App URL ────────────────────────────────────────────────────────────
# Canonical public URL — used in OG tags, emails, canonical links
PUBLIC_APP_URL=https://szlholdings.com

# ── Alloy Workflow Configuration ──────────────────────────────────────────────
ALLOY_MAX_BATCH_SIZE=100
ALLOY_WORKFLOW_AUTO_RUN=false
ALLOY_REQUIRE_APPROVAL_CRITICAL=true
ALLOY_EMAIL_INGEST_SECRET=replace-with-random-string
ALLOY_DIGEST_SLACK_CHANNEL=#alloy-digest

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_ALLOY_GOVERNANCE=true
FEATURE_ALLOY_ORCHESTRATION=true
FEATURE_ALLOY_WEBHOOKS=true
FEATURE_AUDIT_LOGGING=true

# ── Intelligence Feed Toggles ─────────────────────────────────────────────────
AIS_FEED_ENABLED=false
AIS_API_KEY=
AIS_BASE_URL=
AISHUB_USERNAME=
LEGAL_FEED_ENABLED=false
LEGAL_FEED_SEARCH_QUERIES=
COURT_LISTENER_API_KEY=
COURTLISTENER_API_TOKEN=
SANCTIONS_FEED_ENABLED=false
STIX_FEED_ENABLED=false
SODA_APP_TOKEN=

# ── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@szlholdings.com

# ── Expo Push Notifications ───────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Mobile (Expo / CORTEX) ───────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://your-app.replit.app/api
EXPO_PUBLIC_API_BASE_URL=https://your-app.replit.app
EXPO_PUBLIC_ISSUER_URL=https://your-app.replit.app
EXPO_PUBLIC_DOMAIN=your-app.replit.app

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=
HUGGINGFACE_API_KEY=

# ── Agent Federation ──────────────────────────────────────────────────────────
# Comma-separated bearer tokens for agent-to-agent federation
FEDERATION_API_TOKENS=

# ── Security / Encryption ─────────────────────────────────────────────────────
# Optional field-level encryption key for PII columns
FIELD_ENCRYPTION_KEY=
# General encryption key (falls back to SESSION_SECRET)
SECRET_ENCRYPTION_KEY=

# ── Observability (additional) ────────────────────────────────────────────────
OTEL_SERVICE_NAME=szl-holdings-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Session ───────────────────────────────────────────────────────────────────
# Session TTL override (default 7 days per env-config.ts)
SESSION_TTL_MS=604800000

# ── Storage ───────────────────────────────────────────────────────────────────
PRIVATE_OBJECT_DIR=.private-objects
PUBLIC_OBJECT_SEARCH_PATHS=public/
DEFAULT_ORG_STORAGE_QUOTA_BYTES=10737418240
BACKUP_DIR=./backups

# ── Redis (optional — session store, rate limiting, pub/sub) ──────────────────
REDIS_URL=redis://localhost:6379

# ── Clerk Authentication (Replit-managed Clerk, if used) ─────────────────────
CLERK_SECRET_KEY=REPLACE_ME_CLERK_SECRET_KEY

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── GitHub Token (CI / GitHub integration) ────────────────────────────────────
GITHUB_TOKEN=REPLACE_ME_GITHUB_TOKEN

# ── HubSpot CRM ───────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=

# ── Jira Integration ──────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=

# ── AI — OpenRouter ───────────────────────────────────────────────────────────
# Replit proxy is preferred; only set if bypassing proxy
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── AI — Google Gemini (standalone) ──────────────────────────────────────────
# AI_INTEGRATIONS_GEMINI_API_KEY above is preferred; this is a direct key alias
GEMINI_API_KEY=

# ── AI — NVIDIA NIM ───────────────────────────────────────────────────────────
NIM_API_KEY=
NIM_API_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Azure — Active Directory / Entra ID ───────────────────────────────────────
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# ── Azure — Document Intelligence ────────────────────────────────────────────
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# ── Microsoft — Dataverse / Power Platform ────────────────────────────────────
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
DATAVERSE_ORG_URL=https://your-org.crm.dynamics.com

# ── Microsoft — Dynamics 365 ─────────────────────────────────────────────────
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_ORG_URL=https://your-org.dynamics.com

# ── Microsoft — SharePoint ────────────────────────────────────────────────────
SHAREPOINT_TENANT_ID=
SHAREPOINT_TENANT_URL=https://your-org.sharepoint.com
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# ── Microsoft — Power Automate ────────────────────────────────────────────────
POWER_AUTOMATE_WEBHOOK_SECRET=

# ── DocuSign (e-signature) ────────────────────────────────────────────────────
DOCUSIGN_CLIENT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://na4.docusign.net
DOCUSIGN_AUTH_URL=https://account.docusign.com
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_CONNECT_HMAC_KEY=

# ── Platform / Runtime (read-only / injected by Replit) ───────────────────────
# These are typically set automatically by the platform; do not set manually
# in production unless you are overriding the injected values.
REPL_ID=
REPLIT_DEV_DOMAIN=
EMBED_API_SERVER=
EXPO_PUBLIC_REPL_ID=

# ── App Runtime Introspection (injected at build/deploy time) ─────────────────
# Do not set manually; these are stamped by CI/CD and the build system.
BUILD_VERSION=0.0.0-dev
BUILD_TIMESTAMP=
COMMIT_SHA=
CI=false

# ── App URL Overrides (internal routing) ──────────────────────────────────────
# BASE_URL and API_BASE_URL are typically derived from PUBLIC_APP_URL and PORT.
# Only set if you need to override the derived value explicitly.
BASE_URL=
API_BASE_URL=
BASE_PATH=/

# ── Atlas Schema Version ──────────────────────────────────────────────────────
# Atlas schema version pin (used for migration locking in CI)
ATLAS_SCHEMA_VERSION=

# ── Supabase (if used as alternative to direct Postgres) ─────────────────────
# SERVICE_ROLE_KEY is the Supabase service-role key (bypasses RLS)
SERVICE_ROLE_KEY=

# ── Admin / Support ───────────────────────────────────────────────────────────
# Numeric PIN required for some admin API endpoints
ADMIN_PIN=

# ── Integration Tests ─────────────────────────────────────────────────────────
# Token used by the live integration test suite as the ALLOY_INTERNAL_TOKEN value.
# Set to any random string; must match what the test server is configured to accept.
INTEGRATION_TEST_TOKEN=replace-with-a-random-test-token

# ── Debug / Test Flags (development only) ────────────────────────────────────
# Set to "true" to block requests until consciousness preflight passes
CONSCIOUSNESS_PREFLIGHT_BLOCKING=false
# Generate synthetic alerts for testing alerting pipelines
SYNTHETIC_ALERTS=false
# Skip slow initialization steps in dev
__FAST_START_SERVER=false
# Internal Inngest job queue port (defaults to 8288)
INNGEST_PORT=8288
# Max OS threads for Go native addons
GOMAXPROCS=

# ── Alloy Embedding Fabric (AEF) ──────────────────────────────────────────────
# Bearer token for external callers to alloy-fabric-api. Change in production.
AEF_API_KEY=dev-insecure-key

# Service-to-service bearer token (ingest-control → vector-worker → rank-worker).
AEF_S2S_SECRET=dev-s2s-secret

# Primary API port (alloy-fabric-api)
AEF_API_PORT=4200

# Ingestion control service port (alloy-fabric-ingest-control)
AEF_INGEST_CONTROL_PORT=4201

# Vector embedding worker port (alloy-vector-worker)
AEF_VECTOR_WORKER_PORT=4202

# Cross-encoder reranking worker port (alloy-rank-worker)
AEF_RANK_WORKER_PORT=4203

# Embedding backend: "local-cpu" (default) | "external-http" | "future-gpu" | "future-azure"
AEF_EMBED_BACKEND=local-cpu

# Required when AEF_EMBED_BACKEND=external-http
AEF_EMBED_ENDPOINT=
AEF_EMBED_API_KEY=

# Reranking mode: "cross-encoder" (default) | "fallback-inversion"
AEF_RANK_MODE=cross-encoder

# Micro-batch tuning
AEF_EMBED_BATCH_SIZE=32
AEF_EMBED_FLUSH_MS=20
AEF_EMBED_QUEUE_DEPTH=512
AEF_EMBED_OVERSIZE_TOKENS=2048

# Rate limit per tenant (requests per minute)
AEF_RATE_LIMIT_RPM=60

# Storage adapter: "in-memory" (default) | "local-fs" | "sqlite" | "pgvector" | "azure"
AEF_STORAGE_ADAPTER=in-memory

# Required when AEF_STORAGE_ADAPTER=pgvector
AEF_PG_CONNECTION_STRING=

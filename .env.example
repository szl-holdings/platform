# =============================================================================
# SZL Holdings — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Services without configured keys will run in mock/demo mode automatically.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/szl_holdings

# --- AI (OpenAI / Anthropic) ---
# At least one is needed for live AI chat completions
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Weather ---
# OpenWeatherMap API key for current conditions and forecasts
WEATHER_API_KEY=

# --- Shipping / Maritime ---
# MarineTraffic API key for vessel tracking
MARINE_TRAFFIC_API_KEY=

# --- Stripe Payments ---
# Stripe secret key (use sk_test_... for testing)
STRIPE_SECRET_KEY=sk_test_...

# --- Slack Notifications ---
# Incoming webhook URL for posting messages
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# Optional: Bot token for richer API interactions
SLACK_BOT_TOKEN=xoxb-...

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# --- Google APIs ---
# OAuth client credentials (required for Sheets, Calendar, Drive, etc.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: service account JSON key (alternative to OAuth)
GOOGLE_SERVICE_ACCOUNT_KEY=
# Optional: GCP project ID
GOOGLE_PROJECT_ID=

# --- Notion ---
# Internal integration token
NOTION_API_KEY=secret_...

# --- Cloud Storage (S3-compatible) ---
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=szl-holdings-files
# Optional: custom endpoint for non-AWS S3-compatible services
STORAGE_ENDPOINT=https://s3.amazonaws.com

# --- Monitoring / Error Reporting ---
# Sentry DSN for error tracking
SENTRY_DSN=https://key@sentry.io/project-id

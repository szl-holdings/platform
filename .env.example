# =============================================================================
# SZL Holdings DreamStack — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Services without configured keys will run in mock/demo mode automatically.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/szl_holdings

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth / Sessions ---
SESSION_SECRET=your-session-secret-here

# --- AI (OpenAI / Anthropic) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Weather ---
WEATHER_API_KEY=

# --- Shipping / Maritime ---
MARINE_TRAFFIC_API_KEY=

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_test_...

# --- Slack Notifications ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_BOT_TOKEN=xoxb-...

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# --- Google APIs ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_PROJECT_ID=

# --- Notion ---
NOTION_API_KEY=secret_...

# --- Cloud Storage (S3-compatible) ---
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=szl-holdings-files
STORAGE_ENDPOINT=https://s3.amazonaws.com

# --- Monitoring / Error Reporting ---
SENTRY_DSN=https://key@sentry.io/project-id

# --- Email (SMTP for notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@szlholdings.com

# ─────────────────────────────────────────────────────────────────────────────
# SZL Holdings Monorepo — Environment Variables
# Copy this file to .env and fill in your values.
# Services without configured keys will run in mock/demo mode automatically.
# Never commit your actual .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────
#
# CLASSIFICATION KEY (used in section headers below):
#   [required-local]  — Must be set for any local dev run
#   [required-prod]   — Must be set in production (Replit Secrets); missing = service failure
#   [optional]        — Service degrades gracefully to mock/demo mode if absent
#   [demo-fallback]   — Has a safe hard-coded demo value; override for real data
#
# DEMO MODE (minimum required):
#   DATABASE_URL=<your-postgresql-url>
#   SESSION_SECRET=<run: openssl rand -hex 32>
# Then: pnpm install && pnpm seed && pnpm start
# See DEMO.md for credentials and walkthrough.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node / Server [required-local] ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Runtime Mode [optional] ───────────────────────────────────────────────────
# Explicit runtime mode override. Resolved automatically if not set.
# Valid values: local-dev | internal-preview | demo | production
# Resolution order (if not set):
#   DEMO_MODE=true / ENABLE_DEMO_SEED=true → demo
#   APP_ENV=demo → demo
#   APP_ENV=production / NODE_ENV=production → production
#   APP_ENV=staging or APP_ENV=internal-preview → internal-preview
#   Default → local-dev
# See lib/config/src/runtime-mode.ts and docs/operations/runtime-modes.md
# RUNTIME_MODE is the highest-priority override. Leave unset in production — the resolver
# derives the correct mode from NODE_ENV/APP_ENV automatically.
# Only set explicitly for local development or demo preview environments:
#   RUNTIME_MODE=local-dev        # explicit local override
#   RUNTIME_MODE=internal-preview # for internal staging/review environments
#   RUNTIME_MODE=demo             # for customer-facing demo environments
# Do NOT set RUNTIME_MODE=production explicitly — use NODE_ENV=production instead.
# RUNTIME_MODE=local-dev
APP_ENV=development

# ── Database [required-local] [required-prod] ─────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, or self-hosted)
DATABASE_URL=postgresql://user:password@localhost:5432/szlholdings

# Database pool tuning [optional]
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
SLOW_QUERY_THRESHOLD_MS=500

# ── Authentication [required-local] [required-prod] ───────────────────────────
# Secret used to sign session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Salt for IP address hashing in audit/session records — generate with: openssl rand -hex 32
# Required in production: without this, SHA-256 hashes are precomputable over the IPv4/v6 space.
# Rotation: updating this salt makes future hashes un-correlatable with historical ones.
# See ENVIRONMENT_VARIABLES.md for full rotation implications.
IP_HASH_SALT=replace-with-a-long-random-string

# OpenID Connect issuer for authentication (e.g. Auth0, Clerk, Replit Auth)
ISSUER_URL=https://your-auth-provider.com

# OAuth state signing secret — generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=replace-with-a-long-random-string

# ── Email Provider [optional] — falls back to silent drop if unconfigured ─────
# Override email provider selection: resend | sendgrid | smtp
# If unset, fallback chain: resend → sendgrid → smtp → silent drop
EMAIL_PROVIDER=resend

# ── Email — Resend (primary) ──────────────────────────────────────────────────
# Resend API key: https://resend.com
RESEND_API_KEY=REPLACE_ME_RESEND_API_KEY

# Internal team email for admin notifications
SZL_INTERNAL_EMAIL=team@szlholdings.com

# Per-app admin notification targets (optional)
STEPHEN_ADMIN_EMAIL=contact@stephenl.dev
CARLOTA_ADMIN_EMAIL=admin@carlotajo.com

# ── Email — SendGrid (alternative) ─────────────────────────────────────────
SENDGRID_API_KEY=REPLACE_ME_SENDGRID_API_KEY

# ── Email — SMTP Fallback (optional) ─────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@szlholdings.com

# ── Stripe [optional] — required-prod when billing is active ─────────────────
# Stripe API keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=REPLACE_ME_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REPLACE_ME_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_ME_STRIPE_WEBHOOK_SECRET

# Stripe Price IDs — per-product (create in Stripe Dashboard)
STRIPE_PRICE_STRATEGY_SESSION=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ADVISORY_RETAINER=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PORTFOLIO_REVIEW=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_TERRA_STARTER=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_TERRA_PRO=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_FIRESTORM_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_LYTE_STARTER=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_LYTE_PRO=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_VESSELS_FLEET=price_xxxxxxxxxxxxxxxxxxxxxx

# ── AI Integrations [optional] — falls back to mock responses if absent ───────
# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
AI_INTEGRATIONS_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
AI_INTEGRATIONS_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
AI_INTEGRATIONS_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── A11oy Atelier [optional; fails closed when both adapters are absent] ──────
# Server-side direct xAI Responses API adapter. Never expose this value through
# a VITE_ variable or commit a real credential.
A11OY_ATELIER_XAI_API_KEY=
# Local-development adapter only: absolute path to a signed Grok Build CLI.
# Do not configure this path in deployed containers.
A11OY_ATELIER_GROK_CLI_PATH=
A11OY_ATELIER_MODEL=grok-4.6
# CLI transport configuration. The browser uses the same-origin /api route.
A11OY_ATELIER_API_BASE_URL=http://127.0.0.1:8080
A11OY_ATELIER_TENANT_ID=default
# Non-secret browser tenant selector; production identity remains authoritative.
VITE_A11OY_ATELIER_TENANT_ID=default

# ── WebSocket [required-prod] ─────────────────────────────────────────────────
# Internal token for server-to-server auth (WS ticket issuance, self-monitor).
# Validated by envSchema as ALLOY_INTERNAL_TOKEN (min 32 chars).
ALLOY_INTERNAL_TOKEN=replace-with-a-long-random-string-min-32-chars

# ── Analytics — Plausible [optional] ─────────────────────────────────────────
# Vite apps read: import.meta.env.VITE_PLAUSIBLE_DOMAIN
VITE_PLAUSIBLE_DOMAIN=szlholdings.com

# ── App URLs [required-prod] ──────────────────────────────────────────────────
VITE_APP_URL=https://szlholdings.com
CORS_ORIGINS=https://szlholdings.com,https://admin.szlholdings.com

# ── Third-Party APIs [optional] ───────────────────────────────────────────────
# Mapbox (Terra property maps, Vessels fleet map)
MAPBOX_ACCESS_TOKEN=REPLACE_ME_MAPBOX_ACCESS_TOKEN

# Maritime AIS (Vessels)
# When set, the AIS feed adapter (lib/intelligence-feeds/src/adapters/ais.ts)
# polls https://services.marinetraffic.com/api for live vessel positions.
# Without it, the adapter falls back to AISHub's free public feed
# (set AISHUB_USERNAME below to your registered handle, or leave it blank
# to send "anonymous" — both work, but registered users get higher quotas).
# The Vessels app's AIS Live Tracking page (/vessels/ais-live-tracking) also
# uses Digitraffic + BarentsWatch via /api/vessels/live/ais/combined which
# do not require any credentials.
MARINE_TRAFFIC_API_KEY=

# Weather
WEATHER_API_KEY=

# ── Notifications — Slack / Teams ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=REPLACE_ME_SLACK_WEBHOOK_URL
SLACK_BOT_TOKEN=REPLACE_ME_SLACK_BOT_TOKEN
SLACK_ALERT_CHANNEL=alerts
MICROSOFT_TEAMS_WEBHOOK_URL=REPLACE_ME_TEAMS_WEBHOOK_URL

# ── Twilio SMS ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# ── Google APIs ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_PROJECT_ID=

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_API_KEY=REPLACE_ME_NOTION_API_KEY

# ── Sentry Error Reporting ────────────────────────────────────────────────────
# Server-side (API server): captures uncaught exceptions and Express errors
SENTRY_DSN=REPLACE_ME_SENTRY_DSN
# Optional: override per-env sample rates (defaults: traces=0.1, profiles=0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Frontend: each Vite app reads this at build time
VITE_SENTRY_DSN=REPLACE_ME_VITE_SENTRY_DSN

# ── Cloud Storage [optional] — required-prod for file upload features ─────────
# S3-compatible (AWS, Cloudflare R2, etc.)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=szl-holdings-files
STORAGE_ENDPOINT=https://s3.amazonaws.com

# ── Azure [optional] — enterprise multi-tenant integrations only ─────────────
AZURE_APP_INSIGHTS_CONNECTION_STRING=InstrumentationKey=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_KEY_VAULT_URL=https://szl-keyvault.vault.azure.net/
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=xxxx;AccountKey=xxxx
AZURE_REDIS_CONNECTION_STRING=szl-cache.redis.cache.windows.net:6380,password=xxxx,ssl=True
AZURE_PG_CONNECTION_STRING=postgresql://user:password@szl-db.postgres.database.azure.com:5432/szlholdings

# ── Salesforce AppExchange [optional] ─────────────────────────────────────────
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ── Atlassian Connect (optional — Jira integration) ──────────────────────────
ATLASSIAN_APP_KEY=com.szlholdings.continuum-connect

# ── Connector Credential Encryption [required-prod] ──────────────────────────
# AES-256 key for encrypting stored OAuth tokens and connector credentials
CONNECTOR_ENCRYPTION_KEY=replace-with-random-32-char-base64-string

# ── Public App URL [required-prod] ───────────────────────────────────────────
# Canonical public URL — used in OG tags, emails, canonical links
PUBLIC_APP_URL=https://szlholdings.com

# ── Alloy Workflow Configuration [optional] [demo-fallback] ──────────────────
# These are the schema-validated names. The former CONTINUUM_* names were a
# legacy product alias and are no longer read by any code (see
# docs/ENVIRONMENT_MATRIX.md, section C).
ALLOY_MAX_BATCH_SIZE=100
ALLOY_WORKFLOW_AUTO_RUN=false
ALLOY_REQUIRE_APPROVAL_CRITICAL=true
ALLOY_EMAIL_INGEST_SECRET=replace-with-random-string
ALLOY_DIGEST_SLACK_CHANNEL=#alloy-digest

# ── Feature Flags [optional] [demo-fallback] ─────────────────────────────────
FEATURE_ALLOY_GOVERNANCE=true
FEATURE_ALLOY_ORCHESTRATION=true
FEATURE_ALLOY_WEBHOOKS=true
FEATURE_AUDIT_LOGGING=true

# ── Intelligence Feed Toggles [optional] ─────────────────────────────────────
AIS_FEED_ENABLED=false
AIS_API_KEY=
AIS_BASE_URL=
AISHUB_USERNAME=
LEGAL_FEED_ENABLED=false
LEGAL_FEED_SEARCH_QUERIES=
COURT_LISTENER_API_KEY=
COURTLISTENER_API_TOKEN=
SANCTIONS_FEED_ENABLED=false
STIX_FEED_ENABLED=false
SODA_APP_TOKEN=

# ── Web Push Notifications (VAPID) [optional] ────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@szlholdings.com

# ── Expo Push Notifications [optional] ───────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Mobile (Expo / CORTEX) [optional] — required-prod for mobile app ─────────
EXPO_PUBLIC_API_URL=https://your-app.replit.app/api
EXPO_PUBLIC_API_BASE_URL=https://your-app.replit.app
EXPO_PUBLIC_ISSUER_URL=https://your-app.replit.app
EXPO_PUBLIC_DOMAIN=your-app.replit.app

# ── HuggingFace [optional] ────────────────────────────────────────────────────
HF_TOKEN=
HUGGINGFACE_API_KEY=

# ── Agent Federation [optional] ───────────────────────────────────────────────
# Comma-separated bearer tokens for agent-to-agent federation
FEDERATION_API_TOKENS=

# ── Security / Encryption [optional] — required-prod for PII field encryption ─
# SSRF guard for outbound webhook delivery (KG020b). Comma-separated host
# allowlist; an entry like .hooks.example.com also matches subdomains. When set,
# any host not on the list is refused. When unset, delivery still blocks
# private/loopback/link-local/cloud-metadata IP ranges.
WEBHOOK_HOST_ALLOWLIST=
# Optional field-level encryption key for PII columns
FIELD_ENCRYPTION_KEY=
# General encryption key (falls back to SESSION_SECRET)
SECRET_ENCRYPTION_KEY=

# ── Observability (additional) [optional] ────────────────────────────────────
OTEL_SERVICE_NAME=szl-holdings-api
# OTLP collector base URL; /v1/traces is appended automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value export headers. Carries backend auth at deploy time
# so the same build can target Grafana Cloud or Azure Monitor:
#   Grafana Cloud: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instanceID:token>
#   Azure Monitor (via OTLP collector): OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<ingestion-key>
OTEL_EXPORTER_OTLP_HEADERS=
# Comma-separated key=value resource attributes merged onto every span,
# e.g. service.namespace=alloy,cloud.region=eastus2
OTEL_RESOURCE_ATTRIBUTES=

# ── Session [optional] [demo-fallback] ───────────────────────────────────────
# Session TTL override (default 7 days per env-config.ts)
SESSION_TTL_MS=604800000

# ── Storage [optional] [demo-fallback] ───────────────────────────────────────
PRIVATE_OBJECT_DIR=.private-objects
PUBLIC_OBJECT_SEARCH_PATHS=public/
DEFAULT_ORG_STORAGE_QUOTA_BYTES=10737418240
BACKUP_DIR=./backups

# ── Backup → Object Storage (durable archival) [optional] ────────────────────
# Backend: none | local-fs | azure-blob (default: none = artifact-only)
BACKUP_REMOTE_BACKEND=none
BACKUP_REMOTE_DAILY_RETENTION_DAYS=30
BACKUP_REMOTE_WEEKLY_RETENTION_DAYS=90
# local-fs (testing only): path that simulates the remote store
BACKUP_REMOTE_LOCAL_DIR=
# azure-blob: set AZURE_STORAGE_CONNECTION_STRING (defined above) OR account + SAS token
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_SAS_TOKEN=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=

# ── Redis [optional] — session store, rate limiting, pub/sub ─────────────────
REDIS_URL=redis://localhost:6379

# ── Clerk Authentication [optional] — alternative auth provider ──────────────
CLERK_SECRET_KEY=REPLACE_ME_CLERK_SECRET_KEY

# ── Google Maps [optional] ────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── GitHub Token [optional] — CI and GitHub integration features ──────────────
GITHUB_TOKEN=REPLACE_ME_GITHUB_TOKEN

# ── HubSpot CRM [optional] ────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=

# ── Jira Integration [optional] ───────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=

# ── AI — OpenRouter [optional] ────────────────────────────────────────────────
# Replit proxy is preferred; only set if bypassing proxy
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── AI — Google Gemini (standalone) [optional] ───────────────────────────────
# AI_INTEGRATIONS_GEMINI_API_KEY above is preferred; this is a direct key alias
GEMINI_API_KEY=

# ── AI — NVIDIA NIM [optional] ────────────────────────────────────────────────
NIM_API_KEY=
NIM_API_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Azure — Active Directory / Entra ID [optional] ───────────────────────────
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# ── Azure — Document Intelligence [optional] ─────────────────────────────────
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# ── Microsoft — Dataverse / Power Platform [optional] ────────────────────────
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
DATAVERSE_ORG_URL=https://your-org.crm.dynamics.com

# ── Microsoft — Dynamics 365 [optional] ──────────────────────────────────────
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_ORG_URL=https://your-org.dynamics.com

# ── Microsoft — SharePoint [optional] ────────────────────────────────────────
SHAREPOINT_TENANT_ID=
SHAREPOINT_TENANT_URL=https://your-org.sharepoint.com
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# ── Microsoft — Power Automate [optional] ─────────────────────────────────────
POWER_AUTOMATE_WEBHOOK_SECRET=

# ── DocuSign (e-signature) [optional] ────────────────────────────────────────
DOCUSIGN_CLIENT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://na4.docusign.net
DOCUSIGN_AUTH_URL=https://account.docusign.com
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_CONNECT_HMAC_KEY=

# ── Platform / Runtime [demo-fallback] — injected by Replit; do not set manually
# These are typically set automatically by the platform; do not set manually
# in production unless you are overriding the injected values.
REPL_ID=
REPLIT_DEV_DOMAIN=
EMBED_API_SERVER=
EXPO_PUBLIC_REPL_ID=

# ── App Runtime Introspection [demo-fallback] — stamped by CI/CD at build time ─
# Do not set manually; these are stamped by CI/CD and the build system.
BUILD_VERSION=0.0.0-dev
BUILD_TIMESTAMP=
COMMIT_SHA=
CI=false

# ── App URL Overrides (internal routing) [optional] ──────────────────────────
# BASE_URL and API_BASE_URL are typically derived from PUBLIC_APP_URL and PORT.
# Only set if you need to override the derived value explicitly.
BASE_URL=
API_BASE_URL=
BASE_PATH=/

# ── Atlas Schema Version [optional] — CI migration locking ───────────────────
# Atlas schema version pin (used for migration locking in CI)
ATLAS_SCHEMA_VERSION=

# ── Supabase [optional] — alternative to direct Postgres ─────────────────────
# SERVICE_ROLE_KEY is the Supabase service-role key (bypasses RLS)
SERVICE_ROLE_KEY=

# ── Admin / Bootstrap [optional] — set before first prod deploy; see BOOTSTRAP_ADMIN.md
# Used by scripts/seed-bootstrap-admin.ts to provision the first admin account.
# Set these in Replit Secrets before running the bootstrap seed.
# See docs/BOOTSTRAP_ADMIN.md for details.
BOOTSTRAP_ADMIN_USERNAME=replace-with-admin-display-name
BOOTSTRAP_ADMIN_EMAIL=replace-with-admin-email@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ── Admin / Support [required-prod] — numeric PIN for admin API endpoints ─────
# Numeric PIN required for some admin API endpoints
ADMIN_PIN=

# ── Integration Tests [optional] — CI use only; not needed for local dev ──────
# Token used by the live integration test suite as the ALLOY_INTERNAL_TOKEN value.
# Set to any random string; must match what the test server is configured to accept.
INTEGRATION_TEST_TOKEN=replace-with-a-random-test-token

# ── Debug / Test Flags [optional] — development only; do not set in prod ──────
# Set to "true" to block requests until consciousness preflight passes
CONSCIOUSNESS_PREFLIGHT_BLOCKING=false
# Generate synthetic alerts for testing alerting pipelines
SYNTHETIC_ALERTS=false
# Skip slow initialization steps in dev
__FAST_START_SERVER=false
# Internal Inngest job queue port (defaults to 8288)
INNGEST_PORT=8288
# Max OS threads for Go native addons
GOMAXPROCS=

# ── Continuum Fabric (CF) [optional] [demo-fallback] ──────────────────
# Public gateway URL — the CF API service endpoint.
# In Replit Reserved VM deployments this will be your Repl's permanent domain.
# In local dev, point to http://localhost:4200
CF_GATEWAY_URL=http://localhost:4200

# Bearer token for external callers to alloy-fabric-api. Change in production.
CF_API_KEY=dev-insecure-key

# Tenant identifier. Set to your organisation slug. Default: szl-holdings
CF_TENANT_ID=szl-holdings

# Browser-side equivalents (consumed by Vite consumer apps via import.meta.env):
# SECURITY: VITE_CF_API_KEY is visible to end users in browser bundles.
# Ensure this token is scoped to low-privilege read-only operations on the CF
# gateway. Do NOT reuse the same key for privileged server-side operations.
# In production, consider a separate read-only key or a server-side proxy route
# that calls CF on behalf of the browser, keeping the privileged key server-side.
VITE_CF_GATEWAY_URL=http://localhost:4200
VITE_CF_API_KEY=dev-insecure-key-read-only
VITE_CF_TENANT_ID=szl-holdings

# Service-to-service bearer token (ingest-control → vector-worker → rank-worker).
AEF_S2S_SECRET=dev-s2s-secret

# Primary API port (alloy-fabric-api)
AEF_API_PORT=4200

# Ingestion control service port (alloy-fabric-ingest-control)
AEF_INGEST_CONTROL_PORT=4201

# Vector embedding worker port (alloy-vector-worker)
AEF_VECTOR_WORKER_PORT=4202

# Cross-encoder reranking worker port (alloy-rank-worker)
AEF_RANK_WORKER_PORT=4203

# Embedding backend: "local-cpu" (default) | "external-http" | "future-gpu" | "future-azure"
AEF_EMBED_BACKEND=local-cpu

# Required when AEF_EMBED_BACKEND=external-http
AEF_EMBED_ENDPOINT=
AEF_EMBED_API_KEY=

# Reranking mode: "cross-encoder" (default) | "fallback-inversion"
AEF_RANK_MODE=cross-encoder

# Micro-batch tuning
AEF_EMBED_BATCH_SIZE=32
AEF_EMBED_FLUSH_MS=20
AEF_EMBED_QUEUE_DEPTH=512
AEF_EMBED_OVERSIZE_TOKENS=2048

# Rate limit per tenant (requests per minute)
AEF_RATE_LIMIT_RPM=60

# Storage adapter: "in-memory" (default) | "local-fs" | "sqlite" | "pgvector" | "azure"
AEF_STORAGE_ADAPTER=in-memory

# Required when AEF_STORAGE_ADAPTER=pgvector
AEF_PG_CONNECTION_STRING=

# ── Alloy Model Router [optional] — provider keys for live inference ──────────
# Without any keys, the model router falls back to demo/simulation mode.
# OPENAI_API_KEY (above) is shared with the model router automatically.

# DeepSeek — strategy lane (DeepSeek-R1, DeepSeek-V4-Pro) and fast-ops lane
DEEPSEEK_API_KEY=sk-...

# Zhipu AI — strategy lane fallback (GLM-5.1) and vision lane (GLM-OCR)
ZHIPU_API_KEY=...

# Moonshot — strategy lane fallback (Kimi-K2.6)
MOONSHOT_API_KEY=...

# Alibaba DashScope — fast-ops lane (Qwen3.5-9B) and coding lane (Qwen3-Coder-Next)
DASHSCOPE_API_KEY=sk-...

# Google AI — fast-ops lane fallback (Gemma-4) and vision lane fallback (Gemma-4-31B)
GOOGLE_AI_API_KEY=AIza...

# FAL.AI — creative lane (FLUX.1, FLUX.2)
FAL_KEY=...

# Baidu AI — creative lane fallback (ERNIE-Image)
BAIDU_API_KEY=...

# External MCP server keys — enables read/write access to external tools.
# All write operations still require human approval regardless of key presence.
# [optional]
SENTRY_MCP_TOKEN=
LINEAR_API_KEY=
POSTHOG_API_KEY=
AMPLITUDE_API_KEY=
PAGERDUTY_API_KEY=
NOTION_TOKEN=

# ── Precision Evolution Runtime (PER) [optional] ──────────────────────────────
# Controls the evolution/rollout pipeline. Defaults are safe for all environments.
# Evolution execution mode: "simulation" (default, safe) | "live"
EVOLUTION_MODE=simulation

# Calibration execution mode: "simulation" | "local" | "remote"
CALIBRATION_MODE=simulation

# Promotion gate mode: "simulation" | "manual_review" | "auto"
PROMOTION_MODE=manual_review

# Drift guard — if "true", rollouts blocked when drift exceeds threshold
DRIFT_GUARD=true

# ── Operational Audit Harness [optional] ──────────────────────────────────────
# Used by ops/audit/smoke.mjs, ops/audit/url-audit.mjs, ops/audit/stress.mjs
# Run: pnpm audit:smoke | pnpm audit:crawl | pnpm audit:stress | pnpm audit:operational

# Base URL to audit (default: http://localhost:3000)
TARGET_URL=http://localhost:3000

# Text that must appear in every response body (leave empty to skip)
EXPECTED_TEXT=

# Maximum pages to crawl during URL audit
MAX_PAGES=50

# Total HTTP requests to send during stress test
STRESS_REQUESTS=50

# Concurrent requests per batch during stress test
STRESS_CONCURRENCY=5

# p95 latency threshold in milliseconds — test fails if exceeded
MAX_P95_MS=3000

# Directory where audit JSON reports are written (relative to workspace root)
REPORT_DIR=ops/reports

# ─────────────────────────────────────────────────────────────────────────────
# Schema-validated variables previously missing from this template [optional]
# ─────────────────────────────────────────────────────────────────────────────
# The following keys are validated by envSchema (packages/env/src/index.ts) but
# were absent from this file. Listed here (commented) so operators can discover
# them. See docs/ENVIRONMENT_MATRIX.md for full type/default details.

# Database — per-checkout hold-time warning (ms). Default 10000.
# DB_CHECKOUT_WARN_THRESHOLD_MS=10000

# Demo seed toggle. Default false.
# ENABLE_DEMO_SEED=false

# Hugging Face inference base URL.
# HF_API_BASE=

# Observability — alternate OTLP endpoint alias + local exporter toggles.
# OTLP_ENDPOINT=
# OTEL_IN_MEMORY=false
# OTEL_CONSOLE_EXPORT=false
# NEW_RELIC_LICENSE_KEY=

# Intelligence feeds — additional providers validated by the schema.
# MARINETRAFFIC_API_KEY=
# MISP_URL=
# OTX_API_KEY=
# TAXII_SERVER_URL=
# TAXII_COLLECTION=
# TAXII_API_KEY=

# Salesforce — token + instance URL (alongside the OAuth client pair above).
# SALESFORCE_ACCESS_TOKEN=
# SALESFORCE_INSTANCE_URL=

# Supabase service role key.
# SERVICE_ROLE_KEY_SUPABASE=

# Internal service-to-service base + token (used by cross-artifact calls).
# SZL_API_BASE=
# SZL_INTERNAL_TOKEN=

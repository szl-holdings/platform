{
  "name": "@workspace/nexus-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "NEXUS MCP SDK — official @modelcontextprotocol/sdk foundation wrapped with SZL governance: Guardian policy evaluation, proof chain audit, tenant isolation, approval gates, and the full 2025 spec innovation layer (Sampling, Elicitation, Tasks, Apps, Instructions, Discovery, Roots).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./src/server.ts"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./src/capabilities/index.ts"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./src/transport.ts"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc --build",
    "test": "tsx --test src/server-policy.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}

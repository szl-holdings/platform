{
  "name": "@workspace/memory-fabric",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "description": "Memory Fabric — 10-type cognitive memory for working, session, episodic, semantic, workflow, entity, artifact, operator-feedback, executive, and skill scopes. Provenance, freshness, confidence, retention enforcement, episodic summarization, lesson distillation, and tier-based sensitivity redaction.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./src/store.ts"
    },
    "./postgres-store": {
      "types": "./dist/postgres-store.d.ts",
      "import": "./src/postgres-store.ts"
    },
    "./retention": {
      "types": "./dist/retention.d.ts",
      "import": "./src/retention.ts"
    },
    "./behaviors": {
      "types": "./dist/behaviors.d.ts",
      "import": "./src/behaviors.ts"
    }
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

{
  "name": "@szl-holdings/szl-receipts",
  "version": "0.1.0",
  "description": "Λ-receipt chain — SHA-256 linked LambdaReceipt[] with Merkle root + audit-closure receipts. Shared between @szl-holdings/sdk and @workspace/aef-sdk.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepare": "NODE_OPTIONS=--max-old-space-size=8192 tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

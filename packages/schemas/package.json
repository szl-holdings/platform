{
  "name": "@szl-holdings/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domain schemas reused by API routes, DB-adjacent parsing, queue payloads, and LLM structured outputs.",
  "exports": {
    ".": "./src/index.ts",
    "./entities": "./src/entities.ts",
    "./alloy": "./src/alloy.ts",
    "./vessels": "./src/vessels.ts",
    "./terra": "./src/terra.ts",
    "./firestorm": "./src/firestorm.ts",
    "./ai": "./src/ai.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@workspace/aef-storage-adapters",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Alloy Embedding Fabric — unified storage adapter interface with working local-filesystem, SQLite, and pgvector implementations, plus interface stubs for Azure AI Search and object storage.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./interfaces": {
      "types": "./dist/interfaces.d.ts",
      "import": "./src/interfaces.ts"
    },
    "./local-fs": {
      "types": "./dist/local-fs.d.ts",
      "import": "./src/local-fs.ts"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./src/sqlite.ts"
    },
    "./pgvector": {
      "types": "./dist/pgvector.d.ts",
      "import": "./src/pgvector.ts"
    },
    "./stubs": {
      "types": "./dist/stubs.d.ts",
      "import": "./src/stubs.ts"
    }
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

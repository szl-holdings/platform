{
  "name": "@workspace/drift-eval",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Drift-Eval — drift detection and champion-vs-challenger evaluation jobs that read from and persist to the eval registry, with scheduled execution.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./src/registry.ts"
    },
    "./drift": {
      "types": "./dist/drift.d.ts",
      "import": "./src/drift.ts"
    },
    "./champion-challenger": {
      "types": "./dist/champion-challenger.d.ts",
      "import": "./src/champion-challenger.ts"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "import": "./src/scheduler.ts"
    }
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  }
}

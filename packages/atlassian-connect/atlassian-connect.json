{
  "name": "SZL Platform Connector for Jira",
  "description": "Connect Jira Cloud to the SZL Holdings intelligence platform. Sprint health signals, blocked-issue alerts, SLA breach detection, and bi-directional issue sync powered by the Alloy execution engine.",
  "key": "com.szlholdings.jira-connector",
  "baseUrl": "https://api.szlholdings.com/api/atlassian",
  "vendor": {
    "name": "SZL Holdings",
    "url": "https://szlholdings.com"
  },
  "version": "1.0.0",
  "apiVersion": 1,
  "authentication": {
    "type": "jwt"
  },
  "lifecycle": {
    "installed": "/lifecycle/installed",
    "uninstalled": "/lifecycle/uninstalled",
    "enabled": "/lifecycle/enabled",
    "disabled": "/lifecycle/disabled"
  },
  "scopes": [
    "READ",
    "WRITE"
  ],
  "modules": {
    "postInstallPage": {
      "url": "/setup?jwt={jwt}",
      "name": {
        "value": "Connect to SZL Platform"
      },
      "key": "szl-post-install-page"
    },
    "adminPages": [
      {
        "url": "/admin/config?jwt={jwt}",
        "name": {
          "value": "SZL Platform Settings"
        },
        "key": "szl-admin-config",
        "location": "admin_plugins_menu/szl_section"
      }
    ],
    "jiraIssueGlances": [
      {
        "key": "szl-issue-glance",
        "name": {
          "value": "SZL Intelligence"
        },
        "icon": {
          "url": "/static/icon-16.png",
          "url@2x": "/static/icon-32.png"
        },
        "content": {
          "type": "label",
          "label": {
            "value": "View in SZL"
          }
        },
        "target": {
          "type": "web_panel",
          "url": "/issue-panel?issueKey={issue.key}&jwt={jwt}"
        }
      }
    ],
    "webPanels": [
      {
        "key": "szl-issue-panel",
        "name": {
          "value": "SZL Platform Intelligence"
        },
        "url": "/issue-panel?issueKey={issue.key}&jwt={jwt}",
        "location": "atl.jira.view.issue.right.context",
        "weight": 200,
        "conditions": [
          {
            "condition": "user_is_logged_in"
          }
        ]
      }
    ],
    "webhooks": [
      {
        "event": "jira:issue_created",
        "url": "/webhooks/issue-created"
      },
      {
        "event": "jira:issue_updated",
        "url": "/webhooks/issue-updated"
      },
      {
        "event": "jira:issue_deleted",
        "url": "/webhooks/issue-deleted"
      },
      {
        "event": "sprint_started",
        "url": "/webhooks/sprint-started"
      },
      {
        "event": "sprint_closed",
        "url": "/webhooks/sprint-closed"
      },
      {
        "event": "jira:worklog_updated",
        "url": "/webhooks/worklog-updated"
      }
    ]
  }
}

{
  "name": "@workspace/anomaly-fabric",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Anomaly Fabric — unified streaming and batch anomaly detection service with a single shared contract used across all platform lanes.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./src/service.ts"
    },
    "./streaming": {
      "types": "./dist/streaming.d.ts",
      "import": "./src/streaming.ts"
    },
    "./batch": {
      "types": "./dist/batch.d.ts",
      "import": "./src/batch.ts"
    },
    "./peak-detector": {
      "types": "./dist/peak-detector.d.ts",
      "import": "./src/peak-detector.ts"
    }
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}

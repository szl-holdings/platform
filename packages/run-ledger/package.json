{
  "name": "@workspace/run-ledger",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Governed Run Ledger — assembles per-run audit artifacts from cognitive-runtime lifecycle events and evaluates quality gates.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "import": "./src/ledger.ts"
    },
    "./quality-gate": {
      "types": "./dist/quality-gate.d.ts",
      "import": "./src/quality-gate.ts"
    }
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@szl-holdings/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}

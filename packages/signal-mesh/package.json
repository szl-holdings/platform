{
  "name": "@szl-holdings/signal-mesh",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "9-stage signal pipeline worker: intake → normalize → enrich → entity-resolve → correlate → score → recommend → policy-evaluate → telemetry-writeback",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./bus": {
      "types": "./dist/bus.d.ts",
      "import": "./src/bus.ts"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./src/pipeline.ts"
    },
    "./postgres-bus": {
      "types": "./dist/postgres-bus.d.ts",
      "import": "./src/postgres-bus.ts"
    }
  },
  "dependencies": {
    "@workspace/ontology": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

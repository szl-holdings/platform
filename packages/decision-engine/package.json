{
  "name": "@szl-holdings/decision-engine",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "SZL Decision Engine — signal ranking, business impact scoring, urgency/confidence weighting, and explainable recommendation output",
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "development": "./src/types.ts",
      "workspace": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./ranker": {
      "development": "./src/ranker.ts",
      "workspace": "./src/ranker.ts",
      "types": "./dist/ranker.d.ts",
      "import": "./dist/ranker.js"
    },
    "./scorer": {
      "development": "./src/scorer.ts",
      "workspace": "./src/scorer.ts",
      "types": "./dist/scorer.d.ts",
      "import": "./dist/scorer.js"
    }
  },
  "dependencies": {
    "@szl-holdings/atlas-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}

{
  "name": "@workspace/a11oy-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "description": "A11oy — autonomous workcell runtime. Wraps workcell-admission decisions through the Ouroboros loop spine with Λ-gate (from MirrorEval axes), Newton fluxions-receipt (tool-risk consistency), and Gauss class-number witness-diversity gate on the operator sequence.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./data": "./src/data/index.ts",
    "./verify": "./src/verify.ts",
    "./state-native": "./src/state-native/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests && tsc && node --test test/state-native-runtime.test.mjs test/state-native-runtime-timeout.test.mjs test/state-native-runtime-security.test.mjs test/state-native-state-bus-security.test.mjs test/state-native-boundary-security.test.mjs test/state-native-receipt-integrity.test.mjs test/state-native-runtime-boundary-regressions.test.mjs test/state-native-runtime-admission-regressions.test.mjs",
    "typecheck": "tsc --noEmit",
    "demo:state-native": "tsc && node dist/state-native/demo.js"
  },
  "dependencies": {
    "@workspace/ouroboros-loop": "workspace:*",
    "@workspace/ouroboros-invariant": "workspace:*",
    "@workspace/ouroboros-gauss": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/amaru-runtime": "workspace:*",
    "@workspace/sentra-runtime": "workspace:*",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@szl-holdings/evidence-graph",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Evidence graph store — evidence items linked to entities and signals, recommendations with evidence chains, and the 'why does the system believe X' query layer",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./src/store.ts"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./src/query.ts"
    }
  },
  "dependencies": {
    "@workspace/ontology": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}

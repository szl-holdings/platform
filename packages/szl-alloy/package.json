{
  "name": "@szl/alloy",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Unified Alloy runtime facade — ontology, evidence, policy, run sessions, memory, and confidence scoring behind one import for every SZL product.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./src/session.ts"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "import": "./src/evidence.ts"
    },
    "./confidence": {
      "types": "./dist/confidence.d.ts",
      "import": "./src/confidence.ts"
    },
    "./recommend": {
      "types": "./dist/recommend.d.ts",
      "import": "./src/recommend.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@szl-holdings/decision-engine": "workspace:*",
    "@szl-holdings/policy-engine": "workspace:*",
    "@workspace/forge": "workspace:*",
    "@workspace/memory-fabric": "workspace:*",
    "@workspace/trace-graph": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}

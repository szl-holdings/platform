{
  "name": "@workspace/aef-evidence-ledger",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Alloy Embedding Fabric — append-only evidence ledger recording request, chunk, source, scoring, and policy provenance for every retrieval operation. Ships an in-memory adapter and a JSONL filesystem adapter for development.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./src/store.ts"
    },
    "./fs-store": {
      "types": "./dist/fs-store.d.ts",
      "import": "./src/fs-store.ts"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./src/query.ts"
    }
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

{
  "name": "@szl-holdings/auth-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified auth primitives — types, guards, CSRF helpers, RBAC utilities, and tenant-scoping contracts shared across all platform artifacts.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./mobile": "./src/mobile/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@szl-holdings/env": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

{
  "name": "@workspace/demo-seed",
  "version": "0.1.0",
  "private": true,
  "description": "Demo data seed package for all four SZL Holdings demo narratives",
  "main": "src/index.ts",
  "scripts": {
    "seed:all": "tsx src/seed-runner.ts",
    "seed:business": "tsx src/seed-runner.ts business",
    "seed:security": "tsx src/seed-runner.ts security",
    "seed:maritime": "tsx src/seed-runner.ts maritime",
    "seed:legal": "tsx src/seed-runner.ts legal",
    "seed:mesh": "tsx src/seed-mesh-cli.ts",
    "seed:carlota-advisory": "tsx src/carlota-advisory-seed.ts",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@szl-holdings/connectors": "workspace:*",
    "@szl-holdings/constellation": "workspace:*",
    "@szl-holdings/db": "workspace:*",
    "@szl-holdings/env": "workspace:*",
    "@szl-holdings/evidence-graph": "workspace:*",
    "@szl-holdings/signal-mesh": "workspace:*",
    "@workspace/ontology": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "~6.0.3"
  }
}

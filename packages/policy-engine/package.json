{
  "name": "@szl-holdings/policy-engine",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "SZL Policy Engine — hierarchical policy evaluation, guardrail enforcement, and governance rule management",
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./evaluator": {
      "types": "./dist/evaluator.d.ts",
      "import": "./src/evaluator.ts"
    },
    "./guardrails": {
      "types": "./dist/guardrails.d.ts",
      "import": "./src/guardrails.ts"
    },
    "./modes": {
      "types": "./dist/modes.d.ts",
      "import": "./src/modes.ts"
    }
  },
  "dependencies": {
    "@szl-holdings/atlas-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.2"
  }
}

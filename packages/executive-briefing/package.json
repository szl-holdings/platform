{
  "name": "@workspace/executive-briefing",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Executive Briefing Engine — generates evidence-first, source-aware, confidence-calibrated executive briefs from world-model, memory, and reflections. Backed by the cognitive runtime and gated by the verifier.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./context-builder": {
      "types": "./dist/context-builder.d.ts",
      "import": "./src/context-builder.ts"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "import": "./src/prompts.ts"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./src/parser.ts"
    },
    "./verifier-gate": {
      "types": "./dist/verifier-gate.d.ts",
      "import": "./src/verifier-gate.ts"
    }
  },
  "dependencies": {
    "@workspace/verifier": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

{
  "name": "@workspace/forge",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Alloy OS — cognitive runtime and execution fabric. Run manager, checkpoint/replay hooks, model router interface, tool invocation through Tool Mesh, approval gate via Guardian, action ledger writer, for the SZL Agentic Cognitive Operating Intelligence Platform.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./run-manager": {
      "types": "./dist/run-manager.d.ts",
      "import": "./src/run-manager.ts"
    },
    "./checkpoint": {
      "types": "./dist/checkpoint.d.ts",
      "import": "./src/checkpoint.ts"
    },
    "./model-router": {
      "types": "./dist/model-router.d.ts",
      "import": "./src/model-router.ts"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "import": "./src/ledger.ts"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./src/workflow.ts"
    },
    "./plan-orchestrator": {
      "types": "./dist/plan-orchestrator.d.ts",
      "import": "./src/plan-orchestrator.ts"
    }
  },
  "dependencies": {
    "@szl-holdings/action-engine": "workspace:*",
    "@workspace/guardian": "workspace:*",
    "@workspace/planner": "workspace:*",
    "@workspace/tool-mesh": "workspace:*",
    "@workspace/trace-graph": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

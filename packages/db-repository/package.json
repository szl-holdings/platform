{
  "name": "@szl-holdings/db-repository",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed repository classes over @szl-holdings/db. Each repository encapsulates DB access for a single domain.",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./alloy": "./src/alloy.ts",
    "./audit": "./src/audit.ts",
    "./eval-registry": "./src/eval-registry.ts",
    "./vessels": "./src/vessels.ts",
    "./terra": "./src/terra.ts",
    "./firestorm": "./src/firestorm.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@szl-holdings/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

{
  "name": "@szl-holdings/db-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explicit table/relation definitions — the single source of truth for the Drizzle schema. Re-organizes lib/db schema by domain.",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/domains/auth.ts",
    "./alloy": "./src/domains/alloy.ts",
    "./audit": "./src/domains/audit.ts",
    "./vessels": "./src/domains/vessels.ts",
    "./terra": "./src/domains/terra.ts",
    "./firestorm": "./src/domains/firestorm.ts",
    "./ai": "./src/domains/ai.ts",
    "./platform": "./src/domains/platform.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@szl-holdings/db": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

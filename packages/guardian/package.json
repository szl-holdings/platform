{
  "name": "@workspace/guardian",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Guardian — unified policy engine and approval tiers. Eight policy tiers, deny-by-default decision engine, and rule schema for the SZL Agentic Cognitive Operating Intelligence Platform.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tiers": {
      "development": "./src/tiers.ts",
      "workspace": "./src/tiers.ts",
      "types": "./dist/tiers.d.ts",
      "import": "./dist/tiers.js"
    },
    "./schema": {
      "development": "./src/schema.ts",
      "workspace": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./decision-engine": {
      "development": "./src/decision-engine.ts",
      "workspace": "./src/decision-engine.ts",
      "types": "./dist/decision-engine.d.ts",
      "import": "./dist/decision-engine.js"
    },
    "./crypto": {
      "development": "./src/crypto.ts",
      "workspace": "./src/crypto.ts",
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./telemetry-buffer": {
      "development": "./src/telemetry-buffer.ts",
      "workspace": "./src/telemetry-buffer.ts",
      "types": "./dist/telemetry-buffer.d.ts",
      "import": "./dist/telemetry-buffer.js"
    },
    "./guardrail-prober": {
      "development": "./src/guardrail-prober.ts",
      "workspace": "./src/guardrail-prober.ts",
      "types": "./dist/guardrail-prober.d.ts",
      "import": "./dist/guardrail-prober.js"
    }
  },
  "dependencies": {
    "@szl-holdings/policy-engine": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

{
  "name": "@workspace/cognitive-observability",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Cognitive Observability — telemetry, quality, cost, drift, and value metrics. OpenTelemetry-compatible exporter with the full SZL metric set for the SZL Agentic Cognitive Operating Intelligence Platform.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metrics": {
      "development": "./src/metrics.ts",
      "workspace": "./src/metrics.ts",
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./exporter": {
      "development": "./src/exporter.ts",
      "workspace": "./src/exporter.ts",
      "types": "./dist/exporter.d.ts",
      "import": "./dist/exporter.js"
    },
    "./collector": {
      "development": "./src/collector.ts",
      "workspace": "./src/collector.ts",
      "types": "./dist/collector.d.ts",
      "import": "./dist/collector.js"
    }
  },
  "dependencies": {
    "@szl-holdings/observability-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --build"
  }
}

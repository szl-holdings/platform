{
  "name": "@szl-holdings/procedural-kit",
  "version": "0.1.0",
  "private": false,
  "description": "Procedural part-graph authoring (kitbash-style). Part library + composition DAG + deterministic seed→Scene generator + BOM. Consumed by openusd-export for round-trip USD authoring.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./part": { "types": "./src/part.ts", "import": "./src/part.ts" },
    "./composition": { "types": "./src/composition.ts", "import": "./src/composition.ts" },
    "./seed-generator": { "types": "./src/seed-generator.ts", "import": "./src/seed-generator.ts" },
    "./bom": { "types": "./src/bom.ts", "import": "./src/bom.ts" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@szl-holdings/payload",
  "version": "0.1.0",
  "description": "Canonical SZL Holdings machine-to-machine handoff payload. Wraps packages/payload/raw/ as a typed pnpm workspace package with SHA-256 integrity verification.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "files": [
    "src",
    "raw",
    "raw_v7",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "verify": "node scripts/verify-integrity.mjs",
    "verify:v7": "node scripts/verify-integrity-v7.mjs",
    "verify:all": "node scripts/verify-integrity.mjs && node scripts/verify-integrity-v7.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

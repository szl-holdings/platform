{
  "name": "@workspace/aef-workflow-runtime",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Alloy Embedding Fabric — deterministic, checkpointed workflow state machine. Defines actor roles (IngestionPlanner, SourceNormalizer, ChunkPlanner, PolicyGuard, VectorDispatch, IndexVerifier, RetrievalEvaluator, ApprovalGate), approval interrupt support, resumable execution across restarts, and audit event emission at each step.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./state-machine": {
      "types": "./dist/state-machine.d.ts",
      "import": "./src/state-machine.ts"
    },
    "./actors": {
      "types": "./dist/actors.d.ts",
      "import": "./src/actors.ts"
    },
    "./checkpoint": {
      "types": "./dist/checkpoint.d.ts",
      "import": "./src/checkpoint.ts"
    },
    "./approval": {
      "types": "./dist/approval.d.ts",
      "import": "./src/approval.ts"
    }
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "@workspace/alloy-vector-worker": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

{
  "name": "@szl-holdings/atlas-events",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "ATLAS standardized event taxonomy \u2014 business event class definitions, metadata contracts, and domain event routing",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy.d.ts",
      "import": "./src/taxonomy.ts"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./src/contracts.ts"
    }
  },
  "dependencies": {
    "@szl-holdings/atlas-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

{
  "name": "@szl-holdings/env",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod-validated environment variable loader. Throws at startup if required variables are missing or invalid.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

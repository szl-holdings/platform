{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true
  },
  "references": [
    { "path": "../action-engine" },
    { "path": "../approvals-inbox" },
    { "path": "../cognitive-observability" },
    { "path": "../guardian" },
    { "path": "../planner" },
    { "path": "../policy-engine" },
    { "path": "../trace-graph" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

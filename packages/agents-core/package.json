{
  "name": "@workspace/agents-core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Agents Core — typed, replayable, auditable agent orchestration. Run lifecycle (start/step/complete/fail), retry policy, approval gates wired to the approvals inbox, structured-log emission, and OTel span helpers.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "import": "./src/run.ts"
    },
    "./retry": {
      "types": "./dist/retry.d.ts",
      "import": "./src/retry.ts"
    },
    "./approval-gate": {
      "types": "./dist/approval-gate.d.ts",
      "import": "./src/approval-gate.ts"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./src/errors.ts"
    },
    "./dead-letter": {
      "types": "./dist/dead-letter.d.ts",
      "import": "./src/dead-letter.ts"
    },
    "./step-log": {
      "types": "./dist/step-log.d.ts",
      "import": "./src/step-log.ts"
    }
  },
  "dependencies": {
    "@workspace/guardian": "workspace:*",
    "@szl-holdings/policy-engine": "workspace:*",
    "@workspace/approvals-inbox": "workspace:*",
    "@szl-holdings/action-engine": "workspace:*",
    "@workspace/planner": "workspace:*",
    "@workspace/cognitive-observability": "workspace:*",
    "@workspace/trace-graph": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

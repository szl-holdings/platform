{
  "name": "@szl-holdings/document-intelligence",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Citation-preserving document intelligence pipeline — OCR, layout parsing, table extraction, chart extraction, and QA with provenance baked in. Ingestion entrypoints for contracts, filings, and memos across all lanes.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./src/adapters.ts"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./src/pipeline.ts"
    },
    "./ingestion": {
      "types": "./dist/ingestion.d.ts",
      "import": "./src/ingestion.ts"
    }
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}

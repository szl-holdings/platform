{
  "name": "@szl-holdings/platform-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for platform claims, feature flags, environment contract, and public-facing registry. All surfaces read from here — never from hardcoded strings.",
  "exports": {
    ".": "./src/index.ts",
    "./platform-registry": "./src/platform-registry.ts",
    "./public-claims": "./src/public-claims.ts",
    "./feature-flags": "./src/feature-flags.ts",
    "./env-contract": "./src/env-contract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "^5.4.5"
  }
}

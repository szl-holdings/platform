{
  "name": "@workspace/agents-tools",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Agents Tools — typed tool definitions with Zod input/output schemas and handler contracts. Wraps tool-mesh registry and gateway; rejects untyped tools at registration time.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./typed-tool": {
      "types": "./dist/typed-tool.d.ts",
      "import": "./src/typed-tool.ts"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./src/registry.ts"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./src/gateway.ts"
    },
    "./tools/security": {
      "types": "./dist/tools/security.d.ts",
      "import": "./src/tools/security.ts"
    },
    "./tools/finance": {
      "types": "./dist/tools/finance.d.ts",
      "import": "./src/tools/finance.ts"
    },
    "./tools/operations": {
      "types": "./dist/tools/operations.d.ts",
      "import": "./src/tools/operations.ts"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./src/bridge.ts"
    }
  },
  "dependencies": {
    "@workspace/tool-mesh": "workspace:*",
    "@workspace/guardian": "workspace:*",
    "@workspace/cognitive-observability": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

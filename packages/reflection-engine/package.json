{
  "name": "@workspace/reflection-engine",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Reflection Engine — structured self-improvement after every run. Scores quality, classifies failures, writes lessons, drafts candidate skills, and wires results into memory-fabric and skill-library without claiming awareness.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./src/store.ts"
    },
    "./scorer": {
      "types": "./dist/scorer.d.ts",
      "import": "./src/scorer.ts"
    },
    "./classifier": {
      "types": "./dist/classifier.d.ts",
      "import": "./src/classifier.ts"
    },
    "./lesson-writer": {
      "types": "./dist/lesson-writer.d.ts",
      "import": "./src/lesson-writer.ts"
    },
    "./skill-drafter": {
      "types": "./dist/skill-drafter.d.ts",
      "import": "./src/skill-drafter.ts"
    },
    "./candidate-skill-library": {
      "types": "./dist/candidate-skill-library.d.ts",
      "import": "./src/candidate-skill-library.ts"
    }
  },
  "dependencies": {
    "@workspace/memory-fabric": "workspace:*",
    "@workspace/trace-graph": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

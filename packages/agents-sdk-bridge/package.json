{
  "name": "@workspace/agents-sdk-bridge",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "OpenAI Agents SDK Bridge \u2014 wires the @openai/agents SDK tracing surface into SZL's Trace Graph, Cognitive Observability, Tool Mesh, Policy Engine, and SZL agent registry.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./tracing-processor": {
      "types": "./dist/tracing-processor.d.ts",
      "import": "./src/tracing-processor.ts"
    },
    "./metrics-bridge": {
      "types": "./dist/metrics-bridge.d.ts",
      "import": "./src/metrics-bridge.ts"
    },
    "./tool-adapter": {
      "types": "./dist/tool-adapter.d.ts",
      "import": "./src/tool-adapter.ts"
    },
    "./agent-adapter": {
      "types": "./dist/agent-adapter.d.ts",
      "import": "./src/agent-adapter.ts"
    },
    "./guardrail-adapter": {
      "types": "./dist/guardrail-adapter.d.ts",
      "import": "./src/guardrail-adapter.ts"
    },
    "./pii-filter": {
      "types": "./dist/pii-filter.d.ts",
      "import": "./src/pii-filter.ts"
    },
    "./sdk-runner": {
      "types": "./dist/sdk-runner.d.ts",
      "import": "./src/sdk-runner.ts"
    },
    "./behavioral-tracer-bridge": {
      "types": "./dist/behavioral-tracer-bridge.d.ts",
      "import": "./src/behavioral-tracer-bridge.ts"
    }
  },
  "dependencies": {
    "@openai/agents": "^0.0.15",
    "@workspace/cognitive-observability": "workspace:*",
    "@workspace/trace-graph": "workspace:*",
    "@workspace/tool-mesh": "workspace:*",
    "@workspace/agents-core": "workspace:*",
    "@szl-holdings/policy-engine": "workspace:*",
    "@szl-holdings/ai-control-plane": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

{
  "name": "@szl-holdings/sim-kit",
  "version": "0.1.0",
  "private": false,
  "description": "Minimal sim kernel — Verlet step, label+radius union-find cluster detect, particle-emitter contract, monotone-checked scoring. Dependency-free; runs in React, WebGPU, or video artefacts without dragging a game engine.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./verlet-step": { "types": "./src/verlet-step.ts", "import": "./src/verlet-step.ts" },
    "./cluster-detect": { "types": "./src/cluster-detect.ts", "import": "./src/cluster-detect.ts" },
    "./emitter-contract": { "types": "./src/emitter-contract.ts", "import": "./src/emitter-contract.ts" },
    "./scoring": { "types": "./src/scoring.ts", "import": "./src/scoring.ts" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

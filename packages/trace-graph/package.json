{
  "name": "@workspace/trace-graph",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Trace Graph — run/agent/tool trace capture and replay. Full-fidelity trace schema, writer API, persistence adapter, and deterministic replay for the SZL Agentic Cognitive Operating Intelligence Platform.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./src/schema.ts"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "import": "./src/writer.ts"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./src/store.ts"
    },
    "./postgres-store": {
      "types": "./dist/postgres-store.d.ts",
      "import": "./src/postgres-store.ts"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./src/replay.ts"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./src/queue.ts"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./src/query.ts"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./src/sdk.ts"
    }
  },
  "dependencies": {
    "@workspace/replay-core": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

{
  "name": "@workspace/trace-graph",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Trace Graph — run/agent/tool trace capture and replay. Full-fidelity trace schema, writer API, persistence adapter, and deterministic replay for the SZL Agentic Cognitive Operating Intelligence Platform.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./src/schema.ts"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "import": "./src/writer.ts"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./src/store.ts"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./src/replay.ts"
    }
  },
  "dependencies": {
    "@szl-holdings/replay-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.2"
  }
}

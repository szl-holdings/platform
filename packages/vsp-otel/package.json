{
  "name": "@szl-holdings/vsp-otel",
  "version": "0.1.0",
  "description": "Verifiable Span Protocol (VSP) — OTel bridge MVP. Emits one OpenTelemetry span per Λ-receipt with the receipt hash as trace_id and Λ-axis attributes.",
  "license": "Apache-2.0",
  "author": "Lutar, Stephen P. <https://orcid.org/0009-0001-0110-4173>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepare": "NODE_OPTIONS=--max-old-space-size=8192 tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

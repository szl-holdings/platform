{
  "name": "@szl-holdings/vsp-otel",
  "version": "0.1.0",
  "description": "Verifiable Span Protocol (VSP) — OTel bridge MVP. Emits one OpenTelemetry span per Λ-receipt with the receipt hash as trace_id and Λ-axis attributes.",
  "license": "Apache-2.0",
  "author": "Stephen P. Lutar Jr. <stephen@szlholdings.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "NODE_OPTIONS=--max-old-space-size=8192 tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/emit.bench.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.200.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tinybench": "^2.9.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@workspace/forecast-fabric",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Forecast Fabric — unified multi-head forecasting service with calibrated interval outputs, provider-adapter slots, and named heads for every platform lane.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./src/service.ts"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./src/adapters.ts"
    },
    "./heads": {
      "types": "./dist/heads/index.d.ts",
      "import": "./src/heads/index.ts"
    }
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  }
}

{
  "name": "@workspace/eval-forge",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Eval Forge — unified evaluation system consolidating eval-os and evals-core. Provides all 10 eval-type suites, 9 metric categories, CLI, nightly scheduler, and API integration.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./src/metrics.ts"
    },
    "./graders": {
      "types": "./dist/graders.d.ts",
      "import": "./src/graders.ts"
    },
    "./grader-primitives": {
      "types": "./dist/grader-primitives.d.ts",
      "import": "./src/grader-primitives.ts"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./src/runtime.ts"
    },
    "./nightly-runner": {
      "types": "./dist/nightly-runner.d.ts",
      "import": "./src/nightly-runner.ts"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./src/cli.ts"
    },
    "./submit-cli": {
      "types": "./dist/submit-cli.d.ts",
      "import": "./src/submit-cli.ts"
    },
    "./suites": {
      "types": "./dist/suites/index.d.ts",
      "import": "./src/suites/index.ts"
    }
  },
  "bin": {
    "eval-forge": "./src/cli.ts",
    "eval-submit": "./src/submit-cli.ts"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "run-suite": "tsx src/cli.ts",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@szl-holdings/shared-contracts": "workspace:*",
    "yaml": "^2.7.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@workspace/aef-sdk",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Alloy Embedding Fabric — typed SDK client for AEF native API. Provides embed(), rerank(), hybridSearch(), and ingest() with centralized bearer-token + tenant header management, automatic retry with exponential backoff, OpenTelemetry trace propagation, and React hooks for query-bound usage.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "development": "./src/client.ts",
      "workspace": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./hooks": {
      "development": "./src/hooks.ts",
      "workspace": "./src/hooks.ts",
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./errors": {
      "development": "./src/errors.ts",
      "workspace": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./config": {
      "development": "./src/config.ts",
      "workspace": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "5.100.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  }
}

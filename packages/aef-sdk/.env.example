# AEF SDK — Required environment variables
# For server-side usage (Node.js, API routes, tool-mesh):
AEF_GATEWAY_URL=https://your-aef-gateway.repl.co
AEF_API_KEY=your-aef-bearer-token
AEF_TENANT_ID=szl-holdings

# For browser-side usage (Vite apps), prefix with VITE_:
# SECURITY: VITE_AEF_API_KEY is visible to end users in browser bundles.
# Use a separate, scoped read-only key for browser access.
# See docs/aef/RUNBOOK.md for the server-side proxy alternative.
VITE_AEF_GATEWAY_URL=https://your-aef-gateway.repl.co
VITE_AEF_API_KEY=your-aef-read-only-bearer-token
VITE_AEF_TENANT_ID=szl-holdings

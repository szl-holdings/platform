{
  "name": "@szl-holdings/connectors",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Typed connector interfaces and synthetic demo adapters for all connector categories — each adapter emits typed Signals into the mesh",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",

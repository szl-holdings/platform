{
  "name": "@szl-holdings/connectors",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Typed external-data connector framework with scheduling, drift detection, and audit-ledger integration. Inspired by Airbyte / Fivetran / Foundry — kept lean and embedded.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./src/runner.ts"
    },
    "./drift": {
      "types": "./dist/drift.d.ts",
      "import": "./src/drift.ts"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./src/registry.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@workspace/ontology": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  }
}

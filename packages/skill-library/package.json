{
  "name": "@workspace/skill-library",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Skill Library — reusable executable skills for the cognitive runtime. Stores objectives, inputs, steps, tools, expected outputs, success criteria, performance stats, and failure conditions. Turns one-off solutions into durable capabilities.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./src/registry.ts"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./src/runner.ts"
    },
    "./seeds": {
      "types": "./dist/seeds.d.ts",
      "import": "./src/seeds.ts"
    }
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch": "vitest"
  }
}

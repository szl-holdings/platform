{
  "name": "@workspace/codex-kernel",
  "version": "1.0.0",
  "type": "module",
  "description": "Codex-Kernel — replay-grade governed-loop primitive. Hash-chained state transitions, decision receipts, append-only proof ledger, hard-stop validators, and a deterministic Dresden Codex Venus reference emulator. Inspired by Maya astronomical correction tables (584d Venus synodic period); aligned with EU AI Act Article 12 logging and NIST AI RMF traceability requirements. Zero runtime dependencies; runs in browser and Node.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./src/kernel.ts"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "import": "./src/hash.ts"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "import": "./src/validators.ts"
    },
    "./receipts": {
      "types": "./dist/receipts.d.ts",
      "import": "./src/receipts.ts"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "import": "./src/ledger.ts"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./src/replay.ts"
    },
    "./dresden-venus": {
      "types": "./dist/dresden-venus.d.ts",
      "import": "./src/dresden-venus.ts"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "codex:run": "tsx src/cli/run.ts",
    "codex:replay": "tsx src/cli/replay.ts"
  },
  "bin": {
    "codex-run": "./src/cli/run.ts",
    "codex-replay": "./src/cli/replay.ts"
  }
}

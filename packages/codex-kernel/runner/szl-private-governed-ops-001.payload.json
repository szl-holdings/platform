{
  "experiment_id": "szl-private-governed-ops-001",
  "thesis_anchor": "SZL Holdings operates governed decision infrastructure for high-consequence enterprise operations through bounded loop execution, validator gates, decision receipts, and replayable proof artifacts.",
  "artifact_anchor": "Private A11oy and Ouroboros operating model running in Replit-safe offline emulator mode, extended with Dresden, Madrid, Paris, and Grolier corpus governance.",
  "environment": {
    "runtime": "replit",
    "repo_visibility": "private",
    "mode": "offline_emulator",
    "network_access": "not_required",
    "storage_mode": "filesystem_output",
    "operator": "Stephen Lutar"
  },
  "goal": {
    "target_rows": 12,
    "target_outcome": "produce auditable governed loop outputs for private enterprise operations"
  },
  "loop_policy": {
    "max_steps": 30,
    "allow_soft_fail_progression": true,
    "require_receipt_each_step": true,
    "require_proof_ledger_entry_each_commit": true,
    "stop_conditions": [
      "convergence",
      "budget_exhausted",
      "validator_hard_stop"
    ]
  },
  "budgets": {
    "step_budget": 30,
    "time_budget_ms": 120000,
    "token_budget": 0,
    "cost_budget_usd": 0
  },
  "transition_model": {
    "base_transition_rule": {
      "cycle_position_increment": 1,
      "day_index_increment": 584
    },
    "drift_model": {
      "warning_threshold": 3,
      "hard_threshold": 5,
      "schedule": {
        "type": "every_n_rows",
        "n": 5,
        "increment": 1
      }
    },
    "correction_policy": {
      "enabled": true,
      "mode": "validator_triggered",
      "reason": "Proof bundle maps correction behavior to validator-triggered correction steps"
    }
  },
  "runtime_validators": {
    "enabled": true,
    "execution_mode": "payload_declared",
    "validators": [
      {
        "name": "state_transition_rule",
        "type": "deterministic",
        "hard_stop": true,
        "enabled": true,
        "rule": "delta.patch.cycle_position_increment must equal transition_model.base_transition_rule.cycle_position_increment and delta.patch.day_index_increment must equal transition_model.base_transition_rule.day_index_increment",
        "on_fail_level": "hard_fail"
      },
      {
        "name": "drift_bounds",
        "type": "deterministic",
        "hard_stop": false,
        "enabled": true,
        "rule": "codex_emulation.drift_days below warning_threshold is pass; at or above warning_threshold is soft_fail; correction expected by hard_threshold",
        "on_warn_level": "soft_fail",
        "on_fail_level": "soft_fail"
      },
      {
        "name": "evidence_provenance",
        "type": "governance",
        "hard_stop": true,
        "enabled": true,
        "rule": "offline mocked evidence is allowed only when governance_model.evidence_policy.offline_mocking_allowed is true and evidence_state.evidence_items length is at least governance_model.evidence_policy.minimum_evidence_items",
        "on_fail_level": "hard_fail"
      },
      {
        "name": "locator_required",
        "type": "governance",
        "hard_stop": true,
        "enabled": true,
        "rule": "every evidence item used for claims tagged dresdencore, ouroboroscore, madridsupport, parissupport, or groliersupport must include a non-empty locator",
        "on_fail_level": "hard_fail"
      },
      {
        "name": "no_unbound_claims",
        "type": "governance",
        "hard_stop": true,
        "enabled": true,
        "rule": "every claim object must contain at least one evidence reference",
        "on_fail_level": "hard_fail"
      },
      {
        "name": "madrid_gate",
        "type": "governance",
        "hard_stop": true,
        "enabled": true,
        "rule": "claims tagged dresdencore or ouroboroscore may not rely on madridsupport as sole evidence",
        "on_fail_level": "hard_fail"
      },
      {
        "name": "paris_gate",
        "type": "governance",
        "hard_stop": true,
        "enabled": true,
        "rule": "claims tagged dresdencore or ouroboroscore may not rely on parissupport as sole evidence",
        "on_fail_level": "hard_fail"
      },
      {
        "name": "grolier_gate",
        "type": "governance",
        "hard_stop": true,
        "enabled": true,
        "rule": "claims tagged dresdencore or ouroboroscore may not rely on groliersupport as sole evidence",
        "on_fail_level": "hard_fail"
      },
      {
        "name": "human_gate",
        "type": "governance",
        "hard_stop": true,
        "enabled": true,
        "rule": "if workload.material_action is true, approval_status must be approved before execution",
        "on_fail_level": "hard_fail"
      }
    ]
  },
  "runtime_receipt_contract": {
    "enabled": true,
    "required_fields": [
      "receipt_id",
      "step",
      "decision_type",
      "summary",
      "assumptions",
      "evidence",
      "policy_version",
      "approval_status",
      "mocked",
      "timestamp"
    ],
    "required_evidence_sources": [
      "payload.thesis_anchor",
      "payload.artifact_anchor"
    ],
    "receipt_policy": {
      "must_reference_policy_version": true,
      "must_include_evidence_array": true,
      "must_include_mocked_flag": true
    }
  },
  "runtime_trace_contract": {
    "enabled": true,
    "required_event_fields": [
      "ts",
      "step",
      "pipeline_stage",
      "state_prev_hash",
      "proposed_delta",
      "validator_results",
      "decision_receipt",
      "state_next_hash",
      "stop_reason"
    ],
    "ledger_policy": {
      "append_only": true,
      "hash_algorithm": "sha256",
      "require_delta_hash": true,
      "require_receipt_link": true
    }
  },
  "almanac_system": {
    "model": "madrid-dresden-paris-grolier-governed-multicycle",
    "rationale": "Dresden contributes loop-native table framing, Madrid contributes comparative almanac structure, Paris contributes ritual and calendrical cadence, and Grolier contributes compact predetermined Venus-cycle logic.",
    "cycles": {
      "operational_cycle": {
        "unit": "step",
        "length": 30,
        "purpose": "bounded execution loop"
      },
      "governance_cycle": {
        "unit": "review_window",
        "length": 5,
        "purpose": "human review and approval cadence"
      },
      "risk_cycle": {
        "unit": "threshold_band",
        "length": 3,
        "purpose": "warning and escalation rhythm"
      },
      "seasonal_cycle": {
        "unit": "quarter",
        "length": 4,
        "purpose": "planning and business seasonality alignment"
      },
      "domain_cycle": {
        "unit": "domain_rotation",
        "length": 9,
        "purpose": "cross-domain orchestration across domain packs"
      },
      "ritual_cycle": {
        "unit": "ceremonial_window",
        "length": 13,
        "purpose": "ritual and long-cycle governance timing"
      },
      "venus_cycle": {
        "unit": "predetermined_schedule",
        "length": 5,
        "purpose": "compact forward cycle guidance inspired by Venus-table logic"
      }
    },
    "coordination_rules": [
      "risk warnings can tighten governance cadence",
      "seasonal cycle can reprioritize workload intensity",
      "operational convergence cannot bypass human approval policy",
      "domain participation changes are recorded as governed state context",
      "ritual cycle may schedule review windows but cannot override policy gates",
      "venus cycle may inform forecast cadence but cannot act as sole evidence for core loop claims"
    ]
  },
  "corpus_governance": {
    "citation_bound": true,
    "required_locators": true,
    "locator_minimum": [
      "page_or_folio",
      "section_or_locator"
    ],
    "gates": [
      {
        "gate_id": "madrid_not_proof_for_dresden_or_ouroboros_core",
        "rule": "Claims tagged dresdencore or ouroboroscore may not rely on madridsupport sources as sole evidence"
      },
      {
        "gate_id": "paris_not_proof_for_dresden_or_ouroboros_core",
        "rule": "Claims tagged dresdencore or ouroboroscore may not rely on parissupport sources as sole evidence"
      },
      {
        "gate_id": "grolier_not_proof_for_dresden_or_ouroboros_core",
        "rule": "Claims tagged dresdencore or ouroboroscore may not rely on groliersupport sources as sole evidence"
      },
      {
        "gate_id": "no_unbound_claims",
        "rule": "Every claim must include at least one evidence quote with a non-empty locator"
      },
      {
        "gate_id": "illustrative_image_limit",
        "rule": "Illustrative codex images may support presentation and analogy but not exact reconstruction claims unless page-identified scholarly sources are provided"
      }
    ]
  },
  "proof_bundle_policy": {
    "bundle_version": "v2-dresden-appendix",
    "bundle_role": "evidence_bound_proof_workflow",
    "claims_policy": {
      "dresden_role": "loop_native_benchmark_anchor",
      "madrid_role": "comparative_almanac_support",
      "paris_role": "ritual_and_calendrical_support",
      "grolier_role": "predetermined_venus_cycle_support",
      "exact_reconstruction_claims_allowed": false,
      "require_specific_pages_for_exact_citations": true
    },
    "image_appendix_policy": {
      "venus_images_role": "illustrative_anchor",
      "eclipse_images_role": "illustrative_anchor",
      "public_hosts_may_change": true,
      "redundant_images_encouraged": true
    },
    "mapping": {
      "tabular_step_progression": "governed_state_transitions",
      "correction_behavior": "validator_triggered_correction_steps",
      "table_auditability": "append_only_trace_plus_replay_contract_plus_proof_ledger"
    }
  },
  "governance_model": {
    "policy_version": "1.3.0-private-szl",
    "governance_mode": "receipt_first",
    "evidence_policy": {
      "offline_mocking_allowed": true,
      "minimum_evidence_items": 2,
      "require_provenance_labels": true
    },
    "human_gate_policy": {
      "required_for_material_actions": true,
      "required_for_external_side_effects": true,
      "required_for_fund_movement": true,
      "required_for_legal_commitments": true,
      "required_for_vendor_termination": true
    },
    "proof_policy": {
      "hash_algorithm": "sha256",
      "stable_json_required": true,
      "replay_check_required": true,
      "append_only_trace_required": true
    }
  },
  "platform_context": {

{
  "name": "@szl/mcp-governor",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Prototype MCP capability-token, policy, and receipt contracts designed for fail-closed tool execution.",
  "license": "LicenseRef-SZL-Proprietary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szl-holdings/platform.git",
    "directory": "packages/mcp-governor"
  },
  "homepage": "https://github.com/szl-holdings/platform/tree/main/packages/mcp-governor#readme",
  "bugs": {
    "url": "https://github.com/szl-holdings/platform/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "publication-contract.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capability": {
      "types": "./dist/capability.d.ts",
      "import": "./dist/capability.js"
    },
    "./attestation": {
      "types": "./dist/attestation.d.ts",
      "import": "./dist/attestation.js"
    },
    "./governor": {
      "types": "./dist/governor.d.ts",
      "import": "./dist/governor.js"
    },
    "./receipt": {
      "types": "./dist/receipt.d.ts",
      "import": "./dist/receipt.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "prepack": "node ../../scripts/release/public-npm-contract.mjs --check && tsx --test src/*.test.ts && tsc --build --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}

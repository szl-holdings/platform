{
  "name": "@szl-holdings/action-engine",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "SZL Action Engine — executable workflows with manual/semi-auto/autonomous modes, approval gates, rollback hooks, and immutable execution history",
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "development": "./src/types.ts",
      "workspace": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./executor": {
      "development": "./src/executor.ts",
      "workspace": "./src/executor.ts",
      "types": "./dist/executor.d.ts",
      "import": "./dist/executor.js"
    },
    "./history": {
      "development": "./src/history.ts",
      "workspace": "./src/history.ts",
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    }
  },
  "dependencies": {
    "@szl-holdings/atlas-core": "workspace:*",
    "@szl-holdings/decision-engine": "workspace:*",
    "@szl-holdings/policy-engine": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  }
}

{
  "name": "@workspace/langextract-bridge",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Stephen P. Lutar Jr. <stephen@szlholdings.com>",
  "description": "Doctrine-clean TypeScript bridge to google/langextract (Apache-2.0). Wraps the Python sidecar behind a content-addressed cache so structured extraction is deterministic across the 5x byte-identical replay requirement.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./src/cache.ts"
    },
    "./schema-grounded": {
      "types": "./dist/schema-grounded-extract.d.ts",
      "import": "./src/schema-grounded-extract.ts"
    },
    "./span-provenance": {
      "types": "./dist/span-provenance.d.ts",
      "import": "./src/span-provenance.ts"
    }
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}

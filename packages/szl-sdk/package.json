{
  "name": "@szl-holdings/sdk",
  "version": "1.2.0",
  "description": "Official TypeScript SDK for the SZL Holdings Public API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepare": "NODE_OPTIONS=--max-old-space-size=8192 tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": ["szl-holdings", "sdk", "api", "typescript"],
  "license": "UNLICENSED",
  "dependencies": {
    "@szl-holdings/policy-engine": "workspace:*",
    "@szl-holdings/szl-receipts": "workspace:*",
    "@workspace/ouroboros-invariant": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "^5.3.3",
    "vitest": "catalog:"
  }
}

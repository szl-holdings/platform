{
  "name": "@workspace/planner",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Planner — goal decomposition, model/tool/approval routing, risk-aware sequencing, fallback plan generation, persistent plan graphs.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./planner": {
      "types": "./dist/planner.d.ts",
      "import": "./src/planner.ts"
    },
    "./decomposer": {
      "types": "./dist/decomposer.d.ts",
      "import": "./src/decomposer.ts"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./src/router.ts"
    },
    "./risk-estimator": {
      "types": "./dist/risk-estimator.d.ts",
      "import": "./src/risk-estimator.ts"
    },
    "./fallback-generator": {
      "types": "./dist/fallback-generator.d.ts",
      "import": "./src/fallback-generator.ts"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./src/store.ts"
    }
  },
  "dependencies": {
    "@szl-holdings/ai-control-plane": "workspace:*",
    "@szl-holdings/decision-engine": "workspace:*",
    "@workspace/tool-mesh": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

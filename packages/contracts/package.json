{
  "name": "@szl-holdings/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod request/response contracts for internal APIs and webhooks. TS types are inferred from schemas — never hand-written in parallel.",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./alloy": "./src/alloy.ts",
    "./ai": "./src/ai.ts",
    "./webhooks": "./src/webhooks.ts",
    "./admin": "./src/admin.ts",
    "./common": "./src/common.ts",
    "./decision-genome": "./src/decision-genome.ts",
    "./governance": "./src/governance.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

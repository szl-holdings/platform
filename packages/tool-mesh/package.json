{
  "name": "@workspace/tool-mesh",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "MCP Tool Mesh — canonical schema-bound tool registry and gateway. Consolidates tool-registry, gateway, rate limiting, timeouts, fallback chains, guardian approval, observability hooks, MCP bridging, and execution tracking.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./src/manifest.ts"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./src/registry.ts"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./src/gateway.ts"
    },
    "./rate-limiter": {
      "types": "./dist/rate-limiter.d.ts",
      "import": "./src/rate-limiter.ts"
    },
    "./executor": {
      "types": "./dist/executor.d.ts",
      "import": "./src/executor.ts"
    },
    "./mcp-bridge": {
      "types": "./dist/mcp-bridge.d.ts",
      "import": "./src/mcp-bridge.ts"
    },
    "./tools/graph-query": {
      "types": "./dist/tools/graph-query.d.ts",
      "import": "./src/tools/graph-query.ts"
    },
    "./tools/document-retrieval": {
      "types": "./dist/tools/document-retrieval.d.ts",
      "import": "./src/tools/document-retrieval.ts"
    },
    "./tools/security-tools": {
      "types": "./dist/tools/security-tools.d.ts",
      "import": "./src/tools/security-tools.ts"
    },
    "./tools/finance-tools": {
      "types": "./dist/tools/finance-tools.d.ts",
      "import": "./src/tools/finance-tools.ts"
    },
    "./tools/operations-tools": {
      "types": "./dist/tools/operations-tools.d.ts",
      "import": "./src/tools/operations-tools.ts"
    }
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "@workspace/aef-sdk": "workspace:*",
    "@workspace/cognitive-observability": "workspace:*",
    "@workspace/guardian": "workspace:*",
    "@workspace/trace-graph": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

{
  "name": "@szl-holdings/db-migrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated Drizzle migrations — dedicated migration path with run/check utilities.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "pnpm --filter @szl-holdings/db run generate",
    "migrate": "pnpm --filter @szl-holdings/db run migrate",
    "push": "pnpm --filter @szl-holdings/db run push",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@szl-holdings/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

{
  "name": "@workspace/eval-os",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Eval OS — unified evaluation framework. Gold-dataset, scenario-suite, prompt-test, tool-reliability, citation-quality, hallucination, policy-adherence, latency, cost, and regression primitives for the SZL Agentic Cognitive Operating Intelligence Platform.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./dataset": {
      "types": "./dist/dataset.d.ts",
      "import": "./src/dataset.ts"
    },
    "./scorer": {
      "types": "./dist/scorer.d.ts",
      "import": "./src/scorer.ts"
    },
    "./regression": {
      "types": "./dist/regression.d.ts",
      "import": "./src/regression.ts"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./src/cli.ts"
    }
  },
  "bin": {
    "eval-os": "./src/cli.ts"
  },
  "dependencies": {
    "@szl-holdings/evals-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.2"
  }
}

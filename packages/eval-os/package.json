{
  "name": "@workspace/eval-os",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Eval OS — unified evaluation framework. Gold-dataset, scenario-suite, prompt-test, tool-reliability, citation-quality, hallucination, policy-adherence, latency, cost, and regression primitives for the SZL Agentic Cognitive Operating Intelligence Platform.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./dataset": {
      "types": "./dist/dataset.d.ts",
      "import": "./src/dataset.ts"
    },
    "./scorer": {
      "types": "./dist/scorer.d.ts",
      "import": "./src/scorer.ts"
    },
    "./regression": {
      "types": "./dist/regression.d.ts",
      "import": "./src/regression.ts"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./src/cli.ts"
    },
    "./graders": {
      "types": "./dist/graders.d.ts",
      "import": "./src/graders.ts"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./src/runtime.ts"
    },
    "./trace-grader": {
      "types": "./dist/trace-grader.d.ts",
      "import": "./src/trace-grader.ts"
    },
    "./nightly-runner": {
      "types": "./dist/nightly-runner.d.ts",
      "import": "./src/nightly-runner.ts"
    },
    "./suites": {
      "types": "./dist/suites/index.d.ts",
      "import": "./src/suites/index.ts"
    }
  },
  "bin": {
    "eval-os": "./src/nightly-runner.ts"
  },
  "scripts": {
    "run-suite": "tsx src/nightly-runner.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@szl-holdings/evals-core": "workspace:*",
    "@workspace/eval-forge": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vitest": "^4.1.2"
  }
}

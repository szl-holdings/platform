{
  "name": "@szl-holdings/db-unified",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Query/repository layer organized by domain. Single relational entry point — wraps @szl-holdings/db with domain-scoped repository patterns.",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/repositories/auth.ts",
    "./alloy": "./src/repositories/alloy.ts",
    "./audit": "./src/repositories/audit.ts",
    "./vessels": "./src/repositories/vessels.ts",
    "./terra": "./src/repositories/terra.ts",
    "./firestorm": "./src/repositories/firestorm.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@szl-holdings/db": "workspace:*",
    "@szl-holdings/db-schema": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

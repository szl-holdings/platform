{
  "name": "@workspace/aef-policy-guard",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Alloy Embedding Fabric — policy rule evaluation, tenant boundary enforcement, retention controls, and redaction hook registry. Returns structured PolicyDecision objects; no silent fallbacks.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "development": "./src/types.ts",
      "workspace": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./engine": {
      "development": "./src/engine.ts",
      "workspace": "./src/engine.ts",
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./tenant": {
      "development": "./src/tenant.ts",
      "workspace": "./src/tenant.ts",
      "types": "./dist/tenant.d.ts",
      "import": "./dist/tenant.js"
    },
    "./retention": {
      "development": "./src/retention.ts",
      "workspace": "./src/retention.ts",
      "types": "./dist/retention.d.ts",
      "import": "./dist/retention.js"
    },
    "./redaction": {
      "development": "./src/redaction.ts",
      "workspace": "./src/redaction.ts",
      "types": "./dist/redaction.d.ts",
      "import": "./dist/redaction.js"
    }
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

{
  "name": "@workspace/ontology",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Canonical entity, entity-link, entity-snapshot, signal, and evidence type definitions for the SZL Holdings platform. Also provides Zod-validated Signal, EvidenceItem, and Recommendation contracts for the living signal mesh.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./entities": {
      "types": "./dist/entities.d.ts",
      "import": "./src/entities.ts"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "import": "./src/signals.ts"
    },
    "./entity-links": {
      "types": "./dist/entity-links.d.ts",
      "import": "./src/entity-links.ts"
    },
    "./entity-snapshot": {
      "types": "./dist/entity-snapshot.d.ts",
      "import": "./src/entity-snapshot.ts"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "import": "./src/evidence.ts"
    },
    "./domains": {
      "types": "./dist/domains.d.ts",
      "import": "./src/domains.ts"
    },
    "./signal": {
      "types": "./dist/signal.d.ts",
      "import": "./src/signal.ts"
    },
    "./entity": {
      "types": "./dist/entity.d.ts",
      "import": "./src/entity.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.2"
  }
}

{
  "name": "@workspace/aef-evals",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Alloy Embedding Fabric — retrieval evaluation harness. Ships golden fixture sets for all six AEF verticals, metric implementations (nDCG@k, Recall@k, Precision@k, MRR), evidence-completeness checks, latency and throughput benchmarking, and JSON/console reporters.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./src/runner.ts"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./src/metrics/index.ts"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./src/fixtures/index.ts"
    }
  },
  "dependencies": {
    "@workspace/aef-contracts": "workspace:*",
    "@workspace/aef-retrieval-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

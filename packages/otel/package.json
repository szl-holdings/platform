{
  "name": "@szl-holdings/otel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenTelemetry SDK initialization, OTLP exporter, and helpers for HTTP, Drizzle, fetch, and agent tool-call spans.",
  "exports": {
    ".": "./src/index.ts",
    "./middleware": "./src/middleware.ts",
    "./drizzle": "./src/drizzle-instrumentation.ts",
    "./agent": "./src/agent-spans.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "test": "vitest run"
  },
  "dependencies": {
    "@szl-holdings/observability": "workspace:*",
    "@szl-holdings/telemetry-standards": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  }
}

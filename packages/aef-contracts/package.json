{
  "name": "@workspace/aef-contracts",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Alloy Embedding Fabric — typed Zod schemas and TypeScript contracts for all AEF API shapes: embed, rerank, hybrid-search, ingest, index operations, evals, evidence objects, tenant identity, profile descriptors, backend descriptors, and event payloads.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tenant": {
      "development": "./src/tenant.ts",
      "workspace": "./src/tenant.ts",
      "types": "./dist/tenant.d.ts",
      "import": "./dist/tenant.js"
    },
    "./embed": {
      "development": "./src/embed.ts",
      "workspace": "./src/embed.ts",
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./rerank": {
      "development": "./src/rerank.ts",
      "workspace": "./src/rerank.ts",
      "types": "./dist/rerank.d.ts",
      "import": "./dist/rerank.js"
    },
    "./search": {
      "development": "./src/search.ts",
      "workspace": "./src/search.ts",
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./ingest": {
      "development": "./src/ingest.ts",
      "workspace": "./src/ingest.ts",
      "types": "./dist/ingest.d.ts",
      "import": "./dist/ingest.js"
    },
    "./index-ops": {
      "development": "./src/index-ops.ts",
      "workspace": "./src/index-ops.ts",
      "types": "./dist/index-ops.d.ts",
      "import": "./dist/index-ops.js"
    },
    "./evals": {
      "development": "./src/evals.ts",
      "workspace": "./src/evals.ts",
      "types": "./dist/evals.d.ts",
      "import": "./dist/evals.js"
    },
    "./openai-compat": {
      "development": "./src/openai-compat.ts",
      "workspace": "./src/openai-compat.ts",
      "types": "./dist/openai-compat.d.ts",
      "import": "./dist/openai-compat.js"
    },
    "./evidence": {
      "development": "./src/evidence.ts",
      "workspace": "./src/evidence.ts",
      "types": "./dist/evidence.d.ts",
      "import": "./dist/evidence.js"
    },
    "./events": {
      "development": "./src/events.ts",
      "workspace": "./src/events.ts",
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./backends": {
      "development": "./src/backends.ts",
      "workspace": "./src/backends.ts",
      "types": "./dist/backends.d.ts",
      "import": "./dist/backends.js"
    }
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

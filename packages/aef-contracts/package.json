{
  "name": "@workspace/aef-contracts",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Continuum Fabric Fabric — typed Zod schemas and TypeScript contracts for all CF API shapes: embed, rerank, hybrid-search, ingest, index operations, evals, evidence objects, tenant identity, profile descriptors, backend descriptors, and event payloads.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./tenant": {
      "types": "./dist/tenant.d.ts",
      "import": "./src/tenant.ts"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./src/embed.ts"
    },
    "./rerank": {
      "types": "./dist/rerank.d.ts",
      "import": "./src/rerank.ts"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./src/search.ts"
    },
    "./ingest": {
      "types": "./dist/ingest.d.ts",
      "import": "./src/ingest.ts"
    },
    "./index-ops": {
      "types": "./dist/index-ops.d.ts",
      "import": "./src/index-ops.ts"
    },
    "./evals": {
      "types": "./dist/evals.d.ts",
      "import": "./src/evals.ts"
    },
    "./openai-compat": {
      "types": "./dist/openai-compat.d.ts",
      "import": "./src/openai-compat.ts"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "import": "./src/evidence.ts"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./src/events.ts"
    },
    "./backends": {
      "types": "./dist/backends.d.ts",
      "import": "./src/backends.ts"
    }
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  }
}

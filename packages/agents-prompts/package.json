{
  "name": "@workspace/agents-prompts",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Agents Prompts — prompt templates with semantic versioning, separated from business logic. Named PromptRef references replace inline string templates.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./ref": {
      "types": "./dist/ref.d.ts",
      "import": "./src/ref.ts"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./src/registry.ts"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "import": "./src/seed.ts"
    }
  },
  "dependencies": {
    "@szl-holdings/prompt-registry": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

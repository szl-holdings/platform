{
  "name": "@workspace/cognitive-runtime",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Cognitive Runtime \u2014 end-to-end PERCEIVE \u2192 ORIENT \u2192 PLAN \u2192 EXECUTE \u2192 VERIFY \u2192 REFLECT \u2192 UPDATE SELF MODEL \u2192 UPDATE MEMORY loop orchestrator with checkpointing, retries, and resume.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./orchestrator": {
      "types": "./dist/orchestrator.d.ts",
      "import": "./src/orchestrator.ts"
    },
    "./checkpoint": {
      "types": "./dist/checkpoint.d.ts",
      "import": "./src/checkpoint.ts"
    }
  },
  "dependencies": {
    "@szl-holdings/contracts": "workspace:*",
    "@workspace/agents-core": "workspace:*",
    "@workspace/approvals-inbox": "workspace:*",
    "@workspace/cognitive-observability": "workspace:*",
    "@workspace/guardian": "workspace:*",
    "@workspace/memory-fabric": "workspace:*",
    "@workspace/planner": "workspace:*",
    "@workspace/reflection-engine": "workspace:*",
    "@workspace/run-ledger": "workspace:*",
    "@workspace/self-model": "workspace:*",
    "@workspace/tool-mesh": "workspace:*",
    "@workspace/trace-graph": "workspace:*",
    "@workspace/verifier": "workspace:*",
    "drizzle-orm": "catalog:",
    "isolated-vm": "^6.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}

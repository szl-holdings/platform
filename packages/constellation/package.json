{
  "name": "@szl-holdings/constellation",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Constellation — cross-domain ontology and intelligence graph for the SZL platform",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./src/schema.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./src/types.ts"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./src/adapter.ts"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./src/store.ts"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./src/query.ts"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./src/registry.ts"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./src/adapters/*.ts"
    }
  },
  "dependencies": {
    "@szl-holdings/atlas-core": "workspace:*",
    "@szl-holdings/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.2"
  }
}

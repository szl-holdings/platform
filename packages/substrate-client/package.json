{
  "name": "@szl/substrate-client",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Typed client SDK for the Substrate MCP Gateway. Covers submitRun, getRun, replay, counterfactual, listApprovals, approve, reject, listWorkflows, and streaming run events.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "development": "./src/types.ts",
      "workspace": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./streaming": {
      "development": "./src/streaming.ts",
      "workspace": "./src/streaming.ts",
      "types": "./dist/streaming.d.ts",
      "import": "./dist/streaming.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  },
  "keywords": [
    "szl",
    "substrate",
    "mcp",
    "model-context-protocol",
    "agent",
    "governance",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/szl-holdings/platform"
  }
}

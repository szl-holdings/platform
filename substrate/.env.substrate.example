# ─── Substrate Fleet — Environment Variable Template ──────────────────────────
# Copy this file to .env.substrate and fill in the values.
# .env.substrate is gitignored. NEVER commit secrets.
#
# Usage:
#   cp .env.substrate.example .env.substrate
#   $EDITOR .env.substrate
#   source .env.substrate   # or: ./scripts/deploy-substrate.sh (auto-loads)
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Azure Container Registry login server
# Found in: Azure Portal → Container Registries → [name] → Login server
ACR_LOGIN_SERVER=szlholdingsacr.azurecr.io

# Azure subscription ID (uuid format)
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Azure resource group containing the substrate fleet
AZURE_RESOURCE_GROUP=szlholdings-prod

# API key for the substrate inference service (protects /v1/models/load and /unload)
# Generate with: openssl rand -hex 32
SUBSTRATE_API_KEY=

# URL of the substrate inference service — used by Python workers to check
# whether GPU inference is available (model_router.py check_substrate_gate).
# In docker-compose this is set automatically to http://substrate-inference:8070.
# In Azure Container Apps this is set to the inference app's internal FQDN.
# Required for model_router to route to the substrate GPU provider.
SUBSTRATE_INFERENCE_URL=http://localhost:8070

# ── OPTIONAL: Image and deploy configuration ──────────────────────────────────

# Git SHA for image tagging (auto-detected from git if not set)
# GIT_SHA=

# Bicep parameters file path (default: infra/parameters.json)
# BICEP_PARAMS_FILE=infra/parameters.json

# ── OPTIONAL: Autoscaling ─────────────────────────────────────────────────────

# Queue depth that triggers a scale-out recommendation (default: 3)
# SCALE_OUT_QUEUE_DEPTH=3

# Maximum number of Python worker replicas (default: 10)
# MAX_WORKERS=10

# Minimum number of Python worker replicas — keep at 1 to avoid cold starts
# MIN_WORKERS=1

# ── OPTIONAL: Inference configuration ─────────────────────────────────────────

# Model to auto-load on inference service startup (default: none)
# SUBSTRATE_DEFAULT_MODEL=llama-3.1-8b-instruct

# Maximum concurrent inference requests (default: 4)
# SUBSTRATE_MAX_CONCURRENT=4

# Maximum inference service memory (docker-compose only, default: 48g)
# INFERENCE_MEMORY_LIMIT=48g

# Maximum worker memory (docker-compose only, default: 16g)
# WORKER_MEMORY_LIMIT=16g

# ── OPTIONAL: Observability ───────────────────────────────────────────────────

# OpenTelemetry OTLP endpoint for traces (default: none)
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ── OPTIONAL: Post-deploy smoke ───────────────────────────────────────────────

# Override the worker URL used in the post-deploy smoke test
# Default: auto-detected from Bicep deployment outputs
# SMOKE_WORKER_URL=https://szlholdings-substrate-workers.eastus2.azurecontainerapps.io

# Override the inference URL used in the post-deploy smoke test
# SMOKE_INFERENCE_URL=https://szlholdings-substrate-inference.eastus2.azurecontainerapps.io

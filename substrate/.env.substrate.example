# ─── Substrate Fleet — Environment Variable Template ──────────────────────────
# Copy this file to .env.substrate and fill in the values.
# .env.substrate is gitignored. NEVER commit secrets.
#
# Usage:
#   cp .env.substrate.example .env.substrate
#   $EDITOR .env.substrate
#   docker compose --env-file .env.substrate -f docker-compose.gpu.yml config
#   docker compose --env-file .env.substrate -f docker-compose.gpu.yml up --build
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# API key for every /v1 route on the substrate inference service.
# Generate with: openssl rand -hex 32, then store/inject it as a secret.
SUBSTRATE_API_KEY=

# Tenant identity bound to SUBSTRATE_API_KEY. Inference requests must send the
# same value in X-Tenant-ID and in tenant-scoped request payloads.
SUBSTRATE_API_TENANT_ID=

# Separate credential for model load/unload administration. It must not equal
# SUBSTRATE_API_KEY and must be injected from the deployment secret manager.
SUBSTRATE_MODEL_ADMIN_API_KEY=

# JSON object mapping each admitted model ID to an exact 40-character source
# revision. Production requires at least one entry; do not use a branch or tag.
# Example shape: {"llama-3.1-8b-instruct":"<40-character-commit-sha>"}
SUBSTRATE_MODEL_REVISIONS_JSON=

# Bearer credential and single-tenant binding for the Python worker boundary.
# This is a separate service identity from the inference credentials above.
SUBSTRATE_PYTHON_WORKER_API_KEY=
SUBSTRATE_PYTHON_WORKER_TENANT_ID=

# ── OPTIONAL: Image and deploy configuration ──────────────────────────────────

# Explicit image names/tags. Pin immutable release digests outside local builds.
# INFERENCE_IMAGE=substrate-inference:local
# WORKER_IMAGE=substrate-py-workers:local

# Host directories backing the model and KV-cache volumes. Create both before
# `docker compose up`; Docker bind mounts do not create these source paths.
# SUBSTRATE_MODELS_DIR=/data/substrate/models
# SUBSTRATE_CACHE_DIR=/data/substrate/cache

# Optional external Azure deployment metadata. The local Compose stack does
# not consume these values directly.
# ACR_LOGIN_SERVER=example.azurecr.io
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_RESOURCE_GROUP=example-substrate

# Bicep parameters file path (default: infra/parameters.json)
# BICEP_PARAMS_FILE=infra/parameters.json

# ── OPTIONAL: Autoscaling ─────────────────────────────────────────────────────

# Queue depth that triggers a scale-out recommendation (default: 3)
# SCALE_OUT_QUEUE_DEPTH=3

# Maximum number of Python worker replicas (default: 10)
# MAX_WORKERS=10

# Minimum number of Python worker replicas — keep at 1 to avoid cold starts
# MIN_WORKERS=1

# ── OPTIONAL: Inference configuration ─────────────────────────────────────────

# Model to auto-load on inference service startup (default: none)
# SUBSTRATE_DEFAULT_MODEL=llama-3.1-8b-instruct

# Maximum concurrent inference requests (default: 4)
# SUBSTRATE_MAX_CONCURRENT=4

# Maximum inference service memory (docker-compose only, default: 48g)
# INFERENCE_MEMORY_LIMIT=48g

# Maximum worker memory (docker-compose only, default: 16g)
# WORKER_MEMORY_LIMIT=16g

# ── OPTIONAL: Observability ───────────────────────────────────────────────────

# OpenTelemetry OTLP endpoint for traces (default: none)
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ── OPTIONAL: Post-deploy smoke ───────────────────────────────────────────────

# Override the worker URL used in the post-deploy smoke test
# Default: auto-detected from Bicep deployment outputs
# SMOKE_WORKER_URL=https://szlholdings-substrate-workers.eastus2.azurecontainerapps.io

# Override the inference URL used in the post-deploy smoke test
# SMOKE_INFERENCE_URL=https://szlholdings-substrate-inference.eastus2.azurecontainerapps.io

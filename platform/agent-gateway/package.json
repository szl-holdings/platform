{
  "name": "@szl-holdings/agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SZL Holdings Agent Gateway — policy, audit, and evidence boundary for the OpenAI Agents SDK. Phase 11.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint ./src ./tests",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@temporalio/client": "^1.16.1",
    "express": "^4.19.2",
    "jose": "^5.9.6",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.17",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

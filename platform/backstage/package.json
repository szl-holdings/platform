{
  "name": "@szl-holdings/backstage-root",
  "version": "1.0.0",
  "description": "SZL Holdings Developer Portal — Backstage IDP root workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter @szl-holdings/backstage-backend start\" \"pnpm --filter @szl-holdings/backstage-app start\"",
    "build": "pnpm --filter @szl-holdings/backstage-app build && pnpm --filter @szl-holdings/backstage-backend build",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "lint": "pnpm --filter \"@szl-holdings/backstage-*\" lint"
  },
  "devDependencies": {
    "@backstage/catalog-model": "1.7.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.2",
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.106.2",
      "@backstage/cli>webpack": "5.106.2",
      "undici": ">=6.23.0",
      "koa": ">=2.16.2",
      "prismjs": ">=1.30.0",
      "underscore": ">=1.13.8",
      "uuid": ">=11.1.1",
      "file-type": ">=21.3.1",
      "vm2": ">=3.11.3",
      "fast-uri": ">=3.1.2",
      "fast-xml-builder": ">=1.1.7",
      "ip-address": ">=10.1.1",
      "@tootallnate/once": ">=3.0.1",
      "@octokit/request": ">=8.4.1",
      "@octokit/request-error": ">=5.1.1",
      "@octokit/plugin-paginate-rest": ">=9.2.2",
      "@backstage/plugin-scaffolder-backend": ">=3.1.4",
      "@backstage/plugin-catalog-unprocessed-entities": ">=0.2.30",
      "@backstage/plugin-catalog-unprocessed-entities-common": ">=0.0.15"
    }
  }
}

# Required — copy to .env and fill in values before running locally
NODE_ENV=development

# OpenTelemetry
OTEL_SERVICE_NAME=${{ values.agentSlug }}-worker
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Temporal
TEMPORAL_NAMESPACE=default
TEMPORAL_ADDRESS=localhost:7233

# Agent model (override in production via Secret)
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_CONCURRENCY=4

# Logging
LOG_LEVEL=info

# ${{ values.domainName }} API — Environment Variables
# Copy to .env and fill in values for local development.
# NEVER commit .env — only .env.example is tracked.

# Runtime
NODE_ENV=development
PORT=${{ values.port }}

# Auth (from packages/auth-shared)
SESSION_SECRET=change-me-in-production

# Policy (from packages/policy-guard)
POLICY_ENFORCEMENT_MODE=audit   # audit | enforce

# Observability (from packages/otel)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=${{ values.domainSlug }}-api

# Database (if needsDatabase=true)
# DATABASE_URL=postgresql://user:password@localhost:5432/szl_dev

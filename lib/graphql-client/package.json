{
  "name": "@szl-holdings/graphql-client",
  "version": "0.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/szl-holdings/szl-holdings-platform.git",
    "directory": "lib/graphql-client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.tsx",
    "./hooks": "./src/hooks/index.ts"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "graphql": "^16.13.2",
    "graphql-ws": "^6.0.8"
  },
  "devDependencies": {
    "@types/react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

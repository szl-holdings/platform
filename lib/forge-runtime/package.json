{
  "name": "@szl-holdings/forge-runtime",
  "version": "0.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/szl-holdings/platform.git",
    "directory": "lib/forge-runtime"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./sandbox": "./src/sandbox.ts",
    "./evidence": "./src/evidence.ts",
    "./timeline": "./src/timeline.ts"
  },
  "dependencies": {
    "@szl-holdings/db": "workspace:*",
    "@szl-holdings/env": "workspace:*",
    "@szl-holdings/observability": "workspace:*",
    "@szl-holdings/prism-bus": "workspace:*",
    "@szl-holdings/services": "workspace:*",
    "drizzle-orm": "catalog:",
    "esbuild": "^0.28",
    "pino": "^9",
    "pino-pretty": "^13"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

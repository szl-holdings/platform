{
  "name": "@szl-holdings/forge-runtime",
  "version": "0.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/szl-holdings/platform.git",
    "directory": "lib/forge-runtime"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "development": "./src/runtime.ts",
      "workspace": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./sandbox": {
      "development": "./src/sandbox.ts",
      "workspace": "./src/sandbox.ts",
      "types": "./dist/sandbox.d.ts",
      "import": "./dist/sandbox.js"
    },
    "./evidence": {
      "development": "./src/evidence.ts",
      "workspace": "./src/evidence.ts",
      "types": "./dist/evidence.d.ts",
      "import": "./dist/evidence.js"
    },
    "./timeline": {
      "development": "./src/timeline.ts",
      "workspace": "./src/timeline.ts",
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    }
  },
  "dependencies": {
    "@szl-holdings/db": "workspace:*",
    "@szl-holdings/env": "workspace:*",
    "@szl-holdings/observability": "workspace:*",
    "@szl-holdings/prism-bus": "workspace:*",
    "@szl-holdings/services": "workspace:*",
    "drizzle-orm": "catalog:",
    "esbuild": "^0.28",
    "pino": "^9",
    "pino-pretty": "^13"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc --build"
  }
}

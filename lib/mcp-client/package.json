{
  "name": "@szl-holdings/mcp-client",
  "version": "0.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/szl-holdings/szl-holdings-platform.git",
    "directory": "lib/mcp-client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks.tsx",
    "./components": "./src/components.tsx",
    "./store": "./src/McpStoreProvider.tsx",
    "./mobile": "./src/mobile.tsx"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:"
  },
  "scripts": {
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

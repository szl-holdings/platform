{
  "name": "@szl-holdings/prism-bus",
  "version": "0.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/szl-holdings/platform.git",
    "directory": "lib/prism-bus"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "test:watch": "vitest"
  },
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./connectors": "./src/connectors.ts",
    "./bus": "./src/bus.ts",
    "./hooks": "./src/hooks.tsx",
    "./provider": "./src/provider.tsx",
    "./bridge": "./src/bridge.ts"
  },
  "dependencies": {
    "@szl-holdings/mcp-client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:"
  }
}

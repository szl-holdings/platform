{
  "name": "@szl-holdings/observability",
  "version": "0.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/szl-holdings/platform.git",
    "directory": "lib/observability"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "development": "./src/react/index.ts",
      "workspace": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./configs": {
      "development": "./src/configs/index.ts",
      "workspace": "./src/configs/index.ts",
      "types": "./dist/configs/index.d.ts",
      "import": "./dist/configs/index.js"
    },
    "./analytics": {
      "development": "./src/analytics/index.ts",
      "workspace": "./src/analytics/index.ts",
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js"
    },
    "./otel": {
      "development": "./src/otel.ts",
      "workspace": "./src/otel.ts",
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.40.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/context-async-hooks": "^2.6.1",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/react": "^10.47.0",
    "@szl-holdings/db": "workspace:*",
    "@szl-holdings/env": "workspace:*",
    "posthog-js": "^1.369.1"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -b tsconfig.json"
  }
}

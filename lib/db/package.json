{
  "name": "@szl-holdings/db",
  "version": "0.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/szl-holdings/szl-holdings-platform.git",
    "directory": "lib/db"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/canonical": "./src/schema/canonical.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "node ./scripts/backfill-migrations.mjs && drizzle-kit migrate --config ./drizzle.config.ts && node ./scripts/apply-manual-migrations.mjs",
    "migrate:backfill": "node ./scripts/backfill-migrations.mjs",
    "migrate:apply": "drizzle-kit migrate --config ./drizzle.config.ts",
    "migrate:manual": "node ./scripts/apply-manual-migrations.mjs",
    "migrate:manual:dry": "DRY_RUN=1 node ./scripts/apply-manual-migrations.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "push-non-interactive": "node ./scripts/non-interactive-migrate.mjs",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@szl-holdings/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}

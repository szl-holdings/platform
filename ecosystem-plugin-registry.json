{
  "id": "szl_ecosystem_plugin_registry",
  "display_name": "SZL Holdings Ecosystem Plugin Registry",
  "version": "1.0.0",
  "created": "2026-04-28",
  "governance_defaults": {
    "require_audit_event": true,
    "require_provenance_envelope": true,
    "deny_on_policy_block": true,
    "max_parallel_requests_per_tenant": 10,
    "default_approval_gate": "human_in_the_loop"
  },
  "model_profile_ref": "model-profiles/qwen3_6_27b_szl_profile.json",
  "endpoint_profile_ref": "endpoint-profiles/alloy_endpoint_plane.json",
  "shared_plugins": {
    "github": {
      "id": "github",
      "display_name": "GitHub",
      "type": "vcs",
      "credential_env": "GITHUB_TOKEN",
      "scopes": ["repo", "read:org"],
      "audit_events": ["github.push", "github.pr_opened", "github.pr_merged"]
    },
    "huggingface": {
      "id": "huggingface",
      "display_name": "HuggingFace",
      "type": "ai-provider",
      "credential_env": "HUGGINGFACE_API_KEY",
      "hf_token_env": "HF_TOKEN",
      "audit_events": ["hf.model_call", "hf.endpoint_cold_start", "hf.budget_threshold_reached"]
    },
    "vercel": {
      "id": "vercel",
      "display_name": "Vercel",
      "type": "deployment",
      "credential_env": "VERCEL_TOKEN",
      "audit_events": ["vercel.deploy_triggered", "vercel.deploy_succeeded", "vercel.deploy_failed"]
    },
    "neon": {
      "id": "neon",
      "display_name": "Neon",
      "type": "database",
      "credential_env": "DATABASE_URL",
      "audit_events": ["neon.migration_applied", "neon.schema_drift_detected"]
    },
    "cloudflare": {
      "id": "cloudflare",
      "display_name": "Cloudflare",
      "type": "edge-network",
      "credential_env": "CLOUDFLARE_API_TOKEN",
      "audit_events": ["cloudflare.dns_updated", "cloudflare.waf_rule_triggered"]
    }
  },
  "required_audit_events": [
    "alloy.model_request_sent",
    "alloy.model_response_received",
    "alloy.governance_block",
    "alloy.approval_gate_triggered",
    "alloy.pii_redaction_applied",
    "alloy.thinking_content_stripped",
    "alloy.cold_start_retry",
    "alloy.budget_limit_reached",
    "alloy.circuit_breaker_opened"
  ],
  "verticals": {
    "sentra": {
      "id": "sentra",
      "display_name": "TENAX — Cyber Resilience Command",
      "slug": "sentra",

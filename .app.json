{
  "name": "PluginMesh",
  "slug": "pluginmesh",
  "version": "1.0.0",
  "description": "Codex plugin broker — routes goals to plugins, generates manifest templates, and surfaces ecosystem payloads.",
  "permissions": ["tools"],
  "mcpServer": {
    "transport": "stdio",
    "command": "node",
    "args": ["scripts/mcp-server.mjs"],
    "env": {}
  },
  "ui": {
    "previewUrl": "/pluginmesh/",
    "title": "PluginMesh Broker"
  },
  "security": {
    "neverBypassAuth": true,
    "generateTemplatesOnly": true
  }
}
